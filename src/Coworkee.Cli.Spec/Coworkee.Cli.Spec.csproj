<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- travels inside the Coworkee.Cli tool (and the Studio tool) as project reference, not as package of its own -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- the AI provider catalog -->
    <ProjectReference Include="..\Coworkee.Contracts\Coworkee.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- the starter specs of the gallery; the website publishes the same files -->
    <EmbeddedResource Include="..\..\templates\specs\*.json" LogicalName="Specs.%(Filename).json" Link="Specs\%(Filename).json" />
  </ItemGroup>
</Project>
