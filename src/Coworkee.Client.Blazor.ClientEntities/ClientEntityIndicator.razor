@if (_set is { Status: var status })
{
    <MudTooltip Text="@Describe(status)">
        @if (status.State == ClientEntitySyncState.Downloading)
        {
            <MudProgressCircular Size="Size.Small" Color="Color.Primary" Value="@(status.Progress * 100)" data-testid="client-entity-state" data-state="downloading" />
        }
        else
        {
            <MudIcon Icon="@Icon(status)" Size="Size.Small" Color="@(status.State == ClientEntitySyncState.Failed ? Color.Warning : Color.Default)"
                     data-testid="client-entity-state" data-state="@(status.IsLocal ? "local" : "server")" />
        }
    </MudTooltip>
}
