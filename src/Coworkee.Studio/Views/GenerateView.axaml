<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Coworkee.Studio.ViewModels"
             xmlns:cli="using:Coworkee.Studio.Cli"
             xmlns:spec="using:Coworkee.Cli.Spec"
             xmlns:v="using:Coworkee.Studio.Views"
             xmlns:l="using:Coworkee.Studio.Localization"
             x:Class="Coworkee.Studio.Views.GenerateView"
             x:DataType="vm:GenerateStep">
  <UserControl.Styles>
    <Style Selector="PathIcon.spin">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>
  <ScrollViewer>
    <Grid ColumnDefinitions="*,24,380" Margin="44,12,44,32">
      <StackPanel Spacing="18">
        <!-- headline -->
        <Border Classes="card" Padding="22">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource Hero}">
              <Panel>
                <PathIcon Classes="large spin" Foreground="White" Data="{StaticResource Icon.Restart}" IsVisible="{Binding IsRunning}" />
                <PathIcon Classes="large" Foreground="White" Data="{StaticResource Icon.Check}" IsVisible="{Binding IsSucceeded}" />
                <PathIcon Classes="large" Foreground="White" Data="{StaticResource Icon.Alert}" IsVisible="{Binding IsFailed}" />
                <PathIcon Classes="large" Foreground="White" Data="{StaticResource Icon.Console}" IsVisible="{Binding IsCliMissing}" />
                <PathIcon Classes="large" Foreground="White" Data="{StaticResource Icon.Rocket}" IsVisible="{Binding IsReady}" />
              </Panel>
            </Border>
            <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center" Spacing="2">
              <TextBlock Classes="h2" Text="{Binding Headline}" />
              <TextBlock Classes="mono caption" Text="{Binding Output}" TextWrapping="NoWrap" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding Output}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Classes="mono muted" Text="{Binding Elapsed}" VerticalAlignment="Center" />
              <Button Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Classes="small" Data="{StaticResource Icon.Stop}" />
                  <TextBlock Text="{l:L Cancel}" />
                </StackPanel>
              </Button>
              <Button Command="{Binding StartCommand}" Classes.primary="{Binding !IsPlanReady}" IsVisible="{Binding !IsRunning}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Classes="small" Data="{StaticResource Icon.Play}" />
                  <TextBlock Text="{Binding StartText}" />
                </StackPanel>
              </Button>
              <Button Classes="primary" Command="{Binding ApplyCommand}" IsVisible="{Binding IsPlanReady}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Classes="small" Data="{StaticResource Icon.Check}" />
                  <TextBlock Text="{l:L 'Apply the changes'}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- CLI missing -->
        <Border Classes="card" IsVisible="{Binding IsCliMissing}">
          <StackPanel Spacing="12">
            <TextBlock Classes="h3" Text="{l:L 'Install the coworkee CLI'}" />
            <TextBlock Classes="body muted" Text="{l:L 'The Studio creates apps through the coworkee command line tool, a global .NET tool. Install it with one click, or point the Studio to a local build (coworkee.exe or Coworkee.Cli.dll).'}" />
            <Border Classes="code">
              <SelectableTextBlock Text="dotnet tool install -g Coworkee.Cli" />
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="primary" Command="{Binding InstallCliCommand}" Content="{l:L 'Install and continue'}" />
              <Button Command="{Binding ChooseCliCommand}" Content="{l:L 'Choose a local CLI'}" />
              <Button Classes="ghost" Command="{Binding Main.ShowHelpCommand}" CommandParameter="3" Content="{l:L Settings}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- how to sign in -->
        <Border Classes="card" IsVisible="{Binding HasSignIn}" BorderBrush="{DynamicResource Primary}" BorderThickness="2">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Data="{StaticResource Icon.Login}" Foreground="{DynamicResource Primary}" Margin="0,0,10,0" />
              <TextBlock Grid.Column="1" Classes="h3" Text="{l:L 'Sign in'}" VerticalAlignment="Center" />
              <Button Grid.Column="2" Classes="ghost" Command="{Binding Main.CopyCommand}" CommandParameter="{Binding SignInText}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Classes="small" Data="{StaticResource Icon.Copy}" />
                  <TextBlock Text="{l:L 'Copy all'}" />
                </StackPanel>
              </Button>
            </Grid>
            <TextBlock Classes="body" Text="{Binding SignInHint}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding SignIn.Users}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="spec:SignInUser">
                  <Border Classes="code" Margin="0,0,0,6" Padding="12,6">
                    <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto">
                      <SelectableTextBlock Classes="mono" FontWeight="SemiBold" Text="{Binding Email}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                      <Button Grid.Column="1" Classes="icon" Foreground="{DynamicResource CodeText}" Margin="8,0" ToolTip.Tip="{l:L 'Copy email'}"
                              Command="{Binding $parent[UserControl].((vm:GenerateStep)DataContext).Main.CopyCommand}" CommandParameter="{Binding Email}">
                        <PathIcon Classes="small" Data="{StaticResource Icon.Copy}" />
                      </Button>
                      <Border Grid.Column="2" Classes="chip" HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding RoleText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding RoleText}" />
                      </Border>
                      <SelectableTextBlock Grid.Row="1" Classes="mono" Text="{Binding Password}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                      <Button Grid.Row="1" Grid.Column="1" Classes="icon" Foreground="{DynamicResource CodeText}" Margin="8,0" ToolTip.Tip="{l:L 'Copy password'}"
                              Command="{Binding $parent[UserControl].((vm:GenerateStep)DataContext).Main.CopyCommand}" CommandParameter="{Binding Password}">
                        <PathIcon Classes="small" Data="{StaticResource Icon.Key}" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="caption" IsVisible="{Binding SignIn.Keycloak, FallbackValue=False}" Text="{l:L 'The Keycloak button on the sign-in page takes the same users and passwords.'}" TextWrapping="Wrap" />
            <TextBlock Classes="caption" IsVisible="{Binding ToolsHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding ToolsHint}" TextWrapping="Wrap" />
            <TextBlock Classes="caption" Text="{l:L 'Development passwords only, also in LOGIN.md of the solution; change them before you deploy.'}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- success -->
        <Border Classes="card" IsVisible="{Binding IsSucceeded}">
          <StackPanel Spacing="14">
            <TextBlock Classes="h3" Text="{l:L 'What now?'}" />
            <UniformGrid Columns="5" ColumnSpacing="10">
              <Button Classes="tile" Command="{Binding OpenFolderCommand}" Height="96">
                <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <PathIcon Classes="large" Data="{StaticResource Icon.FolderOpen}" Foreground="{DynamicResource Primary}" />
                  <TextBlock Text="{l:L 'Open folder'}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="tile" Command="{Binding OpenInCommand}" CommandParameter="code" Height="96">
                <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <PathIcon Classes="large" Data="{StaticResource Icon.VsCode}" Foreground="{DynamicResource Primary}" />
                  <TextBlock Text="VS Code" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="tile" Height="96">
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="{l:L 'Default program (Visual Studio)'}" Command="{Binding OpenSolutionCommand}" />
                    <MenuItem Header="Rider" Command="{Binding OpenInCommand}" CommandParameter="rider" />
                  </MenuFlyout>
                </Button.Flyout>
                <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <PathIcon Classes="large" Data="{StaticResource Icon.Code}" Foreground="{DynamicResource Primary}" />
                  <TextBlock Text="{l:L 'Open solution'}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="tile selected" Command="{Binding App.StartCommand}" IsEnabled="{Binding !App.IsBusy}" Height="96">
                <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <PathIcon Classes="large" Data="{StaticResource Icon.Play}" Foreground="{DynamicResource Secondary}" />
                  <TextBlock Text="{l:L 'Run the app'}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="tile" Command="{Binding Deploy.OpenCommand}" Height="96" x:Name="DeployTile">
                <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <PathIcon Classes="large" Data="{StaticResource Icon.Rocket}" Foreground="{DynamicResource Primary}" />
                  <TextBlock Text="{l:L 'Deploy'}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
            </UniformGrid>
            <Border Classes="soft" IsVisible="{Binding NextSteps.Count, Converter={x:Static v:Converters.Positive}}">
              <StackPanel Spacing="4">
                <TextBlock Classes="overline" Text="{l:L 'NEXT STEPS'}" />
                <ItemsControl ItemsSource="{Binding NextSteps}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <SelectableTextBlock Classes="mono" Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- the running app -->
        <Border Classes="card" IsVisible="{Binding App.WasStarted}" x:Name="RunCard" Padding="0">
          <StackPanel>
            <StackPanel Spacing="12" Margin="22,18,22,12">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Panel Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Top">
                  <PathIcon Classes="small spin" Data="{StaticResource Icon.Restart}" Foreground="{DynamicResource Primary}" IsVisible="{Binding App.IsStarting}" />
                  <PathIcon Data="{StaticResource Icon.CheckCircle}" Foreground="{DynamicResource Success}" IsVisible="{Binding App.IsRunning}" />
                  <PathIcon Data="{StaticResource Icon.AlertCircle}" Foreground="{DynamicResource Error}" IsVisible="{Binding App.IsFailed}" />
                  <PathIcon Data="{StaticResource Icon.Stop}" Foreground="{DynamicResource TextSecondary}" IsVisible="{Binding App.State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AppRunState.Stopped}}" />
                </Panel>
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Classes="h3" Text="{l:L 'Run the app'}" />
                  <TextBlock Classes="body" Text="{Binding App.StatusText}" TextWrapping="Wrap" Classes.error="{Binding App.IsFailed}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                  <Button Command="{Binding App.StopCommand}" IsVisible="{Binding App.IsBusy}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Classes="small" Data="{StaticResource Icon.Stop}" />
                      <TextBlock Text="{l:L Stop}" />
                    </StackPanel>
                  </Button>
                  <Button Command="{Binding App.StartCommand}" IsVisible="{Binding !App.IsBusy}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Classes="small" Data="{StaticResource Icon.Play}" />
                      <TextBlock Text="{l:L Start}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
              <WrapPanel ItemSpacing="8" LineSpacing="8" IsVisible="{Binding App.IsBusy}">
                <Button Classes="ghost" IsVisible="{Binding App.HasDashboard}" Command="{Binding App.OpenCommand}" CommandParameter="{Binding App.DashboardUrl}"
                        ToolTip.Tip="{Binding App.DashboardUrl}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Classes="small" Data="{StaticResource Icon.Dashboard}" Foreground="{DynamicResource Secondary}" />
                    <TextBlock Text="{l:L 'Aspire dashboard'}" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding App.Endpoints}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel ItemSpacing="8" LineSpacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="cli:AppEndpoint">
                      <Button Classes="ghost" Command="{Binding $parent[UserControl].((vm:GenerateStep)DataContext).App.OpenCommand}" CommandParameter="{Binding Url}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Classes="small" Data="{StaticResource Icon.OpenInNew}" Foreground="{DynamicResource Primary}" />
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          <TextBlock Classes="mono caption" Text="{Binding Url}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </WrapPanel>
            </StackPanel>
            <Border BorderBrush="{DynamicResource Lines}" BorderThickness="0,1,0,0" Padding="16,6">
              <ToggleButton Classes="ghost" IsChecked="{Binding App.ShowLog}" Background="Transparent" BorderThickness="0" Padding="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Classes="small" Data="{StaticResource Icon.Console}" />
                  <TextBlock FontWeight="SemiBold" Text="{l:L 'App host output'}" />
                  <TextBlock Classes="caption" Text="{Binding App.Log.Count, StringFormat='({0})'}" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
            </Border>
            <Border Classes="code" CornerRadius="0,0,14,14" Height="260" IsVisible="{Binding App.ShowLog}">
              <ListBox ItemsSource="{Binding App.Log}" Background="Transparent" x:Name="RunLog">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0,1" />
                    <Setter Property="MinHeight" Value="0" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" FontFamily="{DynamicResource MonoFont}" FontSize="12" TextWrapping="Wrap" Foreground="#c5d5e6" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </StackPanel>
        </Border>

        <!-- deployment -->
        <Border Classes="card" IsVisible="{Binding Deploy.IsOpen}" x:Name="DeployCard" Padding="0">
          <StackPanel>
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="22,18,22,12">
              <PathIcon Classes="small spin" Data="{StaticResource Icon.Restart}" Foreground="{DynamicResource Primary}" IsVisible="{Binding Deploy.IsBusy}" Margin="0,0,12,0" VerticalAlignment="Top" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Classes="h3" Text="{l:L 'Deploy'}" />
                <TextBlock Classes="body" Text="{Binding Deploy.StatusText}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <ComboBox ItemsSource="{x:Static vm:DeployViewModel.Targets}" SelectedItem="{Binding Deploy.Target}" IsEnabled="{Binding !Deploy.IsBusy}" MinWidth="120" />
                <Button Command="{Binding Deploy.StopCommand}" IsVisible="{Binding Deploy.IsBusy}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Classes="small" Data="{StaticResource Icon.Stop}" />
                    <TextBlock Text="{l:L Stop}" />
                  </StackPanel>
                </Button>
                <Button Classes="primary" Command="{Binding Deploy.StartCommand}" IsVisible="{Binding !Deploy.IsBusy}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Classes="small" Data="{StaticResource Icon.Rocket}" />
                    <TextBlock Text="{l:L 'coworkee deploy'}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
            <Border Classes="code" CornerRadius="0,0,14,14" Height="260" IsVisible="{Binding Deploy.Log.Count, Converter={x:Static v:Converters.Positive}}">
              <ListBox ItemsSource="{Binding Deploy.Log}" Background="Transparent" x:Name="DeployLog">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0,1" />
                    <Setter Property="MinHeight" Value="0" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <SelectableTextBlock Text="{Binding}" FontFamily="{DynamicResource MonoFont}" FontSize="12" TextWrapping="Wrap" Foreground="#c5d5e6" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </StackPanel>
        </Border>

        <!-- warnings -->
        <ItemsControl ItemsSource="{Binding Warnings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Border Classes="banner warn" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Classes="small" Data="{StaticResource Icon.Alert}" Foreground="{DynamicResource Warning}" />
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12.5" MaxWidth="700" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- conflicts of coworkee add -->
        <Border Classes="banner warn" IsVisible="{Binding HasConflicts}">
          <StackPanel Spacing="6">
            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{l:L 'Some changes did not merge into your files. Merge each .rej file into the file next to it, then delete it:'}" />
            <ItemsControl ItemsSource="{Binding Conflicts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Classes="mono caption" Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- log -->
        <Border Classes="card" Padding="0">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="16,8">
              <ToggleButton Classes="ghost" IsChecked="{Binding ShowLog}" Background="Transparent" BorderThickness="0" Padding="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Classes="small" Data="{StaticResource Icon.Console}" />
                  <TextBlock FontWeight="SemiBold" Text="{l:L 'CLI output'}" />
                  <TextBlock Classes="caption" Text="{Binding Log.Count, StringFormat='({0})'}" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <Button Grid.Column="1" Classes="ghost" Command="{Binding CopyLogCommand}" Content="{l:L Copy}" />
            </Grid>
            <Border Classes="code" CornerRadius="0,0,14,14" Height="300" IsVisible="{Binding ShowLog}">
              <ListBox ItemsSource="{Binding Log}" Background="Transparent" x:Name="LogList">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0,1" />
                    <Setter Property="MinHeight" Value="0" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="cli:CliLine">
                    <TextBlock Text="{Binding Text}" FontFamily="{DynamicResource MonoFont}" FontSize="12" TextWrapping="Wrap"
                               Classes.step="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static cli:CliLineKind.Step}}"
                               Classes.command="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static cli:CliLineKind.Command}}"
                               Classes.warn="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static cli:CliLineKind.Warning}}"
                               Classes.err="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static cli:CliLineKind.Error}}">
                      <TextBlock.Styles>
                        <Style Selector="TextBlock"><Setter Property="Foreground" Value="#c5d5e6" /></Style>
                        <Style Selector="TextBlock.step"><Setter Property="Foreground" Value="#64d8cb" /><Setter Property="FontWeight" Value="Bold" /></Style>
                        <Style Selector="TextBlock.command"><Setter Property="Foreground" Value="#90caf9" /></Style>
                        <Style Selector="TextBlock.warn"><Setter Property="Foreground" Value="#ffcc80" /></Style>
                        <Style Selector="TextBlock.err"><Setter Property="Foreground" Value="#ef9a9a" /></Style>
                      </TextBlock.Styles>
                    </TextBlock>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- steps -->
      <Border Grid.Column="2" Classes="card" VerticalAlignment="Top">
        <StackPanel Spacing="12">
          <TextBlock Classes="overline" Text="{l:L 'PROGRESS'}" />
          <TextBlock Classes="caption" Text="{l:L 'The steps appear as the CLI reaches them.'}" IsVisible="{Binding Progress.Count, Converter={x:Static v:Converters.Zero}}" />
          <ItemsControl ItemsSource="{Binding Progress}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProgressStepViewModel">
                <Grid ColumnDefinitions="Auto,*" Margin="0,5">
                  <Panel Width="22" Height="22">
                    <Ellipse Fill="{DynamicResource PrimarySoft}" />
                    <PathIcon Classes="small spin" Data="{StaticResource Icon.Restart}" Foreground="{DynamicResource Primary}" IsVisible="{Binding IsRunning}" />
                    <PathIcon Classes="small" Data="{StaticResource Icon.Check}" Foreground="{DynamicResource Success}" IsVisible="{Binding IsDone}" />
                    <PathIcon Classes="small" Data="{StaticResource Icon.Close}" Foreground="{DynamicResource Error}" IsVisible="{Binding IsFailed}" />
                  </Panel>
                  <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
