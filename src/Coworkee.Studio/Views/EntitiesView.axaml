<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Coworkee.Studio.ViewModels"
             xmlns:v="using:Coworkee.Studio.Views"
             xmlns:l="using:Coworkee.Studio.Localization"
             x:Class="Coworkee.Studio.Views.EntitiesView"
             x:DataType="vm:EntitiesStep">
  <UserControl.Resources>
    <DataTemplate x:Key="Translated" x:DataType="x:String">
      <TextBlock Text="{Binding Converter={x:Static v:Converters.Text}}" />
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button.entity">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Button.entity.selected">
      <Setter Property="Background" Value="{DynamicResource PrimarySoft}" />
      <Setter Property="Foreground" Value="{DynamicResource Primary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.head">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="40,10,24,4">
      <ListBox Classes="segments" ItemsSource="{x:Static vm:EntitiesStep.ViewModes}" SelectedItem="{Binding ViewMode}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Text="{Binding Converter={x:Static v:Converters.Text}}" FontSize="12.5" FontWeight="SemiBold" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsDiagram}">
          <Button Classes="icon" Click="ZoomOut" ToolTip.Tip="{l:L 'Zoom out'}">
            <TextBlock Text="−" FontSize="16" FontWeight="SemiBold" />
          </Button>
          <Button Classes="icon" Click="ZoomIn" ToolTip.Tip="{l:L 'Zoom in'}">
            <PathIcon Classes="small" Data="{StaticResource Icon.Plus}" />
          </Button>
          <Button Classes="icon" Click="Fit" ToolTip.Tip="{l:L 'Show everything'}">
            <PathIcon Classes="small" Data="{StaticResource Icon.Maximize}" />
          </Button>
          <Button Command="{Binding AutoLayoutCommand}" ToolTip.Tip="{l:L 'Arrange the boxes: referenced entities above the ones that reference them.'}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Classes="small" Data="{StaticResource Icon.Magic}" />
              <TextBlock Text="{l:L 'Auto layout'}" />
            </StackPanel>
          </Button>
          <Button Click="ExportPng" ToolTip.Tip="{l:L 'Save the whole diagram as a PNG image.'}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Classes="small" Data="{StaticResource Icon.Image}" />
              <TextBlock Text="{l:L 'Export PNG'}" />
            </StackPanel>
          </Button>
        </StackPanel>
        <Button Command="{Binding OpenImportCommand}" ToolTip.Tip="{l:L 'From a database, an OpenAPI document or a CSV file, with a preview.'}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Classes="small" Data="{StaticResource Icon.DatabaseSync}" />
            <TextBlock Text="{l:L 'Import entities…'}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

  <Grid Grid.Row="1" ColumnDefinitions="240,*,290" Margin="40,12,0,0" IsVisible="{Binding IsList}">
    <!-- modules and entities -->
    <DockPanel Margin="0,0,20,24">
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="overline" Text="{l:L 'MODULES'}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Counts}" />
        </Grid>
        <UniformGrid Columns="2" ColumnSpacing="8">
          <Button Command="{Binding AddModuleCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Classes="small" Data="{StaticResource Icon.Plus}" />
              <TextBlock Text="{l:L Module}" />
            </StackPanel>
          </Button>
          <Button Command="{Binding AddExampleCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="{l:L 'Sales with Customer and Order'}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Classes="small" Data="{StaticResource Icon.Magic}" />
              <TextBlock Text="{l:L Example}" />
            </StackPanel>
          </Button>
        </UniformGrid>
      </StackPanel>
      <ScrollViewer>
        <StackPanel>
        <ItemsControl ItemsSource="{Binding Modules}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ModuleViewModel">
              <Border Classes="card" Padding="10" Margin="0,0,0,10">
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Classes="small" Data="{StaticResource Icon.Puzzle}" Foreground="{DynamicResource Secondary}" Margin="4,0,8,0" />
                    <TextBox Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" MinHeight="32" Padding="8,4" />
                    <Button Grid.Column="2" Classes="icon danger" Width="30" Height="30" Padding="6" ToolTip.Tip="{l:L 'Remove module'}"
                            Command="{Binding $parent[UserControl].((vm:EntitiesStep)DataContext).RemoveModuleCommand}" CommandParameter="{Binding}">
                      <PathIcon Classes="small" Data="{StaticResource Icon.Delete}" />
                    </Button>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Errors}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Classes="error" FontSize="11.5" Text="{Binding}" Margin="4,0" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding Entities}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:EntityViewModel">
                        <Button Classes="entity" Classes.selected="{Binding IsSelected}"
                                Command="{Binding $parent[UserControl].((vm:EntitiesStep)DataContext).SelectEntityCommand}" CommandParameter="{Binding}">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <PathIcon Classes="small" Data="{StaticResource Icon.Table}" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Display}" VerticalAlignment="Center" />
                            <PathIcon Grid.Column="2" Classes="small" Data="{StaticResource Icon.AlertCircle}" Foreground="{DynamicResource Error}" IsVisible="{Binding HasErrors}" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Classes="link" Margin="10,4,0,2" Command="{Binding $parent[UserControl].((vm:EntitiesStep)DataContext).AddEntityToCommand}" CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Classes="small" Data="{StaticResource Icon.Plus}" />
                      <TextBlock Text="{l:L Entity}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
          <StackPanel Spacing="8" Margin="0,6,0,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="overline" Text="{l:L 'ENUMS'}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="link" Command="{Binding AddEnumCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Classes="small" Data="{StaticResource Icon.Plus}" />
                  <TextBlock Text="{l:L Enum}" />
                </StackPanel>
              </Button>
            </Grid>
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{l:L 'Value lists for properties of type enum, shown with their names in lists, forms and facets.'}" />
            <ItemsControl ItemsSource="{Binding Enums}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EnumViewModel">
                  <Border Classes="card" Padding="10" Margin="0,0,0,8">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding Name}" FontWeight="SemiBold" MinHeight="32" Padding="8,4" PlaceholderText="OrderStatus" />
                        <Button Grid.Column="1" Classes="icon danger" Width="30" Height="30" Padding="6" ToolTip.Tip="{l:L 'Remove enum'}"
                                Command="{Binding $parent[UserControl].((vm:EntitiesStep)DataContext).RemoveEnumCommand}" CommandParameter="{Binding}">
                          <PathIcon Classes="small" Data="{StaticResource Icon.Delete}" />
                        </Button>
                      </Grid>
                      <TextBox Text="{Binding Values}" PlaceholderText="Open, Paid, Shipped" ToolTip.Tip="{l:L 'Values, comma separated; the first is the default.'}" />
                      <ItemsControl ItemsSource="{Binding Errors}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <TextBlock Classes="error" FontSize="11.5" Text="{Binding}" TextWrapping="Wrap" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding SpecErrors}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Classes="error" FontSize="11.5" Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- entity editor -->
    <ScrollViewer Grid.Column="1" Padding="0,0,20,24">
      <Panel>
        <Border Classes="card" Padding="36" IsVisible="{Binding !HasModules}" VerticalAlignment="Top">
          <StackPanel Spacing="14" HorizontalAlignment="Center" MaxWidth="460">
            <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource PrimarySoft}" HorizontalAlignment="Center">
              <PathIcon Classes="large" Data="{StaticResource Icon.Table}" Foreground="{DynamicResource Primary}" />
            </Border>
            <TextBlock Classes="h2" HorizontalAlignment="Center" TextAlignment="Center" Text="{l:L 'No entities yet'}" />
            <TextBlock Classes="muted" TextAlignment="Center" Text="{l:L 'Optional: the app works without them. Add a module like Sales with entities like Customer and Order, and each gets its table, API, permissions and page.'}" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
              <Button Classes="primary" Command="{Binding AddModuleCommand}" Content="{l:L 'Add a module'}" />
              <Button Command="{Binding AddExampleCommand}" Content="{l:L 'Use the example'}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Panel IsVisible="{Binding HasEntity}">
        <v:EntityEditor DataContext="{Binding SelectedEntity}" />
        </Panel>
      </Panel>
    </ScrollViewer>

    <!-- what the CLI generates -->
    <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Lines}" BorderThickness="1,0,0,0">
      <ScrollViewer Padding="22,4,22,24">
        <StackPanel Spacing="14">
          <TextBlock Classes="overline" Text="{l:L 'GENERATED FOR THIS ENTITY'}" />
          <TextBlock Classes="caption" Text="{l:L 'Select an entity to see its routes, permissions and files.'}" IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNull}}" />
          <StackPanel Spacing="14" IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="4">
              <TextBlock FontWeight="SemiBold" Text="{l:L 'Page'}" />
              <TextBlock Classes="mono" Foreground="{DynamicResource Primary}" Text="{Binding Preview.Route}" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock FontWeight="SemiBold" Text="{l:L 'API and OData'}" />
              <TextBlock Classes="mono" Foreground="{DynamicResource Secondary}" Text="{Binding Preview.ApiRoute}" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock FontWeight="SemiBold" Text="{l:L 'Permissions'}" />
              <ItemsControl ItemsSource="{Binding Preview.Permissions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Classes="mono caption" Text="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock FontWeight="SemiBold" Text="{l:L 'Files'}" />
              <ItemsControl ItemsSource="{Binding Preview.Files}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Classes="mono caption" FontSize="11" Text="{Binding}" TextWrapping="NoWrap" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding}" Margin="0,1" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>

    <!-- diagram with the editor beside it -->
    <Grid Grid.Row="1" ColumnDefinitions="*,520" Margin="40,12,0,0" IsVisible="{Binding IsDiagram}">
      <Border Classes="card" Padding="0" Margin="0,0,16,24" ClipToBounds="True">
        <Panel>
          <v:EntityDiagram x:Name="Diagram" Step="{Binding}" />
          <TextBlock Classes="caption" Margin="14,10" VerticalAlignment="Bottom" TextWrapping="Wrap" IsHitTestVisible="False"
                     Text="{l:L 'Drag a box to move it, drag the dot of its header onto another box to add a reference, drag the background to pan, wheel to zoom.'}" />
        </Panel>
      </Border>
      <ScrollViewer Grid.Column="1" Padding="0,0,24,24">
        <Panel>
          <Border Classes="card" Padding="28" IsVisible="{Binding !HasEntity}" VerticalAlignment="Top">
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:L 'Select a box to edit its entity here. Add modules and entities in the list view.'}" />
          </Border>
          <v:EntityEditor DataContext="{Binding SelectedEntity}" IsVisible="{Binding $parent[UserControl].((vm:EntitiesStep)DataContext).HasEntity}" />
        </Panel>
      </ScrollViewer>
    </Grid>

    <!-- a reference drawn in the diagram -->
    <Border Grid.RowSpan="2" Background="#66000000" IsVisible="{Binding HasPendingReference}">
      <Border Classes="card" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
        <StackPanel Spacing="12" DataContext="{Binding PendingReference}" x:DataType="vm:ReferenceDraft">
          <TextBlock Classes="h3" Text="{l:L 'New reference'}" />
          <TextBlock Classes="muted" Text="{Binding Title}" TextWrapping="Wrap" />
          <StackPanel Spacing="4">
            <TextBlock Classes="caption" Text="{l:L Name}" />
            <TextBox Text="{Binding Name}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Classes="caption" Text="{l:L 'On delete'}" />
            <ComboBox ItemsSource="{x:Static vm:PropertyViewModel.DeleteBehaviors}" SelectedItem="{Binding OnDelete}" HorizontalAlignment="Stretch" ItemTemplate="{StaticResource Translated}" />
          </StackPanel>
          <CheckBox IsChecked="{Binding Required}" Content="{l:L Required}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Command="{Binding $parent[UserControl].((vm:EntitiesStep)DataContext).CancelReferenceCommand}" Content="{l:L Cancel}" />
            <Button Classes="primary" Command="{Binding $parent[UserControl].((vm:EntitiesStep)DataContext).ConfirmReferenceCommand}" Content="{l:L 'Add reference'}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- import -->
    <Border Grid.RowSpan="2" Background="#66000000" IsVisible="{Binding IsImportOpen}">
      <Border Classes="card" Width="760" MaxHeight="760" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
        <DockPanel DataContext="{Binding Import}" x:DataType="vm:EntityImportViewModel">
          <StackPanel DockPanel.Dock="Top" Spacing="12">
            <TextBlock Classes="h3" Text="{l:L 'Import entities'}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:L 'Tables, schemas or CSV columns become entities with their properties; foreign keys and references of the document become references. Nothing is added before you confirm the preview.'}" />
            <ListBox Classes="segments" ItemsSource="{x:Static vm:EntityImportViewModel.Kinds}" SelectedItem="{Binding Kind}" HorizontalAlignment="Left" ItemTemplate="{StaticResource Translated}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding Source}" PlaceholderText="{Binding Placeholder}" />
              <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseCommand}" IsVisible="{Binding CanBrowse}" Content="{l:L 'Browse…'}" />
            </Grid>
            <Grid ColumnDefinitions="*,12,*,12,*">
              <StackPanel Spacing="4">
                <TextBlock Classes="caption" Text="{l:L Module}" />
                <TextBox Text="{Binding Module}" PlaceholderText="{l:L 'from the source'}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Classes="caption" Text="{l:L 'Only these tables or schemas'}" />
                <TextBox Text="{Binding Tables}" PlaceholderText="orders, customers" />
              </StackPanel>
              <StackPanel Grid.Column="4" Spacing="4" IsVisible="{Binding IsDatabase}">
                <TextBlock Classes="caption" Text="{l:L Database}" />
                <ComboBox ItemsSource="{x:Static vm:EntityImportViewModel.Providers}" SelectedItem="{Binding Provider}" HorizontalAlignment="Stretch" ItemTemplate="{StaticResource Translated}" />
              </StackPanel>
            </Grid>
            <TextBlock Classes="error" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Command="{Binding CloseCommand}" Content="{l:L Cancel}" />
            <Button Command="{Binding PreviewCommand}" IsEnabled="{Binding !IsBusy}" Content="{l:L Preview}" />
            <Button Classes="primary" Command="{Binding AddCommand}" IsEnabled="{Binding HasResult}" Content="{l:L 'Add to the spec'}" />
          </StackPanel>
          <Border Classes="soft" Margin="0,14,0,0" Padding="14,10" IsVisible="{Binding HasResult}">
            <ScrollViewer>
              <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="{Binding Summary}" />
                <ItemsControl ItemsSource="{Binding Lines}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Classes="mono caption" Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock FontWeight="SemiBold" Margin="0,6,0,0" Text="{l:L Skipped}" IsVisible="{Binding Skipped.Count}" />
                <ItemsControl ItemsSource="{Binding Skipped}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Classes="caption" Foreground="{DynamicResource Warning}" Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </DockPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
