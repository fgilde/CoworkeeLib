<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Coworkee.Studio.ViewModels"
        xmlns:v="using:Coworkee.Studio.Views"
        x:Class="Coworkee.Studio.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Coworkee Studio"
        Icon="/Assets/coworkee.ico"
        Width="1400" Height="900" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource Background}">
  <v:MainView />
</Window>
