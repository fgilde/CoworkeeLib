<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Coworkee.Studio.ViewModels"
             xmlns:v="using:Coworkee.Studio.Views"
             xmlns:cli="using:Coworkee.Studio.Cli"
             xmlns:l="using:Coworkee.Studio.Localization"
             x:Class="Coworkee.Studio.Views.AzureDeployView"
             x:DataType="vm:AzureDeployViewModel">
  <ScrollViewer>
    <StackPanel Margin="44,26,44,40" Spacing="18" MaxWidth="980" HorizontalAlignment="Left">
      <Grid ColumnDefinitions="Auto,*">
        <Button Classes="icon" Command="{Binding BackCommand}" ToolTip.Tip="{l:L Back}" VerticalAlignment="Top">
          <PathIcon Data="{StaticResource Icon.ChevronLeft}" />
        </Button>
        <StackPanel Grid.Column="1" Margin="8,0,16,0" Spacing="4">
          <TextBlock Classes="overline" Text="{Binding StepText}" IsVisible="{Binding !IsDeployStep}" />
          <TextBlock Classes="h1" Text="{Binding Title}" />
          <TextBlock Classes="muted" FontSize="14" TextWrapping="Wrap"
                     Text="{l:L 'Azure Container Apps in one resource group: the services, the tools, the database and the registry. The Azure CLI signs in; coworkee deploy does the rest.'}" />
        </StackPanel>
      </Grid>

      <!-- 1: the Azure CLI -->
      <Border Classes="card" IsVisible="{Binding IsSignInStep}" x:Name="SignInCard">
        <StackPanel Spacing="12">
          <TextBlock Classes="h3" Text="{l:L 'Sign in to Azure'}" />
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsChecking}">
            <PathIcon Classes="small spin" Data="{StaticResource Icon.Restart}" Foreground="{DynamicResource Primary}" />
            <TextBlock Classes="body" Text="{l:L 'Checking the Azure CLI…'}" />
          </StackPanel>

          <StackPanel Spacing="10" IsVisible="{Binding IsNotInstalled}">
            <Border Classes="banner warn">
              <TextBlock TextWrapping="Wrap" Text="{l:L 'The Azure CLI (az) is not installed. Install it, then check again.'}" />
            </Border>
            <Button Classes="primary" HorizontalAlignment="Left" Command="{Binding OpenCommand}" CommandParameter="{x:Static vm:AzureDeployViewModel.InstallUrl}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Classes="small" Data="{StaticResource Icon.OpenInNew}" />
                <TextBlock Text="{l:L 'Install the Azure CLI'}" />
              </StackPanel>
            </Button>
          </StackPanel>

          <StackPanel Spacing="10" IsVisible="{Binding IsSignedOut}">
            <TextBlock Classes="body" TextWrapping="Wrap" Text="{l:L 'The Azure CLI is not signed in, or its sign-in expired. Sign in opens the browser; the Studio checks again when you are done.'}" />
            <Button Classes="primary" HorizontalAlignment="Left" Command="{Binding SignInCommand}" x:Name="SignInButton">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Classes="small" Data="{StaticResource Icon.Login}" />
                <TextBlock Text="{l:L 'Sign in'}" />
              </StackPanel>
            </Button>
          </StackPanel>

          <StackPanel Spacing="10" IsVisible="{Binding IsBrokerProblem}">
            <Border Classes="banner warn">
              <TextBlock TextWrapping="Wrap"
                         Text="{l:L 'The Azure CLI knows your account, but cannot hand out a token (Can’t find token from MSAL cache): it signed in through the Windows broker. Turn the broker off and sign in again:'}" />
            </Border>
            <Border Classes="code">
              <SelectableTextBlock Text="{x:Static vm:AzureDeployViewModel.BrokerFixCommands}" />
            </Border>
            <Button Classes="primary" HorizontalAlignment="Left" Command="{Binding FixBrokerCommand}" x:Name="FixBrokerButton">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Classes="small" Data="{StaticResource Icon.Magic}" />
                <TextBlock Text="{l:L 'Run both and sign in'}" />
              </StackPanel>
            </Button>
          </StackPanel>

          <Border Classes="banner ok" IsVisible="{Binding IsSignedIn}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Classes="small" Data="{StaticResource Icon.CheckCircle}" Foreground="{DynamicResource Success}" />
              <TextBlock TextWrapping="Wrap">
                <Run Text="{l:L 'Signed in as'}" />
                <Run Text="{Binding Account}" FontWeight="SemiBold" />
              </TextBlock>
            </StackPanel>
          </Border>

          <TextBlock Classes="mono caption" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" TextWrapping="Wrap" />
          <Button Classes="ghost" HorizontalAlignment="Left" Command="{Binding CheckCommand}" IsVisible="{Binding !IsChecking}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Classes="small" Data="{StaticResource Icon.Restart}" />
              <TextBlock Text="{l:L 'Check again'}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- 2: subscription -->
      <Border Classes="card" IsVisible="{Binding IsSubscriptionStep}" x:Name="SubscriptionCard">
        <StackPanel Spacing="12">
          <TextBlock Classes="overline" Text="{l:L 'SIGNED IN AS'}" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Classes="large" Data="{StaticResource Icon.Account}" Foreground="{DynamicResource Primary}" />
            <TextBlock Classes="h2" Text="{Binding Account}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Classes="h3" Text="{l:L 'Subscription'}" Margin="0,6,0,0" />
          <ComboBox ItemsSource="{Binding Subscriptions}" SelectedItem="{Binding Subscription}" MinWidth="420">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:AzureSubscription">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Classes="mono caption" Text="{Binding Id}" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{l:L 'The Azure resources of the app are billed to this subscription.'}" />
          <TextBlock Classes="error" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- 3: where -->
      <StackPanel Spacing="18" IsVisible="{Binding IsTargetStep}" x:Name="TargetPanel">
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="h3" Text="{l:L 'Resource group'}" />
            <TextBox Text="{Binding ResourceGroup}" PlaceholderText="rg-shop" x:Name="GroupBox" />
            <TextBlock Classes="error" Text="{Binding GroupError}" IsVisible="{Binding GroupError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{l:L 'Type a new name and it is created, or pick one of yours:'}" />
            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="6" LineSpacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AzureResourceGroup">
                  <Button Classes="ghost" Command="{Binding $parent[UserControl].((vm:AzureDeployViewModel)DataContext).PickGroupCommand}" CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Classes="caption" Text="{Binding Location}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <Grid ColumnDefinitions="*,24,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <TextBlock Classes="h3" Text="{l:L 'Region'}" />
            <ComboBox Grid.Row="1" ItemsSource="{Binding Regions}" SelectedItem="{Binding Location}" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
            <TextBlock Grid.Column="2" Classes="h3" Text="{l:L 'Deployment name'}" />
            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Name}" Margin="0,8,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="2" Classes="error" Text="{Binding NameError}" IsVisible="{Binding NameError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Grid.Row="2" Classes="caption" TextWrapping="Wrap" Margin="0,6,0,0" Text="{l:L 'Close to your users; a resource group you pick brings its own.'}" />
            <TextBlock Grid.Row="3" Classes="h3" Text="{l:L 'Administrator'}" Margin="0,16,0,0" />
            <TextBox Grid.Row="4" Text="{Binding AdminEmail}" PlaceholderText="{Binding AdminPlaceholder}" Margin="0,8,0,0" />
            <TextBlock Grid.Row="3" Grid.Column="2" Classes="caption" TextWrapping="Wrap" Margin="0,16,0,0" VerticalAlignment="Bottom"
                       Text="{l:L 'The name of the record in .coworkee/deployments; the resource group unless you change it.'}" />
          </Grid>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h3" Text="{l:L 'Tools'}" />
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="{l:L 'A tool that is on goes along when the app uses it; off leaves it out (--without). Mailpit, a test mail server, only goes along when switched on (--with).'}" />
            <ItemsControl ItemsSource="{Binding Tools}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="18" LineSpacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ToolSwitch">
                  <CheckBox IsChecked="{Binding IsOn}" Content="{Binding Name}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- 4: summary, then the run -->
      <Border Classes="card" IsVisible="{Binding ShowSummary}" x:Name="SummaryCard">
        <StackPanel Spacing="12">
          <TextBlock Classes="h3" Text="{l:L 'Summary'}" />
          <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
            <TextBlock Classes="caption" Text="{l:L 'Account'}" />
            <TextBlock Grid.Column="1" Text="{Binding Account}" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Classes="caption" Text="{l:L 'Subscription'}" />
            <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap">
              <Run Text="{Binding Subscription.Name}" FontWeight="SemiBold" />
              <Run Text="{Binding Subscription.Id}" FontSize="11.5" />
            </TextBlock>
            <TextBlock Grid.Row="2" Classes="caption" Text="{l:L 'Resource group'}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GroupText}" FontWeight="SemiBold" />
            <TextBlock Grid.Row="3" Classes="caption" Text="{l:L 'Region'}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Location}" />
            <TextBlock Grid.Row="4" Classes="caption" Text="{l:L 'Deployment name'}" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Name}" />
            <TextBlock Grid.Row="5" Classes="caption" Text="{l:L 'Administrator'}" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AdminText}" />
            <TextBlock Grid.Row="6" Classes="caption" Text="{l:L 'Tools'}" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ToolsText}" TextWrapping="Wrap" />
          </Grid>
          <Border Classes="banner info">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Classes="small" Data="{StaticResource Icon.Shield}" Foreground="{DynamicResource Primary}" />
              <TextBlock Text="{Binding ScopeText}" TextWrapping="Wrap" FontWeight="SemiBold" x:Name="ScopeLine" />
            </StackPanel>
          </Border>
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="{l:L 'Building, pushing and deploying takes a few minutes. The resources cost money while they exist; deleting the resource group removes all of them.'}" />
          <Button Classes="primary" HorizontalAlignment="Left" Command="{Binding DeployCommand}" IsVisible="{Binding IsSummaryStep}" x:Name="StartDeployButton">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Classes="small" Data="{StaticResource Icon.Rocket}" />
              <TextBlock Text="{l:L 'Deploy'}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding IsDeployStep}" x:Name="RunCard" Padding="0">
        <StackPanel>
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="22,18,22,12">
            <Panel Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Top">
              <PathIcon Classes="small spin" Data="{StaticResource Icon.Restart}" Foreground="{DynamicResource Primary}" IsVisible="{Binding Run.IsBusy}" />
              <PathIcon Data="{StaticResource Icon.CheckCircle}" Foreground="{DynamicResource Success}" IsVisible="{Binding IsDone}" />
              <PathIcon Data="{StaticResource Icon.AlertCircle}" Foreground="{DynamicResource Error}" IsVisible="{Binding IsFailed}" />
            </Panel>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Classes="h3" Text="{l:L 'Deploy'}" />
              <TextBlock Classes="body" Text="{Binding DeployStatus}" TextWrapping="Wrap" Classes.error="{Binding IsFailed}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <Button Command="{Binding Run.StopCommand}" IsVisible="{Binding Run.IsBusy}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Classes="small" Data="{StaticResource Icon.Stop}" />
                  <TextBlock Text="{l:L Stop}" />
                </StackPanel>
              </Button>
              <Button Command="{Binding DeployCommand}" IsVisible="{Binding IsFailed}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Classes="small" Data="{StaticResource Icon.Restart}" />
                  <TextBlock Text="{l:L 'Try again'}" />
                </StackPanel>
              </Button>
              <Button Classes="primary" Command="{Binding CloseCommand}" IsVisible="{Binding IsDone}">
                <TextBlock Text="{l:L 'Back to the app'}" />
              </Button>
            </StackPanel>
          </Grid>
          <StackPanel Spacing="10" Margin="22,0,22,14" IsVisible="{Binding IsDone}">
            <ItemsControl ItemsSource="{Binding Links}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="8" LineSpacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="cli:AppEndpoint">
                  <Button Classes="ghost" Command="{Binding $parent[UserControl].((vm:AzureDeployViewModel)DataContext).OpenCommand}" CommandParameter="{Binding Url}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Classes="small" Data="{StaticResource Icon.OpenInNew}" Foreground="{DynamicResource Primary}" />
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Classes="mono caption" Text="{Binding Url}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="soft">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Classes="small" Data="{StaticResource Icon.Key}" Foreground="{DynamicResource Secondary}" />
                <SelectableTextBlock Text="{Binding PasswordText}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
          <Border Classes="code" CornerRadius="0,0,14,14" Height="300" IsVisible="{Binding Run.Log.Count, Converter={x:Static v:Converters.Positive}}">
            <ListBox ItemsSource="{Binding Run.Log}" Background="Transparent" x:Name="DeployLog">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0,1" />
                  <Setter Property="MinHeight" Value="0" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <SelectableTextBlock Text="{Binding}" FontFamily="{DynamicResource MonoFont}" FontSize="12" TextWrapping="Wrap" Foreground="#c5d5e6" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding !IsDeployStep}">
        <Button Command="{Binding BackCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Classes="small" Data="{StaticResource Icon.ChevronLeft}" />
            <TextBlock Text="{l:L Back}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Classes="primary" Command="{Binding NextCommand}" IsEnabled="{Binding CanGoNext}" IsVisible="{Binding ShowNext}" x:Name="NextButton">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{l:L Next}" />
            <PathIcon Classes="small" Data="{StaticResource Icon.ChevronRight}" />
          </StackPanel>
        </Button>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
