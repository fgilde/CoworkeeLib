<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Coworkee.Studio.ViewModels"
             xmlns:v="using:Coworkee.Studio.Views"
             xmlns:l="using:Coworkee.Studio.Localization"
             x:Class="Coworkee.Studio.Views.LanguagesView"
             x:DataType="vm:LanguagesStep">
  <ScrollViewer Padding="44,12,44,32">
    <StackPanel Spacing="22">
      <ItemsControl ItemsSource="{Binding Errors}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <Border Classes="banner" Margin="0,0,0,6">
              <TextBlock Classes="error" Text="{Binding}" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Classes="overline" Text="{l:L 'LANGUAGES'}" />
            <TextBlock Classes="caption" Text="{Binding ChosenText}" />
          </StackPanel>
          <TextBox Grid.Column="1" Width="280" Text="{Binding Search}" PlaceholderText="{l:L 'Search: French, fr, Français'}" VerticalAlignment="Center" />
        </Grid>
        <ItemsControl ItemsSource="{Binding VisibleLanguages}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="6" ColumnSpacing="6" RowSpacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LanguageItemViewModel">
              <Border Classes="card" Padding="8,4" Classes.on="{Binding IsChecked}">
                <CheckBox IsChecked="{Binding IsChecked}" ToolTip.Tip="{Binding Code}">
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="{Binding Flag}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Classes="h3" Text="{Binding NativeName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="caption" Text="{Binding Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </CheckBox>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <UniformGrid Columns="2" ColumnSpacing="12">
        <Border Classes="card" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Classes="h3" Text="{Binding DefaultOption.Title}" />
            <TextBlock Classes="caption" Text="{Binding DefaultOption.Description}" TextWrapping="Wrap" />
            <ComboBox ItemsSource="{Binding Chosen}" SelectedItem="{Binding Default}" MinWidth="240">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LanguageItemViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Flag}" />
                    <TextBlock Text="{Binding NativeName}" />
                    <TextBlock Classes="mono caption" Text="{Binding Code}" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Border>
        <Border Classes="card" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Classes="h3" Text="{Binding SourceOption.Title}" />
            <TextBlock Classes="caption" Text="{Binding SourceOption.Description}" TextWrapping="Wrap" />
            <ListBox Classes="segments" ItemsSource="{Binding SourceOption.Choices}" SelectedItem="{Binding SourceOption.Choice}" HorizontalAlignment="Left">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ChoiceViewModel">
                  <TextBlock Text="{Binding Description}" FontSize="12.5" FontWeight="SemiBold" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>
      </UniformGrid>

      <StackPanel Spacing="10">
        <TextBlock Classes="overline" Text="{l:L 'TRANSLATION SERVICE'}" />
        <TextBlock Classes="muted" Text="{Binding ProviderOption.Description}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Services}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="4" ColumnSpacing="10" RowSpacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TranslationServiceViewModel">
              <Button Classes="tile" Classes.selected="{Binding IsSelected}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                      Command="{Binding $parent[ItemsControl].((vm:LanguagesStep)DataContext).SelectServiceCommand}" CommandParameter="{Binding}">
                <StackPanel Margin="12,10" Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource PrimarySoft}">
                      <PathIcon Classes="small" Data="{Binding Icon, Converter={x:Static v:Converters.Icon}}" Foreground="{DynamicResource Primary}" />
                    </Border>
                    <TextBlock Classes="h3" Text="{Binding Label}" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Classes="caption" Text="{Binding Text}" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding Pros}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Grid ColumnDefinitions="Auto,*">
                          <PathIcon Margin="0,1,6,0" Classes="small" Data="{StaticResource Icon.ThumbUp}" Foreground="{DynamicResource Success}" VerticalAlignment="Top" />
                          <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap" Text="{Binding}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding Cons}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Grid ColumnDefinitions="Auto,*">
                          <PathIcon Margin="0,1,6,0" Classes="small" Data="{StaticResource Icon.ThumbDown}" Foreground="{DynamicResource Error}" VerticalAlignment="Top" />
                          <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap" Text="{Binding}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Classes="banner info" Padding="10,8">
          <Grid ColumnDefinitions="Auto,*">
            <PathIcon Margin="0,1,8,0" Classes="small" Data="{StaticResource Icon.Key}" Foreground="{DynamicResource Primary}" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap" Text="{Binding ServiceNoteText}" />
          </Grid>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
