<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Coworkee.Studio.ViewModels"
             xmlns:l="using:Coworkee.Studio.Localization"
             x:Class="Coworkee.Studio.Views.BasicsView"
             x:DataType="vm:BasicsStep">
  <ScrollViewer>
    <Grid ColumnDefinitions="*,24,320" Margin="44,12,44,32">
      <StackPanel Spacing="18">
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="h3" Text="{l:L 'App name'}" />
            <TextBox Classes="large" Text="{Binding Name}" PlaceholderText="Shop" x:Name="NameBox" />
            <TextBlock Classes="error" Text="{Binding NameError}" IsVisible="{Binding NameError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
              <PathIcon Classes="small" Data="{StaticResource Icon.Code}" Foreground="{DynamicResource Secondary}" />
              <TextBlock Classes="mono caption" Text="{Binding ProjectsPreview}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="h3" Text="{l:L 'Title'}" />
            <TextBox Text="{Binding TitleOption.Value}" PlaceholderText="{Binding TitlePlaceholder}" />
            <TextBlock Classes="error" Text="{Binding TitleError}" IsVisible="{Binding TitleError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="caption" Text="{Binding TitleOption.Description}" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="h3" Text="{l:L 'Location'}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding Location}" />
              <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseLocationCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Classes="small" Data="{StaticResource Icon.Folder}" />
                  <TextBlock Text="{l:L 'Browse'}" />
                </StackPanel>
              </Button>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Output, Converter={x:Static ObjectConverters.IsNotNull}}">
              <PathIcon Classes="small" Data="{StaticResource Icon.ArrowRight}" Foreground="{DynamicResource Primary}" />
              <TextBlock Classes="mono caption" Text="{Binding Output}" VerticalAlignment="Center" />
            </StackPanel>
            <Border Classes="banner warn" IsVisible="{Binding OutputExists}">
              <TextBlock TextWrapping="Wrap" FontSize="12.5" Text="{l:L 'The folder exists and is not empty. The template refuses to overwrite files; pick another name or folder.'}" />
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Grid.Column="2" Spacing="14">
        <Border Classes="soft" Padding="18">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.Bulb}" Foreground="{DynamicResource Secondary}" />
              <TextBlock Classes="h3" Text="{l:L 'Naming tips'}" />
            </StackPanel>
            <TextBlock Classes="caption" Text="{l:L 'Short and technical: Shop, Crm, Portal. It becomes Shop.Api, Shop.Web and the namespace Shop.Sales.'}" />
            <TextBlock Classes="caption" Text="{l:L 'The title can have spaces and brand words: Acme Shop. It shows in the browser tab, the app bar, the sign-in pages and the Aspire dashboard.'}" />
            <TextBlock Classes="caption" Text="{l:L 'With brand colors the title also names the theme of your app, so it cannot be the name of a built-in theme.'}" />
          </StackPanel>
        </Border>
        <Border Classes="soft" Padding="18">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.Console}" Foreground="{DynamicResource Secondary}" />
              <TextBlock Classes="h3" Text="{l:L 'The same on the command line'}" />
            </StackPanel>
            <Border Classes="code">
              <SelectableTextBlock Text="coworkee new Shop --title &quot;Acme Shop&quot; -o ./Shop" />
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
