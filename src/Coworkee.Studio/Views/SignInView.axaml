<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Coworkee.Studio.ViewModels"
             xmlns:v="using:Coworkee.Studio.Views"
             xmlns:l="using:Coworkee.Studio.Localization"
             x:Class="Coworkee.Studio.Views.SignInView"
             x:DataType="vm:SignInStep">
  <UserControl.Resources>
    <DataTemplate x:Key="Translated" x:DataType="x:String">
      <TextBlock Text="{Binding Converter={x:Static v:Converters.Text}}" FontSize="12.5" FontWeight="SemiBold" />
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer>
    <StackPanel Margin="44,12,44,32" Spacing="18">
      <ItemsControl ItemsSource="{Binding Layouts}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="4" ColumnSpacing="14" RowSpacing="14" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LayoutCardViewModel">
            <Button Classes="tile" Classes.selected="{Binding IsSelected}" VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                    Command="{Binding $parent[ItemsControl].((vm:SignInStep)DataContext).SelectLayoutCommand}" CommandParameter="{Binding}">
              <StackPanel Margin="10" Spacing="8">
                <v:SignInThumb Layout="{Binding Value}" Height="112"
                               Preview="{Binding $parent[ItemsControl].((vm:SignInStep)DataContext).Preview}"
                               Sketch="{Binding $parent[ItemsControl].((vm:SignInStep)DataContext).Sketch}" />
                <StackPanel Spacing="2" Margin="2,0">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="h3" Text="{Binding Title}" />
                    <PathIcon Grid.Column="1" Classes="small" Data="{StaticResource Icon.CheckCircle}" Foreground="{DynamicResource Primary}" IsVisible="{Binding IsSelected}" />
                  </Grid>
                  <TextBlock Classes="caption" Text="{Binding Description}" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Grid x:Name="SignInStyle" ColumnDefinitions="1.25*,24,*">
        <!-- background 1 and 2, named like the layout names them -->
        <Border Classes="card" VerticalAlignment="Top">
          <StackPanel Spacing="16">
            <StackPanel Spacing="2">
              <TextBlock Classes="overline" Text="{l:L 'BACKGROUNDS'}" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{l:L 'The theme decides while nothing is set; an image or video wins over a color or gradient.'}" />
            </StackPanel>
            <v:FillSlot DataContext="{Binding Page}" />
            <Border Height="1" Background="{DynamicResource Lines}" IsVisible="{Binding ShowsPanel}" />
            <v:FillSlot DataContext="{Binding Panel}" IsVisible="{Binding $parent[v:SignInView].((vm:SignInStep)DataContext).ShowsPanel}" />
            <Border Classes="banner" IsVisible="{Binding HasErrors}">
              <ItemsControl ItemsSource="{Binding Errors}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Classes="error" Text="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
        </Border>

        <!-- only what the layout offers -->
        <Border Grid.Column="2" Classes="card" VerticalAlignment="Top">
          <StackPanel Spacing="16">
            <TextBlock Classes="overline" Text="{l:L 'LOOK'}" />
            <StackPanel Spacing="8" IsVisible="{Binding Offers.MediaSide}">
              <StackPanel Spacing="2">
                <TextBlock Classes="h3" Text="{l:L Side}" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{l:L 'Where the media, the poster or the panel sits; the form takes the other side.'}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <RadioButton GroupName="side" Content="{l:L Left}" IsChecked="{Binding MediaLeft}" />
                <RadioButton GroupName="side" Content="{l:L Right}" IsChecked="{Binding MediaRight}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Spacing="8" IsVisible="{Binding Offers.Surface}">
              <StackPanel Spacing="2">
                <TextBlock Classes="h3" Text="{l:L Surface}" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{l:L 'Glass frosts the card and lets the background shine through.'}" />
              </StackPanel>
              <ListBox Classes="segments" HorizontalAlignment="Left" ItemsSource="{x:Static vm:SignInStep.Surfaces}" SelectedItem="{Binding Surface}" ItemTemplate="{StaticResource Translated}" />
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Offers.Animation}">
              <StackPanel Spacing="2">
                <TextBlock Classes="h3" Text="{l:L Aurora}" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{l:L 'Soft fields of color drift slowly behind the form.'}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Aurora}" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Spacing="6" IsVisible="{Binding Offers.Dim}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="h3" Text="{l:L 'Darken the background image'}" />
                <TextBlock Grid.Column="1" Classes="mono caption" Text="{Binding Dim, StringFormat='{}{0} %'}" VerticalAlignment="Center" />
              </Grid>
              <Slider Minimum="0" Maximum="90" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Dim}" />
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding Offers.Tilt}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="h3" Text="{l:L 'Tilt of the cards behind'}" />
                <TextBlock Grid.Column="1" Classes="mono caption" Text="{Binding Tilt, StringFormat='{}{0}°'}" VerticalAlignment="Center" />
              </Grid>
              <Slider Minimum="0" Maximum="12" SmallChange="1" LargeChange="3" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Tilt}" />
            </StackPanel>
            <StackPanel Spacing="8" IsVisible="{Binding Offers.LogoSize}">
              <TextBlock Classes="h3" Text="{l:L 'Logo size'}" />
              <ListBox Classes="segments" HorizontalAlignment="Left" ItemsSource="{x:Static vm:SignInStep.LogoSizes}" SelectedItem="{Binding LogoSize}" ItemTemplate="{StaticResource Translated}" />
            </StackPanel>
            <Border Height="1" Background="{DynamicResource Lines}" />
            <StackPanel Spacing="8">
              <StackPanel Spacing="2">
                <TextBlock Classes="h3" Text="{l:L 'Loading screen'}" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{l:L 'Background while the app loads; the image or video shows there with every layout.'}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <RadioButton GroupName="loading" Content="{l:L Animated}" IsChecked="{Binding LoadingAnimated}" />
                <RadioButton GroupName="loading" Content="{l:L 'Image or video'}" IsChecked="{Binding LoadingMedia}" />
                <RadioButton GroupName="loading" Content="{l:L Plain}" IsChecked="{Binding LoadingPlain}" />
              </StackPanel>
            </StackPanel>
            <Border Classes="banner info">
              <TextBlock TextWrapping="Wrap" FontSize="12.5" Text="{l:L 'Administrators switch layout, backgrounds and looks later on the Themes page of the app, without a new deployment.'}" />
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <StackPanel Spacing="8">
        <TextBlock Classes="overline" Text="{l:L 'PREVIEW'}" />
        <v:SignInThumb x:Name="SignInPreview" Layout="{Binding Layout}" Sketch="{Binding Sketch}" Preview="{Binding Preview}" Height="300" HorizontalAlignment="Left" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
