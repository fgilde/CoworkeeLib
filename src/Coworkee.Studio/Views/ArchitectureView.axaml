<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Coworkee.Studio.ViewModels"
             xmlns:v="using:Coworkee.Studio.Views"
             xmlns:l="using:Coworkee.Studio.Localization"
             x:Class="Coworkee.Studio.Views.ArchitectureView"
             x:DataType="vm:ArchitectureStep">
  <UserControl.Resources>
    <DataTemplate x:Key="InfrastructureCard" x:DataType="vm:OptionViewModel">
      <Border Classes="card" Padding="16" Classes.on="{Binding IsOn}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SecondarySoft}" VerticalAlignment="Top" Margin="0,0,10,0">
              <Panel>
                <PathIcon IsVisible="{Binding IsChoice}" Data="{Binding Choice.Icon, Converter={x:Static v:Converters.Icon}}" Foreground="{DynamicResource Secondary}" />
                <PathIcon IsVisible="{Binding IsBool}" Data="{StaticResource Icon.Lightning}" Foreground="{DynamicResource Secondary}" />
              </Panel>
            </Border>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Classes="h3" Text="{Binding Title}" />
              <TextBlock Classes="mono caption" Text="{Binding Flag}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="2" IsVisible="{Binding IsBool}" IsChecked="{Binding IsOn}" VerticalAlignment="Top" Margin="0,-4,0,0" />
          </Grid>
          <ListBox Classes="segments" IsVisible="{Binding IsChoice}" IsEnabled="{Binding IsAvailable}" Opacity="{Binding IsAvailable, Converter={x:Static v:Converters.Dim}}"
                   ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ChoiceViewModel">
                <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding Text}">
                  <PathIcon Classes="small" Data="{Binding Icon, Converter={x:Static v:Converters.Icon}}" />
                  <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Classes="caption" IsVisible="{Binding IsBool}" Text="{Binding Description}" TextWrapping="Wrap" />
          <TextBlock Classes="caption" IsVisible="{Binding IsChoice}" Text="{Binding Choice.Text}" />
          <Border Classes="banner info" Padding="10,8" IsVisible="{Binding HasNote}">
            <Grid ColumnDefinitions="Auto,*">
              <PathIcon Margin="0,1,8,0" Classes="small" Data="{StaticResource Icon.Info}" Foreground="{DynamicResource Primary}" VerticalAlignment="Top" />
              <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap" Text="{Binding NoteText}" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="OptionCard" x:DataType="vm:OptionViewModel">
      <Border Classes="card" Padding="16" Classes.on="{Binding IsOn}">
        <StackPanel Spacing="8" Opacity="{Binding IsAvailable, Converter={x:Static v:Converters.Dim}}">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock Classes="h3" Text="{Binding Title}" />
              <WrapPanel ItemSpacing="6">
                <Border Classes="chip" IsVisible="{Binding HasPackage}" Padding="8,1">
                  <TextBlock Text="{Binding Package}" FontSize="11" />
                </Border>
                <TextBlock Classes="mono caption" Text="{Binding Flag}" VerticalAlignment="Center" />
              </WrapPanel>
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsVisible="{Binding IsBool}" IsChecked="{Binding IsOn}" VerticalAlignment="Top" Margin="0,-4,0,0" />
          </Grid>
          <Border Classes="banner warn" Padding="10,6" IsVisible="{Binding HasNote}">
            <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding NoteText}" />
          </Border>
          <TextBlock Classes="body" FontSize="12.5" LineHeight="18" Text="{Binding Description}" />
      <TextBox IsVisible="{Binding IsText}" Text="{Binding Text}" PlaceholderText="{Binding Flag}" />
          <ListBox Classes="segments" IsVisible="{Binding IsChoice}" ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}" HorizontalAlignment="Left">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ChoiceViewModel">
                <TextBlock Text="{Binding Value}" FontSize="12.5" FontWeight="SemiBold" ToolTip.Tip="{Binding Text}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Classes="caption" IsVisible="{Binding IsChoice}" Text="{Binding Choice.Text}" />
          <ItemsControl IsVisible="{Binding IsMulti}" ItemsSource="{Binding MultiChoices}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="16" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MultiChoiceViewModel">
                <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Text}" ToolTip.Tip="{Binding Value}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Classes="soft" Padding="10,8">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="Auto,*">
<PathIcon Margin="0,1,6,0" Classes="small" Data="{StaticResource Icon.Bulb}" Foreground="{DynamicResource Warning}" VerticalAlignment="Top" />
<TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap" Text="{Binding WhenToUse}" />
</Grid>
              <ItemsControl ItemsSource="{Binding Pros}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Grid ColumnDefinitions="Auto,*">
<PathIcon Margin="0,1,6,0" Classes="small" Data="{StaticResource Icon.ThumbUp}" Foreground="{DynamicResource Success}" />
<TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap" Text="{Binding}" />
</Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Cons}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Grid ColumnDefinitions="Auto,*">
<PathIcon Margin="0,1,6,0" Classes="small" Data="{StaticResource Icon.ThumbDown}" Foreground="{DynamicResource Error}" />
<TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap" Text="{Binding}" />
</Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <Grid ColumnDefinitions="*,340" Margin="44,12,0,0">
    <ScrollViewer Padding="0,0,24,32">
      <StackPanel Spacing="28">
        <!-- presets: one compact row -->
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="overline" Text="{l:L 'APP TYPE'}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="link" Content="{l:L 'Template defaults'}" Command="{Binding ResetOptionsCommand}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Presets}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" ColumnSpacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PresetViewModel">
                <Button Classes="tile" Classes.selected="{Binding IsActive}" ToolTip.Tip="{Binding Description}" Padding="6,10"
                        Command="{Binding $parent[ItemsControl].((vm:ArchitectureStep)DataContext).ApplyPresetCommand}" CommandParameter="{Binding}">
                  <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource PrimarySoft}" HorizontalAlignment="Center">
                      <PathIcon Classes="small" Data="{Binding Icon, Converter={x:Static v:Converters.Icon}}" Foreground="{DynamicResource Primary}" />
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Errors}" IsVisible="{Binding HasErrors}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Border Classes="banner" Margin="0,0,0,6">
                <TextBlock Classes="error" Text="{Binding}" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- infrastructure: where the app runs, the other services, then the AI provider -->
        <StackPanel Spacing="12" DataContext="{Binding InfrastructureGroup}" x:DataType="vm:OptionGroupViewModel">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Data="{Binding Icon, Converter={x:Static v:Converters.Icon}}" Foreground="{DynamicResource Secondary}" />
              <TextBlock Classes="h2" Text="{Binding Title}" />
            </StackPanel>
            <TextBlock Classes="muted" Text="{Binding Text}" TextWrapping="Wrap" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding $parent[UserControl].((vm:ArchitectureStep)DataContext).Infrastructure}" ItemTemplate="{StaticResource InfrastructureCard}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" ColumnSpacing="12" RowSpacing="12" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Options}" ItemTemplate="{StaticResource OptionCard}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" ColumnSpacing="12" RowSpacing="12" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>

        <!-- AI assistant: provider, model, endpoint, key -->
        <StackPanel Spacing="10" x:Name="AiSection" Margin="0,-16,0,0" DataContext="{Binding Ai}" x:DataType="vm:AiSetupViewModel">
          <TextBlock Classes="overline" Text="{l:L 'AI ASSISTANT'}" />
          <Border Classes="card" Padding="16">
            <StackPanel Spacing="14" IsEnabled="{Binding IsAvailable}" Opacity="{Binding IsAvailable, Converter={x:Static v:Converters.Dim}}">
              <ListBox Classes="providers" ItemsSource="{Binding Providers}" SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:AiProviderTileViewModel">
                    <StackPanel Spacing="6" HorizontalAlignment="Center" ToolTip.Tip="{Binding Name}">
                      <Border Width="34" Height="34" CornerRadius="9" HorizontalAlignment="Center" Background="{Binding Color, Converter={x:Static v:Converters.HexBrush}}">
                        <Panel>
                          <PathIcon IsVisible="{Binding HasLogo}" Width="20" Height="20" Foreground="White" Data="{Binding Logo, Converter={x:Static v:Converters.PathData}}" />
                          <TextBlock IsVisible="{Binding !HasLogo}" Text="{Binding Monogram}" Foreground="White" FontWeight="Bold" FontSize="16"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Panel>
                      </Border>
                      <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" />
                      <TextBlock Classes="caption" Text="{Binding Tag}" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Classes="h3" Text="{Binding Info.Name}" />
                  <TextBlock Classes="caption" Text="{Binding Notes}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="link" IsVisible="{Binding HasKeyUrl}" Content="{Binding KeyLinkText}" Command="{Binding OpenKeyUrlCommand}" VerticalAlignment="Top" />
              </Grid>

              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <StackPanel Spacing="4">
                  <TextBlock FontWeight="SemiBold" Text="{l:L 'Model'}" />
                  <AutoCompleteBox Text="{Binding Model}" ItemsSource="{Binding Models}" FilterMode="Contains" MinimumPrefixLength="0" PlaceholderText="{Binding ModelHint}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock FontWeight="SemiBold" Text="{l:L 'Endpoint'}" />
                  <TextBox Text="{Binding Endpoint}" PlaceholderText="{Binding EndpointHint}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4" IsVisible="{Binding NeedsKey}">
                  <TextBlock FontWeight="SemiBold" Text="{l:L 'API key (optional)'}" />
                  <TextBox Text="{Binding ApiKey}" PasswordChar="•" PlaceholderText="{l:L 'Goes to the user secrets'}" />
                </StackPanel>
              </Grid>

              <Border Classes="banner info" Padding="10,8">
                <Grid ColumnDefinitions="Auto,*">
                  <PathIcon Margin="0,1,8,0" Classes="small" Data="{StaticResource Icon.Info}" Foreground="{DynamicResource Primary}" VerticalAlignment="Top" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding Note}" />
                    <TextBlock FontSize="12" TextWrapping="Wrap" IsVisible="{Binding NeedsKey}"
                               Text="{l:L 'A key typed here never goes into the spec: after creation the Studio writes it to the user secrets of the app host.'}" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding OtherGroups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:OptionGroupViewModel">
              <StackPanel Spacing="12" Margin="0,0,0,28">
                <StackPanel Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="{Binding Icon, Converter={x:Static v:Converters.Icon}}" Foreground="{DynamicResource Secondary}" />
                    <TextBlock Classes="h2" Text="{Binding Title}" />
                  </StackPanel>
                  <TextBlock Classes="muted" Text="{Binding Text}" TextWrapping="Wrap" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Options}" ItemTemplate="{StaticResource OptionCard}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="2" ColumnSpacing="12" RowSpacing="12" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- what the solution contains -->
    <Border Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Lines}" BorderThickness="1,0,0,0">
      <ScrollViewer Padding="22,4,22,24">
        <StackPanel Spacing="16">
          <StackPanel Spacing="4">
            <TextBlock Classes="overline" Text="{l:L 'YOUR SOLUTION'}" />
            <TextBlock Classes="h3" Text="{Binding SummaryHeadline}" />
          </StackPanel>
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Classes="small" Data="{StaticResource Icon.Container}" Foreground="{DynamicResource Secondary}" />
              <TextBlock FontWeight="SemiBold" Text="{l:L 'Containers in the Aspire app host'}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Summary.Containers}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="6" LineSpacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Classes="chip teal">
                    <TextBlock Text="{Binding}" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Classes="small" Data="{StaticResource Icon.Cube}" Foreground="{DynamicResource Primary}" />
              <TextBlock FontWeight="SemiBold" Text="{l:L 'Projects'}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Summary.Projects}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Classes="mono" FontSize="12" Text="{Binding}" Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Classes="small" Data="{StaticResource Icon.Package}" Foreground="{DynamicResource Primary}" />
              <TextBlock FontWeight="SemiBold" Text="{l:L 'Coworkee packages'}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Summary.Packages}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Classes="mono caption" Text="{Binding}" Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
