<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Coworkee.Studio.ViewModels"
             xmlns:v="using:Coworkee.Studio.Views"
             x:Class="Coworkee.Studio.App"
             Name="Coworkee Studio"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Coworkee.Studio/Styles/Icons.axaml" />
        <ResourceInclude Source="avares://Coworkee.Studio/Styles/Colors.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <FontFamily x:Key="StudioFont">Segoe UI, Inter, avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
      <FontFamily x:Key="MonoFont">Consolas, Menlo, DejaVu Sans Mono, Cascadia Mono, monospace</FontFamily>
      <CornerRadius x:Key="Radius">14</CornerRadius>
      <CornerRadius x:Key="SmallRadius">10</CornerRadius>
      <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
    </ResourceDictionary>
  </Application.Resources>

  <Application.DataTemplates>
    <DataTemplate DataType="vm:WelcomeStep"><v:WelcomeView /></DataTemplate>
    <DataTemplate DataType="vm:BasicsStep"><v:BasicsView /></DataTemplate>
    <DataTemplate DataType="vm:BrandingStep"><v:BrandingView /></DataTemplate>
    <DataTemplate DataType="vm:SignInStep"><v:SignInView /></DataTemplate>
    <DataTemplate DataType="vm:ArchitectureStep"><v:ArchitectureView /></DataTemplate>
    <DataTemplate DataType="vm:EntitiesStep"><v:EntitiesView /></DataTemplate>
    <DataTemplate DataType="vm:ReviewStep"><v:ReviewView /></DataTemplate>
    <DataTemplate DataType="vm:GenerateStep"><v:GenerateView /></DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#1565c0" RegionColor="#f4f7fb" ErrorText="#c62828" />
        <ColorPaletteResources x:Key="Dark" Accent="#64b5f6" RegionColor="#0f1722" ErrorText="#ef9a9a" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <StyleInclude Source="avares://Coworkee.Studio/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
