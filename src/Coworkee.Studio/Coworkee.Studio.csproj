<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>coworkee-ui</ToolCommandName>
    <PackageId>Coworkee.Studio</PackageId>
    <SatelliteResourceLanguages>en;de</SatelliteResourceLanguages>
    <ApplicationIcon>Assets\coworkee.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Coworkee.Cli.Spec\Coworkee.Cli.Spec.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <!-- ponytail: the tool carries Skia and HarfBuzz for the common desktops only, without their native debug symbols (that alone is 200 MB); add a RID here when someone needs it -->
  <Target Name="TrimToolNatives" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('runtimes')) and ('%(Extension)' == '.pdb' or !$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '^runtimes.(win-x64|win-arm64|win-x86|linux-x64|linux-arm64|linux-musl-x64|osx).')))" />
    </ItemGroup>
  </Target>
</Project>
