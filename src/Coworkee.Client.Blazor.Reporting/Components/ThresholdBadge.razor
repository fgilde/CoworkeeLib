@if (Stop is { } stop && ThresholdColors.Css(stop.Color) is { } color)
{
    <span class="cw-threshold @Class" style="color:@color" title="@stop.Label" role="img" aria-label="@(stop.Label ?? stop.Color)" data-threshold="@stop.Color">
        <MudIcon Icon="@ThresholdColors.Icon(stop.Color)" Size="Size.Small" Style="font-size:1em" />
        @if (ShowLabel && stop.Label is { Length: > 0 } label)
        {
            <span class="cw-threshold-label">@label</span>
        }
    </span>
}
