@inherits WidgetBase
@using ApexCharts

<WidgetStatus Loading="Loading" Error="@Error" Empty="@(_series.Count == 0 && !Loading)" Hint="@Hint">
    <div class="cw-chart" data-testid="chart" data-kind="@Widget.Options.Chart" data-markers="@Markers">
        @if (_options is not null && _series.Count > 0)
        {
            <ApexChart @key="_render" TItem="ChartPoint" Options="_options" Height="@("100%")" Width="@("100%")" OnDataPointSelection="SelectAsync" XAxisType="@(Timeline ? XAxisType.Datetime : XAxisType.Category)">
                @foreach (var series in Shown)
                {
                    @if (Widget.Options.Chart == ChartKind.Scatter)
                    {
                        <ApexPointSeries TItem="ChartPoint" Items="series.Points" Name="@series.Name" SeriesType="SeriesType.Scatter" XValue="p => p.X" YValue="p => p.Value" />
                    }
                    else
                    {
                        <ApexPointSeries TItem="ChartPoint" Items="series.Points" Name="@series.Name" SeriesType="ChartOptions.SeriesType(Kind)" XValue="p => Timeline ? p.Date : p.Label" YValue="p => p.Value"
                                         ShowDataLabels="@(Widget.Options.ShowDataLabels || Kind is ChartKind.Treemap or ChartKind.Heatmap)" PointColor="@(Banded ? BarColor : null)" />
                    }
                }
            </ApexChart>
        }
    </div>
    @if (Banded)
    {
        <ThresholdLegend Options="Widget.Options" />
    }
</WidgetStatus>
