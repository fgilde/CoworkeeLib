@switch (Widget.Type)
{
    case WidgetType.Markdown:
        <div class="cw-markdown" data-testid="markdown-widget">
            <MudMarkdown Value="@Markdown" />
        </div>
        break;
    case WidgetType.Image when Safe:
        <img class="cw-image" src="@Widget.Options.Url" alt="@(Widget.Title ?? string.Empty)" loading="lazy" data-testid="image-widget" />
        break;
    case WidgetType.Embed when Safe:
        <iframe class="cw-embed" src="@Widget.Options.Url" title="@(Widget.Title ?? string.Empty)" sandbox="@Sandbox" referrerpolicy="no-referrer" loading="lazy" data-testid="embed-widget"></iframe>
        break;
    default:
        <div class="cw-widget-message">
            <MudIcon Icon="@Icons.Material.Outlined.Link" />
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["Enter an http or https address."]</MudText>
        </div>
        break;
}
