<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Aspire ships Keycloak (and some others) only as preview packages -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.SqlServer" />
    <PackageReference Include="Aspire.Hosting.Redis" />
    <PackageReference Include="Aspire.Hosting.Elasticsearch" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.MailPit" />
    <PackageReference Include="Aspire.Hosting.Keycloak" />
    <PackageReference Include="Aspire.Hosting.Docker" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Nextended.Aspire.Hosting.Grafana" />
    <PackageReference Include="Nextended.Aspire.Hosting.WebDataStudio" />
    <PackageReference Include="Nextended.Aspire.Hosting.AspireUI" />
    <ProjectReference Include="..\Coworkee.Contracts\Coworkee.Contracts.csproj" />
    <EmbeddedResource Include="Dashboards\*.json" LogicalName="Dashboards.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
