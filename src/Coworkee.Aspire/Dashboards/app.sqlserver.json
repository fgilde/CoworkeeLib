          "rawSql": "SELECT TOP 15 CreatedAt AS [Created], JSON_VALUE(InvocationData, '$.Type') AS [Job], JSON_VALUE(InvocationData, '$.Method') AS [Method], StateName AS [State] FROM [HangFire].[Job] WHERE StateName IN ('Failed', 'Processing', 'Enqueued', 'Scheduled') ORDER BY CreatedAt DESC",
          "format": "table",
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
