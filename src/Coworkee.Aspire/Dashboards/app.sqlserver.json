    {
      "type": "timeseries",
      "title": "Sign-ins (sessions started)",
      "description": "Authorization codes issued by the auth server: one per interactive sign-in.",
      "datasource": {
        "type": "mssql",
        "uid": "app-database"
      },
      "targets": [
        {
          "datasource": {
            "type": "mssql",
            "uid": "app-database"
          },
          "rawSql": "SELECT DATEADD(hour, DATEDIFF(hour, 0, [CreationDate]), 0) AS time, COUNT(*) AS [sign-ins] FROM [auth].[OpenIddictTokens] WHERE [Type] LIKE '%authorization_code' AND $__timeFilter([CreationDate]) GROUP BY DATEADD(hour, DATEDIFF(hour, 0, [CreationDate]), 0) ORDER BY 1",
          "format": "time_series",
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisBorderShow": false,
            "barAlignment": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 9
    },
