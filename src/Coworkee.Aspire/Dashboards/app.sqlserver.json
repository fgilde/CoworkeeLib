    {
      "type": "table",
      "title": "Last sign-ins",
      "description": "",
      "datasource": {
        "type": "mssql",
        "uid": "app-database"
      },
      "targets": [
        {
          "datasource": {
            "type": "mssql",
            "uid": "app-database"
          },
          "rawSql": "SELECT TOP 15 [Email] AS [Email], CONCAT([FirstName], ' ', [LastName]) AS [Name], [LastLoginAt] AS [Last sign-in], [IsActive] AS [Active] FROM [cw].[Users] ORDER BY CASE WHEN [LastLoginAt] IS NULL THEN 1 ELSE 0 END, [LastLoginAt] DESC",
          "format": "table",
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last sign-in"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
