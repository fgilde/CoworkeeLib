{
  "uid": "coworkee-runtime",
  "title": ".NET runtime",
  "description": "CPU, memory, garbage collection, thread pool and exceptions of every .NET service.",
  "tags": [
    "coworkee"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "coworkee"
      ],
      "asDropdown": true,
      "title": "Coworkee",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(dotnet_process_cpu_time_seconds_total, job)",
          "refId": "service"
        },
        "definition": "label_values(dotnet_process_cpu_time_seconds_total, job)",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Process",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 2,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU",
      "description": "CPU time of the process, relative to all cores.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job) (rate(dotnet_process_cpu_time_seconds_total{job=~\"$service\"}[$__rate_interval])) / on(job) group_left max by (job) (dotnet_process_cpu_count{job=~\"$service\"})",
          "legendFormat": "{{job}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisBorderShow": false,
            "barAlignment": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 3
    },
