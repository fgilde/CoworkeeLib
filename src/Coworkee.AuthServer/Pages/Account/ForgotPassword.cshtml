@page
@model Coworkee.AuthServer.Pages.Account.ForgotPasswordModel
@{ ViewData["Title"] = "Forgot password"; }
<h1>Forgot password</h1>
@if (Model.Sent)
{
  <p class="notice" role="status">If an account exists for this address, we sent a link to choose a new password.</p>
  <div class="links"><a asp-page="Login">Back to sign in</a></div>
}
else
{
  <form method="post">
    <label for="email">Email</label>
    <input id="email" type="email" asp-for="Input.Email" autocomplete="username" required autofocus />
    <button type="submit" style="margin-top:18px">Send link</button>
    <div class="links"><a asp-page="Login">Back to sign in</a></div>
  </form>
}
