@page
@model Coworkee.AuthServer.Pages.Account.ForgotPasswordModel
@{ ViewData["Title"] = T("Forgot password"); }
<h1>@T("Forgot password")</h1>
@if (Model.Sent)
{
  <p class="notice" role="status">@T("If an account exists for this address, we sent a link to choose a new password.")</p>
  <div class="links"><a asp-page="Login">@T("Back to sign in")</a></div>
}
else
{
  <form method="post">
    <label for="email">@T("Email")</label>
    <input id="email" type="email" asp-for="Input.Email" autocomplete="username" required autofocus />
    <button type="submit" style="margin-top:18px">@T("Send link")</button>
    <div class="links"><a asp-page="Login">@T("Back to sign in")</a></div>
  </form>
}
