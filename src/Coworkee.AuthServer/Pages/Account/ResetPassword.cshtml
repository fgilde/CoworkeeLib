@page
@model Coworkee.AuthServer.Pages.Account.ResetPasswordModel
@{ ViewData["Title"] = "Choose a new password"; }
<h1>New password</h1>
@if (Model.Done)
{
  <p class="notice" role="status">Your password was changed. You can sign in now.</p>
  <div class="links"><a asp-page="Login">Sign in</a></div>
}
else
{
  <form method="post">
    <label for="password">New password</label>
    <input id="password" type="password" asp-for="Input.Password" autocomplete="new-password" required autofocus />
    <label for="confirm">Repeat password</label>
    <input id="confirm" type="password" asp-for="Input.ConfirmPassword" autocomplete="new-password" required />
    <button type="submit" style="margin-top:18px">Change password</button>
    @foreach (var error in Model.Errors)
    {
      <p class="error" role="alert">@error</p>
    }
  </form>
}
