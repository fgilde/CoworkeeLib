@page
@model Coworkee.AuthServer.Pages.Account.RegisterModel
@{ ViewData["Title"] = "Create an account"; }
<h1>Create an account</h1>
@if (Model.Registered)
{
  <p class="notice" role="status">Check your inbox to confirm your email address. An administrator activates new accounts.</p>
  <div class="links"><a asp-page="Login">Back to sign in</a></div>
}
else
{
  <form method="post">
    <label for="first">First name</label>
    <input id="first" type="text" asp-for="Input.FirstName" autocomplete="given-name" style="width:100%;padding:12px;border:1px solid var(--rule);background:transparent;color:var(--ink);font:inherit" />
    <label for="last">Last name</label>
    <input id="last" type="text" asp-for="Input.LastName" autocomplete="family-name" style="width:100%;padding:12px;border:1px solid var(--rule);background:transparent;color:var(--ink);font:inherit" />
    <label for="email">Email</label>
    <input id="email" type="email" asp-for="Input.Email" autocomplete="email" required />
    <label for="password">Password</label>
    <input id="password" type="password" asp-for="Input.Password" autocomplete="new-password" required />
    <label for="confirm">Repeat password</label>
    <input id="confirm" type="password" asp-for="Input.ConfirmPassword" autocomplete="new-password" required />
    <button type="submit" style="margin-top:18px">Create account</button>
    @foreach (var error in Model.Errors)
    {
      <p class="error" role="alert">@error</p>
    }
    <div class="links"><a asp-page="Login">Back to sign in</a></div>
  </form>
}
