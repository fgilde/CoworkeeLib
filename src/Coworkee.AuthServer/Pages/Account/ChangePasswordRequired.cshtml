@page
@model Coworkee.AuthServer.Pages.Account.ChangePasswordRequiredModel
@{ ViewData["Title"] = T("Choose a new password"); }
<h1>@T("Choose a new password")</h1>
<p class="hint">@(Model.Expired ? T("Your password expired. Choose a new one to continue.") : T("An administrator asks you to choose your own password before you continue."))</p>
<form method="post">
  <input type="hidden" asp-for="ReturnUrl" />
  <label for="current">@T("Current password")</label>
  <input id="current" type="password" asp-for="Input.CurrentPassword" autocomplete="current-password" required autofocus />
  <label for="password">@T("New password")</label>
  <input id="password" type="password" asp-for="Input.NewPassword" autocomplete="new-password" required />
  <label for="confirm">@T("Repeat new password")</label>
  <input id="confirm" type="password" asp-for="Input.ConfirmPassword" autocomplete="new-password" required />
  <button type="submit" style="margin-top:18px">@T("Change password")</button>
  @foreach (var error in Model.Errors)
  {
    <p class="error" role="alert">@error</p>
  }
</form>
