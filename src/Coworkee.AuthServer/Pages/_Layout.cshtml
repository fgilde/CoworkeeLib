@inject Coworkee.AuthServer.AuthBrandingProvider BrandingProvider
@{ var brand = await BrandingProvider.GetAsync(Context.RequestAborted); }
<!doctype html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] · @brand.AppName</title>
  <style>
    :root { --paper:#f3efe6; --ink:#16140f; --ink-2:#4a463d; --rule:#d6cfbf; --signal:#e2552d; }
    @@media (prefers-color-scheme: dark) { :root { --paper:#14130f; --ink:#efe9dc; --ink-2:#bdb6a6; --rule:#34312a; --signal:#f06a43; } }
    * { box-sizing: border-box; }
    body { margin:0; min-height:100vh; display:grid; place-items:center; background:var(--paper); color:var(--ink); font:16px/1.5 "Segoe UI", system-ui, sans-serif; }
    main { width:min(420px, 92vw); border:1px solid var(--ink); padding:32px; }
    h1 { font-family: Georgia, serif; font-weight:400; font-size:34px; margin:0 0 24px; }
    label { display:block; font-size:13px; text-transform:uppercase; letter-spacing:.08em; color:var(--ink-2); margin:16px 0 6px; }
    input[type=email], input[type=password], input[type=text], input[type=tel], input[type=file] { width:100%; padding:12px; border:1px solid var(--rule); background:transparent; color:var(--ink); font:inherit; }
    .row { display:grid; grid-template-columns:1fr 2fr; gap:12px; }
    .steps { display:flex; flex-wrap:wrap; gap:6px 14px; list-style:none; padding:0; margin:0 0 8px; font-size:13px; color:var(--ink-2); counter-reset:step; }
    .steps li { counter-increment:step; }
    .steps li::before { content:counter(step) ". "; }
    .steps li.current { color:var(--ink); font-weight:600; border-bottom:2px solid var(--signal); }
    .actions { display:flex; flex-direction:row-reverse; gap:8px; margin-top:18px; }
    button.secondary { background:transparent; color:var(--ink); border:1px solid var(--ink); }
    .choice { display:flex; gap:10px; align-items:flex-start; padding:12px; border:1px solid var(--rule); margin:8px 0; text-transform:none; letter-spacing:0; font-size:15px; color:var(--ink); cursor:pointer; }
    .summary { display:grid; grid-template-columns:auto 1fr; gap:4px 14px; margin:8px 0 16px; }
    .summary dt { color:var(--ink-2); font-size:13px; text-transform:uppercase; letter-spacing:.08em; }
    .summary dd { margin:0; }
    .hint { display:block; color:var(--ink-2); margin-bottom:6px; }
    .check { display:flex; gap:8px; align-items:center; margin:16px 0; text-transform:none; letter-spacing:0; }
    button { width:100%; padding:13px; background:var(--ink); color:var(--paper); border:0; font:inherit; text-transform:uppercase; letter-spacing:.08em; cursor:pointer; }
    button:hover { background:var(--signal); }
    .error { color:var(--signal); margin:12px 0 0; }
    .notice { margin:12px 0 0; }
    .links { display:flex; justify-content:space-between; margin-top:18px; font-size:14px; }
    form.external button { background:transparent; color:var(--ink); border:1px solid var(--ink); margin-bottom:8px; }
    form.external button:hover { background:var(--ink); color:var(--paper); }
    .divider { text-align:center; margin:14px 0; font-size:13px; opacity:.6; }
    a { color:var(--ink); }
    code.recovery { display:inline-block; margin:4px 8px 4px 0; font-size:15px; }
    .key { font-family:monospace; font-size:18px; letter-spacing:.08em; }
    .brand { display:flex; align-items:center; gap:10px; margin:0 0 20px; font-size:13px; text-transform:uppercase; letter-spacing:.12em; color:var(--ink-2); }
    .brand img { height:32px; max-width:160px; }
    a.brand { text-decoration:none; }
    main.wide { width:min(760px, 92vw); }
    .apps { display:grid; grid-template-columns:repeat(auto-fill, minmax(200px, 1fr)); gap:12px; list-style:none; padding:0; margin:0; }
    .app { display:flex; gap:14px; align-items:center; height:100%; padding:16px; border:1px solid var(--rule); text-decoration:none; transition:border-color .15s, transform .15s; }
    .app:hover, .app:focus-visible { border-color:var(--signal); transform:translateY(-2px); }
    .app img, .app .monogram { flex:none; width:44px; height:44px; object-fit:contain; }
    .app .monogram { display:grid; place-items:center; background:var(--ink); color:var(--paper); font:24px Georgia, serif; }
    .app:hover .monogram { background:var(--signal); }
    .app-text { display:flex; flex-direction:column; min-width:0; }
    .app-text strong { font-family:Georgia, serif; font-weight:400; font-size:20px; overflow-wrap:anywhere; }
    .app-text .hint { margin:2px 0 0; font-size:14px; }
    @@media (max-width:480px) { main { padding:24px 20px; } }
  </style>
  @if (brand.Css is { Length: > 0 } css)
  {
    <style>@Html.Raw(css)</style>
  }
</head>
<body><main class="@(ViewData["Wide"] is true ? "wide" : null)">
  <a class="brand" href="/" data-testid="brand">
    @if (brand.LogoUrl is { } logo)
    {
      <img src="@logo" alt="" />
    }
    <span>@brand.AppName</span>
  </a>
  @RenderBody()
</main></body>
</html>
