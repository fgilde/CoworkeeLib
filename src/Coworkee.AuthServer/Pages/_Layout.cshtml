@inject Coworkee.AuthServer.AuthBrandingProvider BrandingProvider
@{
  var brand = await BrandingProvider.GetAsync(Context.RequestAborted);
  var mode = await BrandingProvider.ModeAsync(Context.RequestAborted);
}
<!doctype html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-mode="@mode">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>@ViewData["Title"] · @brand.AppName</title>
  <link rel="stylesheet" href="@Coworkee.AuthServer.AuthAssets.Url("auth.css")" />
  @if (brand.Css is { Length: > 0 } css)
  {
    <style>@Html.Raw(css)</style>
  }
  <script src="@Coworkee.AuthServer.AuthAssets.Url("auth.js")" defer></script>
  <script src="@Coworkee.AuthServer.AuthAssets.Url("passkey.js")" defer></script>
</head>
<body class="layout-@(((string?)ViewData["Design"] ?? brand.Layout).ToLowerInvariant())@(brand.Classes is { Length: > 0 } classes ? " " + classes : null)" style="@brand.Style"
      data-text-show="@T("Show password")" data-text-hide="@T("Hide password")"
      data-text-caps="@T("Caps Lock is on")" data-text-last="@T("Last used")"
      data-text-passkey-failed="@T("The passkey did not work. Try again or use another way to sign in.")">
  @if (brand.HasBackground)
  {
    @* background 1 behind every layout, fixed while the page scrolls: a file or a fill (--page-fill); --dim darkens it *@
    <div class="page-background" aria-hidden="true" style="--dim:@(brand.Dim)%" data-testid="design-background">
      @if (brand.Design.BackgroundUrl is { } background)
      {
        if (brand.BackgroundIsVideo)
        {
          <video src="@background" autoplay muted loop playsinline></video>
        }
        else
        {
          <img src="@background" alt="" />
        }
      }
    </div>
  }
  @if (brand.Aurora)
  {
    @* blurred fields of the fill's or the theme's colors that drift above background 1 *@
    <div class="aurora" aria-hidden="true" data-testid="design-aurora"><span></span><span></span><span></span></div>
  }
  @RenderBody()
</body>
</html>
