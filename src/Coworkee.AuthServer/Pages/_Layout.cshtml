@inject Coworkee.AuthServer.AuthBrandingProvider BrandingProvider
@{
  var brand = await BrandingProvider.GetAsync(Context.RequestAborted);
  var mode = await BrandingProvider.ModeAsync(Context.RequestAborted);
}
<!doctype html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-mode="@mode">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>@ViewData["Title"] · @brand.AppName</title>
  <link rel="stylesheet" href="@Coworkee.AuthServer.AuthAssets.Url("auth.css")" />
  @if (brand.Css is { Length: > 0 } css)
  {
    <style>@Html.Raw(css)</style>
  }
  <script src="@Coworkee.AuthServer.AuthAssets.Url("auth.js")" defer></script>
  <script src="@Coworkee.AuthServer.AuthAssets.Url("passkey.js")" defer></script>
</head>
<body class="layout-@(((string?)ViewData["Design"] ?? brand.Layout).ToLowerInvariant())" data-text-show="@T("Show password")" data-text-hide="@T("Hide password")"
      data-text-caps="@T("Caps Lock is on")" data-text-last="@T("Last used")"
      data-text-passkey-failed="@T("The passkey did not work. Try again or use another way to sign in.")">
  @RenderBody()
</body>
</html>
