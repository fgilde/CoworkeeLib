@inject Coworkee.AuthServer.AuthBrandingProvider BrandingProvider
@{
  Layout = "_Layout";
  ViewData["Design"] = Coworkee.Contracts.Theming.SignInLayouts.Glass;
  var brand = await BrandingProvider.GetAsync(Context.RequestAborted);
}
@if (brand.Design.BackgroundUrl is null && brand.Design.MediaUrl is not null)
{
  @* without a page background the media lies behind the glass *@
  <div class="page-background" aria-hidden="true">
    <partial name="_Media" model="brand" />
  </div>
}
<main class="panel glass @(ViewData["Wide"] is true ? "wide" : null)" data-design="glass">
  <partial name="_Brand" model="brand" />
  @RenderBody()
</main>
