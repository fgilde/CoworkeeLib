<p>Bonjour {{ user.first_name }},</p>
<p>voici le rapport <a href="{{ report.link }}">{{ report.name }}</a> au {{ report.date }}.</p>
{{ for w in widgets }}<h3 style="margin:24px 0 8px 0;font-size:17px;">{{ w.title }}</h3>
{{ if w.error != "" }}<p style="color:#d32f2f;">{{ w.error }}</p>
{{ else if w.kpi }}<p style="margin:0;font-size:30px;font-weight:600;color:{{ w.color }};">{{ w.symbol }} {{ w.value }}</p>{{ if w.band != "" }}<p style="margin:2px 0 0 0;font-weight:600;color:{{ w.color }};">{{ w.band }}</p>{{ end }}
{{ else }}<table role="presentation" cellpadding="6" cellspacing="0" style="border-collapse:collapse;width:100%;font-size:14px;">
<tr>{{ for h in w.headers }}<th align="left" style="border-bottom:1px solid #16140f;">{{ h }}</th>{{ end }}</tr>
{{ for r in w.rows }}<tr>{{ for c in r }}<td style="border-bottom:1px solid #d6cfbf;">{{ c }}</td>{{ end }}</tr>
{{ end }}</table>{{ if w.more }}<p style="font-size:13px;color:#4a463d;">{{ if w.latest }}Seules les lignes les plus récentes sont affichées ; ouvrez le rapport pour les voir toutes.{{ else }}Seules les premières lignes sont affichées ; ouvrez le rapport pour les voir toutes.{{ end }}</p>{{ end }}
{{ end }}{{ end }}
{{ if attachment }}<p>Le fichier Excel joint contient les données de chaque widget.</p>{{ end }}
<p style="font-size:12px;color:#4a463d;">Vous recevez ce message parce que vous êtes abonné à ce rapport. <a href="{{ unsubscribe_link }}" style="color:#4a463d;">Mettre fin à l’abonnement</a></p>
