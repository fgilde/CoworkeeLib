<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f3efe6;font-family:Segoe UI,Helvetica,Arial,sans-serif;color:#16140f;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3efe6;padding:32px 0;">
    <tr><td align="center">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;background:#fbf9f4;border:1px solid #16140f;">
        <tr><td style="padding:28px 32px 8px 32px;font-family:Georgia,serif;font-size:26px;">{{ subject }}</td></tr>
        <tr><td style="padding:8px 32px 28px 32px;font-size:15px;line-height:1.6;">{{ content }}</td></tr>
        <tr><td style="padding:16px 32px;border-top:1px solid #d6cfbf;font-size:12px;color:#4a463d;">Diese Nachricht wurde automatisch versendet. Bitte nicht antworten.</td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
