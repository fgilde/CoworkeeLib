<div class="@($"cw-ai-msg {Message.Role}")" data-role="@Message.Role">
    @if (Message.Role == "user")
    {
        <div class="cw-ai-bubble">@Message.Text</div>
    }
    else
    {
        @if (Message.Text.Length > 0)
        {
            <div class="cw-ai-bubble" data-testid="assistant-answer">
                <MudMarkdown Value="@Message.Text" MarkdownPipeline="AssistantMarkdown.Pipeline" />
            </div>
        }
        @if (Streaming)
        {
            <span class="cw-ai-typing" aria-label="@L["The assistant is answering"]" data-testid="assistant-typing"><span></span><span></span><span></span></span>
        }
    }
    @if (Message.ToolCalls.Count > 0)
    {
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
            @foreach (var call in Message.ToolCalls)
            {
                <MudTooltip Text="@(call.Error ?? call.Input)">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(call.Succeeded ? Color.Success : Color.Error)" Href="@LinkOf(call)"
                             Icon="@(call.Succeeded ? Icons.Material.Outlined.Check : Icons.Material.Outlined.ErrorOutline)" data-tool="@call.Tool">@Humanize(call.Tool)</MudChip>
                </MudTooltip>
            }
        </MudStack>
    }
    @if (Message.Pending.Count > 0)
    {
        <div class="cw-ai-confirm" data-testid="assistant-confirm">
            <MudText Typo="Typo.body2" Class="mb-1"><b>@L[Message.Decision is null ? "Confirm to run:" : Message.Decision == AiDecisions.Approved ? "Confirmed:" : "Declined:"]</b></MudText>
            @foreach (var tool in Message.Pending)
            {
                <MudText Typo="Typo.body2" data-destructive="@(tool.Destructive ? "true" : "false")">
                    @if (tool.Destructive)
                    {
                        <MudIcon Icon="@Icons.Material.Outlined.WarningAmber" Color="Color.Error" Size="Size.Small" Style="vertical-align:middle" />
                    }
                    <code>@tool.Tool</code> <span style="overflow-wrap:anywhere">@tool.Input</span>
                </MudText>
            }
            @if (Waiting && Message.Decision is null)
            {
                <MudStack Row="true" Spacing="2" Class="mt-2">
                    <MudButton Variant="Variant.Filled" Color="@(Message.Pending.Any(t => t.Destructive) ? Color.Error : Color.Primary)" Size="Size.Small" StartIcon="@Icons.Material.Outlined.PlayArrow" OnClick="() => OnDecide.InvokeAsync(true)"
                               data-testid="assistant-approve">@L["Run"]</MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => OnDecide.InvokeAsync(false)" data-testid="assistant-decline">@L["Cancel"]</MudButton>
                </MudStack>
            }
        </div>
    }
</div>
