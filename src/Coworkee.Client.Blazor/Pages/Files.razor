@attribute [Authorize(Policy = PermissionPolicy.Prefix + Coworkee.Contracts.Files.FilePermissions.View)]
@using MudBlazor.Extensions.Components
@using MudBlazor.Extensions.Core.FileManager

<PageHeader Title="Files" Description="The organisation's drive: folders and files with permissions per folder. Double-click a file to preview it, drag files in to upload them." />
<MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2" Class="mb-2" data-testid="file-sharing">
    <MudText Typo="Typo.body2" Class="mud-text-secondary">@(Selected?.Name ?? L["Select a file to share it."])</MudText>
    @if (Selected is { IsPublic: true })
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.Public" data-testid="file-public-badge">@L["Public"]</MudChip>
    }
    <MudSpacer />
    @if (_manager.CanManage)
    {
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="Selected is null"
                   StartIcon="@(Selected?.IsPublic == true ? Icons.Material.Outlined.PublicOff : Icons.Material.Outlined.Public)"
                   OnClick="TogglePublicAsync" data-testid="file-toggle-public">@L[Selected?.IsPublic == true ? "Make private" : "Make public"]</MudButton>
    }
    <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="Selected is not { IsPublic: true }" StartIcon="@Icons.Material.Outlined.Link"
               OnClick="CopyLinkAsync" data-testid="file-copy-link">@L["Copy public link"]</MudButton>
    <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="Selected is null" StartIcon="@Icons.Material.Outlined.Timer"
               OnClick="CopyTemporaryLinkAsync" data-testid="file-copy-temporary-link">@L["Copy temporary link"]</MudButton>
</MudStack>
<MudExFileManager Manager="_manager" Panels="MudExFileManagerPanels.Tree | MudExFileManagerPanels.Files | MudExFileManagerPanels.Meta" Height="@("75vh")"
                  CurrentDirectoryChanged="Enter" OnFileOpened="PreviewAsync" SelectedNodesChanged="Select" data-testid="files">
    <FileItemTemplate Context="node">
        <span class="d-inline-flex align-center gap-1" style="min-width:0">
            <MudText Typo="Typo.body2" Class="mud-ex-file-grid-label">@node.Name</MudText>
            @if (node.Handle is Coworkee.Contracts.Files.StoredFileDto { IsPublic: true })
            {
                <MudTooltip Text="@L["Public"]"><MudIcon Icon="@Icons.Material.Outlined.Public" Size="Size.Small" Color="Color.Info" aria-label="@L["Public"]" data-testid="file-public-icon" /></MudTooltip>
            }
        </span>
    </FileItemTemplate>
</MudExFileManager>
