@attribute [Authorize]
@using Coworkee.Client.Blazor.Search
@using Coworkee.Contracts.Search

<PageTitle>@L["Search"]</PageTitle>
<MudText Typo="Typo.h4" Class="mb-3">@L["Search"]</MudText>
<MudTextField T="string" Value="_text" ValueChanged="TextChangedAsync" Immediate="true" DebounceInterval="300" Variant="Variant.Outlined" Margin="Margin.Dense"
              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Placeholder="@L["Search"]" AutoFocus="true" Clearable="true" data-testid="search-input" />
<MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="my-3" data-testid="search-types">
    <MudChip T="string" Color="@(Type is null ? Color.Primary : Color.Default)" OnClick="() => FilterAsync(null)" data-type="">@L["All"] (@_hits.Count)</MudChip>
    @foreach (var provider in _providers)
    {
        <MudChip T="string" Color="@(Type == provider.Name ? Color.Primary : Color.Default)" Icon="@SearchIcons.Resolve(provider.Icon)" OnClick="() => FilterAsync(provider.Name)"
                 data-type="@provider.Name">@L[provider.Group] (@_hits.Count(h => h.Provider == provider.Name))</MudChip>
    }
</MudStack>
@if (_streaming)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
}
@if (Shown.Count == 0 && !_streaming && _text.Length > 0)
{
    <MudAlert Severity="Severity.Info" Dense="true" data-testid="search-empty">@L["Nothing found."]</MudAlert>
}
@foreach (var group in Shown.GroupBy(h => h.Group).OrderByDescending(g => g.Max(h => h.Score)))
{
    <MudText Typo="Typo.overline" Class="mud-text-secondary d-block mt-3">@L[group.Key]</MudText>
    <MudPaper Outlined="true">
        <MudList T="string" Dense="true">
            @foreach (var hit in group.OrderByDescending(h => h.Score))
            {
                <MudListItem T="string" OnClick="() => Open(hit)" data-testid="search-hit" data-provider="@hit.Provider">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        @if (hit.Thumbnail is { } thumbnail)
                        {
                            <MudAvatar Size="Size.Small"><MudImage Src="@thumbnail" Alt="" /></MudAvatar>
                        }
                        else
                        {
                            <MudIcon Icon="@SearchIcons.Resolve(hit.Icon)" Size="Size.Small" Class="mud-text-secondary" />
                        }
                        <div style="min-width:0">
                            <MudText Typo="Typo.body1" Class="cw-palette-item">@Components.CoworkeeCommandPalette.Highlight(Components.CoworkeeCommandPalette.ToPaletteHit(hit))</MudText>
                            @if (hit.Subtitle is { Length: > 0 } subtitle)
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">@subtitle</MudText>
                            }
                        </div>
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    </MudPaper>
}
