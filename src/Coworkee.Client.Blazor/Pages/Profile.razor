@page "/profile"
@attribute [Authorize]

<PageTitle>My profile</PageTitle>
<MudText Typo="Typo.h4" Class="mb-4">My profile</MudText>

@if (_profile is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudGrid>
        <MudItem xs="12" md="7">
            <MudPaper Outlined="true" Class="pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-4">
                    <MudAvatar Color="Color.Primary" Size="Size.Large">@Initials</MudAvatar>
                    <div>
                        <MudText Typo="Typo.h6">@DisplayName</MudText>
                        <MudText Class="mud-text-secondary">@_profile.Email</MudText>
                    </div>
                </MudStack>
                <MudStack Row="true" Spacing="3">
                    <MudTextField @bind-Value="_firstName" Label="First name" Immediate="true" data-testid="profile-first" MaxLength="100" />
                    <MudTextField @bind-Value="_lastName" Label="Last name" Immediate="true" data-testid="profile-last" MaxLength="100" />
                </MudStack>
                <MudTextField @bind-Value="_phone" Label="Phone" InputType="InputType.Telephone" Immediate="true" data-testid="profile-phone" MaxLength="50" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="SaveAsync" Disabled="_busy" data-testid="save-profile">Save</MudButton>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="5">
            <MudPaper Outlined="true" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">Sign-in</MudText>
                <MudText Class="mud-text-secondary mb-4">Your address signs you in. Password and two-step verification are managed on the sign-in pages.</MudText>
                @if (_manage is not null)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Password" Href="@($"{_manage}/ChangePassword")" Target="_blank" Class="mr-2 mb-2">Change password</MudButton>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Security" Href="@($"{_manage}/TwoFactor")" Target="_blank" Class="mb-2">Two-step verification</MudButton>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}
