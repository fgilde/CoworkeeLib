@page "/profile"
@page "/profile/{Tab}"
@attribute [Authorize]

<PageHeader Title="Account" Description="Your picture and name show next to your messages, changes and documents for everyone in the organisation." />

@if (_ready)
{
    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-6" ActivePanelIndex="ActiveIndex" ActivePanelIndexChanged="Select" data-testid="profile-tabs">
        <MudTabPanel Text="@L["Profile"]" Icon="@Icons.Material.Outlined.Badge"><ProfileDetails /></MudTabPanel>
        <MudTabPanel Text="@L["Security"]" Icon="@Icons.Material.Outlined.Security"><ProfileSecurity /></MudTabPanel>
        <MudTabPanel Text="@L["Notifications"]" Icon="@Icons.Material.Outlined.Notifications"><Notifications Embedded="true" /></MudTabPanel>
        <MudTabPanel Text="@L["Settings"]" Icon="@Icons.Material.Outlined.Tune"><UserSettings Embedded="true" /></MudTabPanel>
        @foreach (var tab in _extra)
        {
            <MudTabPanel @key="tab.Key" Text="@L[tab.Title]" Icon="@tab.Icon"><DynamicComponent Type="tab.Component" /></MudTabPanel>
        }
    </MudTabs>
}
