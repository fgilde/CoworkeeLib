@attribute [Authorize]
@using Coworkee.Contracts.Notifications

<MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-4">
    @if (!Embedded)
    {
        <PageTitle>@L["Notifications"]</PageTitle>
        <MudText Typo="Typo.h4">@L["Notifications"]</MudText>
    }
    <MudSpacer />
    <MudSwitch T="bool" Value="_unreadOnly" ValueChanged="FilterAsync" Label="@L["Unread only"]" Color="Color.Primary" data-testid="unread-only" />
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.DoneAll" OnClick="MarkAllAsync" Disabled="@(Center.UnreadCount == 0)" data-testid="mark-all">@L["Mark all as read"]</MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.DeleteSweep" OnClick="DeleteAllAsync" Disabled="@(_page is not { TotalCount: > 0 })" data-testid="delete-all">@L["Delete all"]</MudButton>
</MudStack>
<MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-3" data-testid="notification-tabs">
    <MudTabPanel Text="@L["Inbox"]" Icon="@Icons.Material.Outlined.Inbox">
        <PushDevices />
        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2" Class="mb-3">
            <MudChipSet T="string" SelectedValue="_state" SelectedValueChanged="StateAsync" SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Color="Color.Primary"
                        Variant="Variant.Text" data-testid="notification-state">
                <MudChip Value="@("open")" data-testid="state-open">@L["To do"] (@(_counts?.Open ?? 0))</MudChip>
                <MudChip Value="@("done")" data-testid="state-done">@L["Done"]</MudChip>
                <MudChip Value="@("all")" data-testid="state-all">@L["All"]</MudChip>
            </MudChipSet>
            @if (_counts is { Categories.Count: > 0 } counts)
            {
                <MudChipSet T="string" SelectedValue="_category" SelectedValueChanged="CategoryAsync" SelectionMode="SelectionMode.ToggleSelection" CheckMark="false" Color="Color.Secondary"
                            Variant="Variant.Outlined" data-testid="notification-categories">
                    @foreach (var (category, count) in counts.Categories.OrderBy(c => c.Key))
                    {
                        <MudChip Value="category" data-category="@category">@L.Stored(category) (@count)</MudChip>
                    }
                </MudChipSet>
            }
            <MudSpacer />
            <MudTextField T="string" Value="_search" ValueChanged="SearchAsync" DebounceInterval="400" Placeholder="@L["Search"]" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Search" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:280px"
                          data-testid="notification-search" />
        </MudStack>
        @if (_page is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_page.Items.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">@(_unreadOnly ? L["Nothing unread."] : L["No notifications yet."])</MudAlert>
        }
        else
        {
            <MudPaper Outlined="true">
                <MudList T="string" Dense="true">
                    @foreach (var item in _page.Items)
                    {
                        <MudListItem T="string" data-notification="@item.Id" OnClick="() => Center.OpenAsync(item)" Icon="@(item.ReadAt is null ? Icons.Material.Filled.Circle : Icons.Material.Outlined.Circle)"
                                     IconColor="@(item.ReadAt is null ? Color.Primary : Color.Default)" IconSize="Size.Small">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.body1" Style="@(item.ReadAt is null ? "font-weight:600" : null)">@L.Server(item.Title, item.Arguments)</MudText>
                                    @if (item.Body is not null)
                                    {
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@L.Server(item.Body, item.Arguments)</MudText>
                                    }
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @item.CreatedAt.ToLocalTime().ToString("g")@(item.Category is { } category ? " · " + L.Stored(category) : string.Empty)
                                    </MudText>
                                </div>
                                <MudSpacer />
                                <span class="d-flex" @onclick:stopPropagation="true">
                                    <NotificationActions Item="item" />
                                </span>
                            </MudStack>
                        </MudListItem>
                        <MudDivider />
                    }
                </MudList>
            </MudPaper>
            @if (_page.TotalCount > PageSize)
            {
                <MudPagination Class="mt-4" Count="@((_page.TotalCount + PageSize - 1) / PageSize)" Selected="_number" SelectedChanged="PageAsync" />
            }
        }
    </MudTabPanel>
    <MudTabPanel Text="@L["Preferences"]" Icon="@Icons.Material.Outlined.Tune" data-testid="tab-preferences">
        <NotificationPreferencesEditor />
    </MudTabPanel>
    <MudTabPanel Text="@L["Following"]" Icon="@Icons.Material.Outlined.Bookmarks" data-testid="tab-following">
        <FollowedEntities />
    </MudTabPanel>
</MudTabs>
