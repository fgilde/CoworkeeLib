@page "/notifications"
@attribute [Authorize]
@using Coworkee.Contracts.Notifications

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    @if (!Embedded)
    {
        <PageTitle>Notifications</PageTitle>
        <MudText Typo="Typo.h4">Notifications</MudText>
    }
    <MudSpacer />
    <MudSwitch T="bool" Value="_unreadOnly" ValueChanged="FilterAsync" Label="Unread only" Color="Color.Primary" data-testid="unread-only" />
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.DoneAll" OnClick="MarkAllAsync" data-testid="mark-all">Mark all as read</MudButton>
</MudStack>

@if (_page is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_page.Items.Count == 0)
{
    <MudAlert Severity="Severity.Info">@(_unreadOnly ? "Nothing unread." : "No notifications yet.")</MudAlert>
}
else
{
    <MudPaper Outlined="true">
        <MudList T="string" Dense="false">
            @foreach (var item in _page.Items)
            {
                <MudListItem T="string" data-notification="@item.Id" OnClick="() => OpenAsync(item)" Icon="@(item.ReadAt is null ? Icons.Material.Filled.Circle : Icons.Material.Outlined.Circle)"
                             IconColor="@(item.ReadAt is null ? Color.Primary : Color.Default)" IconSize="Size.Small">
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <div>
                            <MudText Typo="Typo.body1" Style="@(item.ReadAt is null ? "font-weight:600" : null)">@L.Server(item.Title, item.Arguments)</MudText>
                            @if (item.Body is not null)
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">@L.Server(item.Body, item.Arguments)</MudText>
                            }
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@item.CreatedAt.ToLocalTime().ToString("g")</MudText>
                        </div>
                        <MudSpacer />
                        @if (item.ReadAt is null)
                        {
                            <MudIconButton Icon="@Icons.Material.Outlined.Done" Size="Size.Small" aria-label="Mark as read" data-testid="mark-read" OnClick="() => MarkAsync(item)" />
                        }
                    </MudStack>
                </MudListItem>
                <MudDivider />
            }
        </MudList>
    </MudPaper>
    @if (_page.TotalCount > PageSize)
    {
        <MudPagination Class="mt-4" Count="@((_page.TotalCount + PageSize - 1) / PageSize)" Selected="_number" SelectedChanged="PageAsync" />
    }
}
