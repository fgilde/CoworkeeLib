@attribute [Authorize(Policy = PermissionPolicy.Prefix + ChatPermissions.Use)]

<PageHeader Title="Chat" Description="Direct and group chats with the people of your organisation." />
<MudGrid Spacing="2">
    <MudItem xs="12" md="4">
        <MudPaper Outlined="true" Class="pa-2 d-flex flex-column" Style="height:70vh">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
                <MudTextField T="string" @bind-Value="_filter" Immediate="true" Placeholder="@L["Search"]" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTooltip Text="@L["Chat with…"]">
                    <MudIconButton Icon="@Icons.Material.Outlined.MapsUgc" OnClick="NewChatAsync" aria-label="@L["Chat with…"]" data-testid="chat-new" />
                </MudTooltip>
                <MudTooltip Text="@L["New group"]">
                    <MudIconButton Icon="@Icons.Material.Outlined.GroupAdd" OnClick="NewGroupAsync" aria-label="@L["New group"]" data-testid="chat-new-group" />
                </MudTooltip>
            </MudStack>
            <div style="flex:1;overflow:auto" data-testid="chat-contacts">
                @if (!Chats.Any())
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary pa-2">@L["No chats yet. Start one with a person or a group."]</MudText>
                }
                @foreach (var chat in Chats)
                {
                    <div class="@($"cw-chat-person d-flex align-center gap-2 pa-2 {(chat.Id == _chat?.Id ? "mud-selected-item mud-primary-hover" : null)}")" data-conversation="@chat.Id"
                         data-contact="@(chat.IsGroup ? null : Partner(chat))" @onclick="() => SelectAsync(chat)">
                        @if (!chat.IsGroup && Partner(chat) is { } partner)
                        {
                            <UserAvatar UserId="partner" Size="Size.Small" OfferChat="false" />
                        }
                        else
                        {
                            <MudAvatar Size="Size.Small" Color="Color.Primary"><MudIcon Icon="@Icons.Material.Outlined.Forum" Size="Size.Small" /></MudAvatar>
                        }
                        <div style="min-width:0;flex:1">
                            <MudText Typo="Typo.body2" Style="@(chat.Unread > 0 ? "font-weight:600" : null)">@chat.Name</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary cw-chat-ellipsis d-block">@chat.LastMessage</MudText>
                        </div>
                        @if (chat.Unread > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">@chat.Unread</MudChip>
                        }
                    </div>
                }
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="8">
        <MudPaper Outlined="true" Class="pa-3 d-flex flex-column" Style="height:70vh">
            @if (_chat is null)
            {
                <MudText Class="mud-text-secondary ma-auto">@L["Pick a chat or start a new one."]</MudText>
            }
            else
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                    <MudText Typo="Typo.h6" Class="cw-chat-ellipsis" data-testid="chat-title">@_chat.Name</MudText>
                    @if (_chat.IsGroup)
                    {
                        <MudAvatarGroup Max="5" Spacing="2" MaxSize="Size.Small" Class="ml-2">
                            @foreach (var member in _chat.Members)
                            {
                                <UserAvatar UserId="member.UserId" Size="Size.Small" ShowTooltip="true" />
                            }
                        </MudAvatarGroup>
                    }
                    <MudSpacer />
                    @if (_searching)
                    {
                        <MudTextField T="string" Value="_search" ValueChanged="SearchAsync" Placeholder="@L["Search in this chat"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      DebounceInterval="300" Immediate="true" AutoFocus="true" Style="max-width:220px" data-testid="chat-search" />
                    }
                    <MudIconButton Icon="@(_searching ? Icons.Material.Outlined.SearchOff : Icons.Material.Outlined.Search)" OnClick="ToggleSearch" aria-label="@L["Search in this chat"]" />
                    <MudIconButton Icon="@Icons.Material.Outlined.PictureInPictureAlt" OnClick="() => Dock.OpenAsync(_chat.Id)" aria-label="@L["Open as mini chat"]"
                                   title="@L["Open as mini chat"]" data-testid="chat-to-dock" />
                    @if (_chat.IsGroup)
                    {
                        <MudMenu Icon="@Icons.Material.Outlined.MoreVert" AriaLabel="@L["Group"]" data-testid="chat-group-menu">
                            <MudMenuItem Icon="@Icons.Material.Outlined.Edit" OnClick="RenameAsync">@L["Rename"]</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Outlined.PersonAdd" OnClick="AddMembersAsync" data-testid="chat-add-members">@L["Add people"]</MudMenuItem>
                            @if (IsOwner)
                            {
                                @foreach (var member in _chat.Members.Where(m => m.UserId != _me))
                                {
                                    <MudMenuItem Icon="@Icons.Material.Outlined.PersonRemove" OnClick="() => RemoveAsync(member)">@L["Remove {0}", member.Name]</MudMenuItem>
                                }
                            }
                            <MudMenuItem Icon="@Icons.Material.Outlined.Logout" OnClick="LeaveAsync" data-testid="chat-leave">@L["Leave group"]</MudMenuItem>
                        </MudMenu>
                    }
                </MudStack>
                <div style="flex:1;min-height:0">
                    <ChatThread @key="_chat.Id" ConversationId="_chat.Id" Search="@(_searching ? _search : null)" />
                </div>
            }
        </MudPaper>
    </MudItem>
</MudGrid>
