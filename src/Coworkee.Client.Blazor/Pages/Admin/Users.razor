@page "/admin/users"
@attribute [Authorize(Policy = PermissionPolicy.Prefix + IdentityPermissions.Users.View)]

<PageHeader Title="Users" Description="Accounts of this organisation, their roles and whether they may sign in." />
<RealtimeSubscription Topic="type:User" OnEvent="_ => _table.ReloadAsync()" />
<PermissionView Permission="@IdentityPermissions.Users.Manage">
    @if (_creating)
    {
        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <MudStack Row="true" Wrap="Wrap.Wrap">
                <MudTextField @bind-Value="_new.Email" Label="@L["Email"]" InputType="InputType.Email" Required="true" data-testid="new-user-email" />
                <MudTextField @bind-Value="_new.FirstName" Label="@L["First name"]" />
                <MudTextField @bind-Value="_new.LastName" Label="@L["Last name"]" />
                <MudTextField @bind-Value="_new.Password" Label="@L["Initial password"]" InputType="InputType.Password" Required="true" data-testid="new-user-password" />
            </MudStack>
            <MudStack Row="true" Class="mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAsync" data-testid="create-user">@L["Create"]</MudButton>
                <MudButton OnClick="() => _creating = false">@L["Cancel"]</MudButton>
            </MudStack>
        </MudPaper>
    }
</PermissionView>
@if (_permissionsOf is not null)
{
    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h6">@L["Effective permissions of {0}", _permissionsOf.Email]</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" aria-label="@L["Close"]" OnClick="() => _permissionsOf = null" />
        </MudStack>
        @if (_permissions.Count == 0)
        {
            <MudText Typo="Typo.body2">@L["No permissions."]</MudText>
        }
        @foreach (var permission in _permissions)
        {
            <MudChip T="string" Size="Size.Small">@permission</MudChip>
        }
    </MudPaper>
}
<CoworkeeDataTable @ref="_table" T="UserRow" EntitySet="Users" SearchFields="SearchFields" ExportFileName="users" OnLoaded="LoadRolesAsync"
                   CreateText="New user" CreatePermission="@IdentityPermissions.Users.Manage" OnCreate="() => _creating = true">
    <Columns>
        <PropertyColumn Property="u => u.Email" Title="@L["Email"]">
            <CellTemplate><MudLink Href="@($"/admin/users/{context.Item.Id}")" data-user="@context.Item.Email">@context.Item.Email</MudLink></CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="u => u.LastName" Title="@L["Name"]">
            <CellTemplate>@context.Item.Name</CellTemplate>
        </PropertyColumn>
        <TemplateColumn T="UserRow" Title="@L["Roles"]" Sortable="false">
            <CellTemplate>
                <PermissionView Permission="@IdentityPermissions.Users.Manage">
                    <ChildContent>
                        <MudSelect T="Guid" MultiSelection="true" Dense="true" SelectedValues="RolesOf(context.Item)" ToStringFunc="RoleName"
                                   SelectedValuesChanged="ids => SetRolesAsync(context.Item, ids)" data-testid="@($"roles-{context.Item.Email}")">
                            @foreach (var role in _roles)
                            {
                                <MudSelectItem T="Guid" Value="@role.Id">@role.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </ChildContent>
                    <NotAuthorized>@string.Join(", ", RolesOf(context.Item).Select(RoleName))</NotAuthorized>
                </PermissionView>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="u => u.IsActive" Title="@L["Active"]">
            <CellTemplate>
                <PermissionView Permission="@IdentityPermissions.Users.Manage">
                    <ChildContent><MudSwitch T="bool" Value="@context.Item.IsActive" ValueChanged="v => SetActiveAsync(context.Item, v)" Color="Color.Secondary" /></ChildContent>
                    <NotAuthorized>@L[context.Item.IsActive ? "yes" : "no"]</NotAuthorized>
                </PermissionView>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="u => u.LastLoginAt" Title="@L["Last sign-in"]" Format="g" />
        <TemplateColumn T="UserRow" Sortable="false" CellStyle="text-align:right;white-space:nowrap">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Outlined.Key" Size="Size.Small" aria-label="@L["Effective permissions"]" OnClick="() => ShowPermissionsAsync(context.Item)" />
                <PermissionView Permission="@IdentityPermissions.Users.Manage">
                    <MudIconButton Icon="@Icons.Material.Outlined.LockReset" Size="Size.Small" aria-label="@L["Send password reset"]" OnClick="() => SendResetAsync(context.Item)" />
                </PermissionView>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</CoworkeeDataTable>
