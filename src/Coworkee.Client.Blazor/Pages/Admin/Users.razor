@attribute [Authorize(Policy = PermissionPolicy.Prefix + IdentityPermissions.Users.View)]
@using Coworkee.Client.Blazor.Components.Users

<PageHeader Title="Users" Description="Accounts of this organisation, their roles and whether they may sign in." />
<RealtimeSubscription Topic="@Coworkee.Contracts.Realtime.RealtimeTopics.Type("Role")" OnEvent="_ => ReloadRolesAsync()" />
<CoworkeeDataTable @ref="_table" RealtimeTopic="type:User" T="UserRow" EntitySet="Users" SearchFields="SearchFields" ExportFileName="users" OnLoaded="LoadRolesAsync"
                   CreateText="New user" CreatePermission="@IdentityPermissions.Users.Manage" OnCreate="CreateAsync">
    <Columns>
        <PropertyColumn Property="u => u.Email" Title="@L["Email"]">
            <CellTemplate><MudLink Href="@Links.Href($"/admin/users/{context.Item.Id}")" data-user="@context.Item.Email">@context.Item.Email</MudLink></CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="u => u.LastName" Title="@L["Name"]">
            <CellTemplate>@context.Item.Name</CellTemplate>
        </PropertyColumn>
        <TemplateColumn T="UserRow" Title="@L["Roles"]" Sortable="false">
            <CellTemplate>
                @* changed one at a time through Roles… of the menu, so two administrators do not overwrite each other *@
                <span data-roles="@context.Item.Email">@string.Join(", ", RolesOf(context.Item))</span>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="u => u.IsActive" Title="@L["Active"]">
            <CellTemplate>
                @if (_canManage)
                {
                    <MudSwitch T="bool" Value="@context.Item.IsActive" ValueChanged="v => SetActiveAsync(context.Item, v)" Color="Color.Secondary" />
                }
                else
                {
                    @L[context.Item.IsActive ? "yes" : "no"]
                }
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="u => u.LastLoginAt" Title="@L["Last sign-in"]" Format="g" />
        <TemplateColumn T="UserRow" Sortable="false" CellStyle="text-align:right;white-space:nowrap">
            <CellTemplate>
                @{ var user = context.Item; }
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                         AriaLabel="@L["Actions"]" data-testid="@($"user-actions-{user.Email}")">
                    <MudMenuItem Icon="@Icons.Material.Outlined.Shield" OnClick="() => ShowRolesAsync(user)" data-testid="@($"user-roles-{user.Email}")">@L["Roles…"]</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Outlined.Groups" OnClick="() => ShowGroupsAsync(user)" data-testid="@($"user-groups-{user.Email}")">@L["Groups…"]</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Outlined.Key" OnClick="() => ShowPermissionsAsync(user)" data-testid="@($"user-permissions-{user.Email}")">@L["Permissions…"]</MudMenuItem>
                    @if (_canViewSessions)
                    {
                        <MudMenuItem Icon="@Icons.Material.Outlined.Devices" OnClick="() => ShowSessionsAsync(user)" data-testid="@($"user-sessions-{user.Email}")">@L["Sessions…"]</MudMenuItem>
                    }
                    @if (_canManage)
                    {
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Outlined.LockReset" OnClick="() => SendResetAsync(user)" data-testid="@($"reset-{user.Email}")">@L["Send password reset"]</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.Logout" OnClick="() => SignOutAsync(user)" data-testid="@($"sign-out-{user.Email}")">@L["Sign out everywhere"]</MudMenuItem>
                        @if (user.IsLocked)
                        {
                            <MudMenuItem Icon="@Icons.Material.Outlined.LockOpen" OnClick="() => UnlockAsync(user)" data-testid="@($"unlock-{user.Email}")">@L["Unlock"]</MudMenuItem>
                        }
                        else
                        {
                            <MudMenuItem Icon="@Icons.Material.Outlined.Lock" OnClick="() => LockAsync(user)" data-testid="@($"lock-{user.Email}")">@L["Lock"]</MudMenuItem>
                        }
                    }
                    @if (_canImpersonate && user.IsActive && !user.IsLocked && Impersonation.Offers(_user, user.Id))
                    {
                        <MudMenuItem Icon="@Icons.Material.Outlined.SupervisorAccount" OnClick="() => ImpersonateAsync(user)" data-testid="@($"impersonate-{user.Email}")">@L["Log in as"]</MudMenuItem>
                    }
                    @if (_canManage)
                    {
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Outlined.DeleteForever" IconColor="Color.Error" OnClick="() => DeleteAsync(user)" data-testid="@($"delete-{user.Email}")">@L["Delete user"]</MudMenuItem>
                    }
                </MudMenu>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</CoworkeeDataTable>
