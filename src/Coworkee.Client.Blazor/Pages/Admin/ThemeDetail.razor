@page "/admin/themes/{Id:guid}"
@attribute [Authorize(Policy = "perm:" + ThemePermissions.Manage)]
@using MudBlazor.Extensions.Components

<PageTitle>@(_theme?.Name ?? "Theme")</PageTitle>
@if (_theme is not null && _editing is not null)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudTextField @bind-Value="_name" Label="Name" Style="max-width:320px" />
        <MudSpacer />
        <MudButton Href="/admin/themes">Back</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Save</MudButton>
    </MudStack>

    <MudTabs Elevation="0" Outlined="true">
        <MudTabPanel Text="Colors and layout">
            <div class="pa-4">
                <MudExThemeEdit TTheme="MudTheme" Theme="_editing" ThemeChanged="OnThemeChanged" ShowSaveButton="false" ShowCancelButton="false" AllowImport="true" AllowExport="true" />
            </div>
        </MudTabPanel>
        <MudTabPanel Text="Logo and CSS">
            <div class="pa-4">
                <MudTextField @bind-Value="_logoSvg" Label="Logo (SVG markup)" Lines="6" Style="font-family:monospace" />
                <MudTextField @bind-Value="_customCss" Label="Custom CSS" Lines="10" Class="mt-3" Style="font-family:monospace" />
            </div>
        </MudTabPanel>
        <MudTabPanel Text="History">
            <div class="pa-4">
                <VersionHistory @ref="_history" Type="Theme" Id="Id" OnRestored="LoadAsync" />
                <MudText Typo="Typo.overline" Class="mt-4 d-block">Changes</MudText>
                <AuditTimeline @ref="_timeline" EntityType="ThemeDefinition" EntityId="@Id.ToString()" />
            </div>
        </MudTabPanel>
    </MudTabs>

    @if (_errors is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_errors</MudAlert>
    }
}
