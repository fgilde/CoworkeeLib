@attribute [Authorize(Policy = PermissionPolicy.Prefix + SettingsPermissions.Manage)]

<PageHeader Title="Services" Description="The services of the app and their state, checked every few seconds by the server.">
    <MudIconButton Icon="@Icons.Material.Outlined.Refresh" OnClick="RefreshAsync" Disabled="_busy" aria-label="@L["Refresh"]" data-testid="refresh-services" />
</PageHeader>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Dense="Density.Dense" Class="mb-4">@_error</MudAlert>
}
else if (_services is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_services.Count == 0 && _unavailable.Count == 0)
{
    <MudAlert Severity="Severity.Info" Dense="Density.Dense">@L["No services are configured (Coworkee:Services)."]</MudAlert>
}
else
{
    @foreach (var source in _unavailable)
    {
        <MudAlert Severity="Severity.Warning" Dense="Density.Dense" Class="mb-4" data-source-unavailable="@source">@L["{0} did not answer, its services are missing.", SourceName(source)]</MudAlert>
    }

    @foreach (var group in _services.GroupBy(s => s.Source).OrderBy(g => g.Key != "app").ThenBy(g => g.Key))
    {
        <section data-source="@group.Key">
            <MudText Typo="Typo.h5" Class="mb-2 mt-4">@SourceName(group.Key)</MudText>
            <MudGrid Spacing="3">
                @foreach (var service in group)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard Outlined="true" Class="@(Urls(service).Any() ? "cursor-pointer" : null)" Style="height:100%" data-service="@service.Name" @onclick="() => Open(service)">
                            <MudCardHeader>
                                <CardHeaderAvatar>
                                    <MudAvatar Color="Color.Primary" Variant="Variant.Outlined"><MudIcon Icon="@ServiceIcons.For(service.Name)" /></MudAvatar>
                                </CardHeaderAvatar>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h6">@service.Title</MudText>
                                </CardHeaderContent>
                                <CardHeaderActions>
                                    <MudChip T="string" Size="Size.Small" Color="@HealthColor(service.Health)" Variant="Variant.Text" data-health="@service.Health">@L[service.Health.ToString()]</MudChip>
                                </CardHeaderActions>
                            </MudCardHeader>
                            <MudCardContent Class="pt-0">
                                @foreach (var url in Urls(service))
                                {
                                    <MudLink Href="@url" Target="_blank" Typo="Typo.body2" Style="word-break:break-all;display:block" @onclick:stopPropagation="true">@url</MudLink>
                                }
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </section>
    }
}
