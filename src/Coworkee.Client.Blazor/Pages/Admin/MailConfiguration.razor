@page "/admin/mail-settings"
@attribute [Authorize(Policy = PermissionPolicy.Prefix + SettingsPermissions.Manage)]

<PageHeader Title="Mail settings" Description="How the application sends mail. Changes apply to the next mail, without a restart." />

@if (_form is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudStack Spacing="4" data-testid="mail-configuration">
        @if (_form.Tenant)
        {
            <MudPaper Outlined="true" Class="pa-4 d-flex align-center gap-3">
                <MudIcon Icon="@Icons.Material.Outlined.Dns" Color="Color.Primary" />
                <div class="flex-grow-1">
                    <MudText Typo="Typo.subtitle1">@L["Own mail server"]</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["On: this organisation sends with the settings below. Off: mails go through the system's server."]</MudText>
                </div>
                <MudSwitch T="bool" @bind-Value="_form.OwnServer" Color="Color.Primary" data-testid="mail-own-server" aria-label="@L["Own mail server"]" />
            </MudPaper>
        }

        @if (_form.Tenant && !_form.OwnServer)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" data-testid="mail-system-server">@L["Mails go through the system's server."]</MudAlert>
        }
        else
        {
            <div>
                <MudText Typo="Typo.overline" Class="mud-text-secondary">@L["Provider"]</MudText>
                <MudStack Row="true" Spacing="2" Class="flex-wrap" data-testid="mail-providers">
                    @foreach (var (id, name) in Providers)
                    {
                        var selected = id == _form.Provider;
                        <MudButton Variant="@(selected ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="() => SelectProvider(id)"
                                   aria-pressed="@(selected ? "true" : "false")" data-mail-provider="@id">@name</MudButton>
                    }
                </MudStack>
            </div>
        }

        @if (!_form.Tenant || _form.OwnServer)
        {
            <MudPaper Outlined="true" Class="pa-4" data-testid="mail-connection">
                <MudGrid Spacing="3">
                    @if (_form.Provider == MailProviders.Smtp)
                    {
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" @bind-Value="_form.Host" Label="@L["SMTP host"]" Variant="Variant.Outlined" Required="true" Clearable="true" data-testid="mail-host" />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudNumericField T="int?" @bind-Value="_form.Port" Label="@L["SMTP port"]" Variant="Variant.Outlined" Min="1" Max="65535" data-testid="mail-port" />
                        </MudItem>
                        <MudItem xs="12" md="3" Class="d-flex align-center">
                            <MudSwitch T="bool" @bind-Value="_form.UseSsl" Color="Color.Primary" Label="@L["Use SSL"]" data-testid="mail-ssl" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" @bind-Value="_form.UserName" Label="@L["SMTP user name"]" Variant="Variant.Outlined" Clearable="true" data-testid="mail-user" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <SecretField @key="_form" Label="@L["SMTP password"]" Stored="_form.KeepsPassword" @bind-Value="_form.NewPassword" Removed="() => _form.RemovePassword = true"
                                         Help="@SecretHelp(_form.RemovePassword)" TestId="mail-smtp-password" />
                        </MudItem>
                    }
                    else
                    {
                        <MudItem xs="12" md="@(_form.Provider == MailProviders.Mailgun ? 6 : 12)">
                            <SecretField @key="_form" Label="@L["API key"]" Stored="_form.KeepsApiKey" @bind-Value="_form.NewApiKey" Removed="() => _form.RemoveApiKey = true"
                                         Required="true" Help="@ApiKeyHelp" TestId="mail-key" />
                        </MudItem>
                    }
                    @if (_form.Provider == MailProviders.Mailgun)
                    {
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" @bind-Value="_form.MailgunDomain" Label="@L["Mailgun domain"]" Variant="Variant.Outlined" Required="true" Clearable="true" data-testid="mail-domain" />
                        </MudItem>
                        <MudItem xs="12" md="2">
                            <MudSelect T="string" @bind-Value="_form.MailgunRegion" Label="@L["Mailgun region"]" Variant="Variant.Outlined" ToStringFunc="@(r => r?.ToUpperInvariant())" data-testid="mail-region">
                                <MudSelectItem T="string" Value="@("us")">US</MudSelectItem>
                                <MudSelectItem T="string" Value="@("eu")">EU</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    }
                    <MudItem xs="12">
                        <MudTextField T="string" @bind-Value="_form.Sender" Label="@L["Sender address"]" Variant="Variant.Outlined" Placeholder="noreply@localhost" Clearable="true" data-testid="mail-from" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" @bind-Value="_form.Whitelist" Label="@L["Recipient whitelist"]" Variant="Variant.Outlined" Lines="4" Clearable="true"
                                      HelperText="@L["Leave empty to allow all recipients. One address or @domain per line."]" data-testid="mail-whitelist" />
                    </MudItem>
                </MudGrid>

                @if (_test is not null)
                {
                    <MudAlert Severity="@(_test.Success ? Severity.Success : Severity.Error)" Class="mt-4" data-testid="mail-test-result" data-succeeded="@(_test.Success ? "true" : "false")">
                        <MudText Typo="Typo.subtitle2">@L[_test.Success ? "The test mail was sent to your address." : "The test mail failed"]</MudText>
                        @if (_test.Error is { } error)
                        {
                            <MudText Typo="Typo.body2" Style="overflow-wrap:anywhere">@error</MudText>
                        }
                    </MudAlert>
                }
            </MudPaper>
        }

        <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
            <MudButton Variant="Variant.Text" OnClick="LoadAsync" Disabled="_busy" data-testid="mail-discard">@L["Discard changes"]</MudButton>
            @if (!_form.Tenant || _form.OwnServer)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Send" OnClick="TestAsync"
                           Disabled="@(_busy || !_form.CanTest)" data-testid="mail-test">
                    @if (_testing)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    @L["Send test mail"]
                </MudButton>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Save" OnClick="SaveAsync" Disabled="_busy" data-testid="mail-save">@L["Save"]</MudButton>
        </MudStack>
    </MudStack>
}
