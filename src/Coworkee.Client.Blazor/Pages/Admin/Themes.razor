@page "/admin/themes"
@attribute [Authorize(Policy = "perm:" + ThemePermissions.Manage)]

<PageTitle>Themes</PageTitle>
<RealtimeSubscription Topic="type:ThemeDefinition" OnEvent="_ => ReloadAsync()" />
<MudText Typo="Typo.h4" Class="mb-4">Themes</MudText>
<MudGrid>
    @foreach (var theme in _themes)
    {
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Outlined="true" Class="pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h6">@theme.Name</MudText>
                    <MudSpacer />
                    @if (theme.IsDefault)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary">default</MudChip>
                    }
                    @if (theme.IsGlobal)
                    {
                        <MudChip T="string" Size="Size.Small">built-in</MudChip>
                    }
                </MudStack>
                <MudStack Row="true" Spacing="1" Class="my-3">
                    @foreach (var color in Swatches(theme))
                    {
                        <div style="width:28px;height:28px;border:1px solid var(--mud-palette-lines-default);background:@color" title="@color"></div>
                    }
                </MudStack>
                <MudStack Row="true">
                    <MudButton Size="Size.Small" OnClick="() => ThemeService.Apply(theme)">Try</MudButton>
                    <MudButton Size="Size.Small" Disabled="theme.IsDefault" OnClick="() => SetDefaultAsync(theme)">Make default</MudButton>
                    @if (theme.IsGlobal)
                    {
                        <MudButton Size="Size.Small" OnClick="() => CopyAsync(theme)">Copy</MudButton>
                    }
                    else
                    {
                        <MudButton Size="Size.Small" Href="@($"/admin/themes/{theme.Id}")">Edit</MudButton>
                        <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(theme)">Delete</MudButton>
                    }
                </MudStack>
            </MudPaper>
        </MudItem>
    }
</MudGrid>
