@page "/admin/themes"
@attribute [Authorize(Policy = "perm:" + ThemePermissions.Manage)]

<PageHeader Title="Themes" Description="Colors, fonts, radius, shadows, density, navigation and logo. Everyone can choose the published themes. Built-in themes stay as they are: saving one creates a copy.">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="CreateAsync" data-testid="theme-new">@L["New theme"]</MudButton>
</PageHeader>
<RealtimeSubscription Topic="type:ThemeDefinition" OnEvent="_ => ReloadAsync()" />

@if (_tiles is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudGrid Spacing="3" data-testid="themes">
        @foreach (var (dto, theme) in _tiles)
        {
            <MudItem xs="12" sm="6" md="4" xl="3">
                <MudCard Outlined="true" Class="d-flex flex-column" Style="height:100%" data-testid="theme-tile" data-theme="@dto.Name">
                    <div class="d-flex" style="height:88px;border-bottom:1px solid var(--mud-palette-lines-default)">
                        @foreach (var palette in new Palette[] { theme.PaletteLight, theme.PaletteDark })
                        {
                            <div class="flex-grow-1" style="background:@Hex(palette.Background)">
                                <div style="height:18px;background:@Hex(palette.AppbarBackground)"></div>
                                <div class="d-flex gap-2 pa-3">
                                    @foreach (var color in new[] { palette.Primary, palette.Secondary, palette.Surface })
                                    {
                                        <span style="width:22px;height:22px;border-radius:50%;border:1px solid var(--mud-palette-lines-default);background:@Hex(color)" title="@Hex(color)"></span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <MudCardContent Class="flex-grow-1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudText Typo="Typo.h6" Class="text-truncate">@dto.Name</MudText>
                            <MudSpacer />
                            @if (dto.IsDefault)
                            {
                                <MudTooltip Text="@L["Default theme"]">
                                    <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Size="Size.Small" data-testid="theme-is-default" />
                                </MudTooltip>
                            }
                        </MudStack>
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-1">
                            <MudChip T="string" Size="Density.Size" Variant="Variant.Outlined" Color="@(dto.IsPublished ? Color.Success : Color.Default)"
                                     Icon="@(dto.IsPublished ? Icons.Material.Outlined.Visibility : Icons.Material.Outlined.VisibilityOff)" data-testid="theme-published">
                                @L[dto.IsPublished ? "Published" : "Not published"]
                            </MudChip>
                            @if (dto.IsGlobal)
                            {
                                <MudChip T="string" Size="Density.Size" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.Lock">@L["built-in"]</MudChip>
                            }
                        </MudStack>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Outlined.Edit" OnClick="() => EditAsync(dto)" data-testid="theme-edit">@L["Edit"]</MudButton>
                        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Outlined.Star" Disabled="dto.IsDefault" OnClick="() => SetDefaultAsync(dto)"
                                   data-testid="theme-default">@L["Make default"]</MudButton>
                        <MudSpacer />
                        @if (!dto.IsGlobal)
                        {
                            <MudIconButton Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Outlined.Delete" aria-label="@L["Delete"]"
                                           OnClick="() => DeleteAsync(dto)" data-testid="theme-delete" />
                        }
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}
