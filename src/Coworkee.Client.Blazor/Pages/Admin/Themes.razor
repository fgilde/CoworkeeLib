@page "/admin/themes"
@attribute [Authorize(Policy = "perm:" + ThemePermissions.Manage)]
@using MudBlazor.Extensions.Components
@using Coworkee.Client.Blazor.Theming

<PageHeader Title="Themes" Description="Create, change and delete themes; colors, fonts, radius, shadows, navigation and logo. Everyone can choose the published ones. Built-in themes stay as they are: saving one creates a copy.">
    @if (_selected is { } selected)
    {
        @if (selected.IsGlobal)
        {
            <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Outlined.Lock">@L["built-in"]</MudChip>
        }
        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Star" Disabled="selected.IsDefault" OnClick="SetDefaultAsync"
                   data-testid="theme-default">@L[selected.IsDefault ? "Default theme" : "Make default"]</MudButton>
    }
</PageHeader>

@if (_presets is not null)
{
    <MudExThemeEdit @key="_version" TTheme="CoworkeeTheme" Presets="_presets" Theme="_theme" AllowPresetsEdit="true" AllowModeToggle="true"
                    ShowSaveButton="true" ShowCancelButton="true" AutoSaveRestoreState="false" CanDelete="CanDelete"
                    ThemeCreated="CreateAsync" ThemeDeleted="DeleteAsync" ThemeSaved="SaveAsync" ThemeChanged="Preview" EditCanceled="CancelAsync"
                    data-testid="theme-edit" />
}
else
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
