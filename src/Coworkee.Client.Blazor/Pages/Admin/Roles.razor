@page "/admin/roles"
@attribute [Authorize(Policy = PermissionPolicy.Prefix + IdentityPermissions.Roles.View)]

<PageHeader Title="Roles" Description="Roles bundle permissions; users and groups get roles." />
<RealtimeSubscription Topic="type:Role" OnEvent="_ => _table.ReloadAsync()" />
<CoworkeeDataTable @ref="_table" T="RoleDto" EntitySet="Roles" SearchFields="SearchFields" ExportFileName="roles" DescribeItem="r => r.Name"
                   CreateText="New role" CreatePermission="@IdentityPermissions.Roles.Manage" DeletePermission="@IdentityPermissions.Roles.Manage"
                   OnCreate="CreateAsync" OnDelete="DeleteAsync">
    <Columns>
        <PropertyColumn Property="r => r.Name" Title="@L["Name"]">
            <CellTemplate>
                <MudLink Href="@($"/admin/roles/{context.Item.Id}")">@context.Item.Name</MudLink>
                @if (context.Item.IsSystem)
                {
                    <MudChip T="string" Size="Size.Small">@L["system"]</MudChip>
                }
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="r => r.Description" Title="@L["Description"]" />
    </Columns>
</CoworkeeDataTable>
