@attribute [Authorize(Policy = "perm:" + SettingsPermissions.Manage)]

<PageHeader Title="Settings" />
<StickyMergeTabs>
    <MudTabs Elevation="0" Outlined="true">
        @if (_system)
        {
            @foreach (var registration in Sections)
            {
                <MudTabPanel Text="@L[registration.Title]">
                    <div data-section="@registration.Section"><DynamicComponent Type="@typeof(AppConfigurationEditor<>).MakeGenericType(registration.Type)"
                                      Parameters="@(new Dictionary<string, object> { ["Registration"] = registration })" /></div>
                </MudTabPanel>
            }
            <MudTabPanel Text="@L["System"]">
                <SettingsForm Scope="SettingScope.Global" />
            </MudTabPanel>
        }
        <MudTabPanel Text="@L["Organisation"]">
            <SettingsForm Scope="SettingScope.Tenant" />
        </MudTabPanel>
    </MudTabs>
</StickyMergeTabs>
