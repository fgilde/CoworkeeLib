@attribute [Authorize(Policy = PermissionPolicy.Prefix + AuditPermissions.View)]

<PageHeader Title="Audit log" Description="Every change, field by field, with who made it. Open a row to see what changed." />
<CoworkeeDataTable @ref="_table" T="AuditEntryDto" EntitySet="AuditEntries" SearchFields="SearchFields" Filter="@Filter" ExportFileName="audit" NoRecordsText="No changes in this period.">
    <ToolBarContent>
        <MudSwitch T="bool" Value="_mine" ValueChanged="MineAsync" Label="@L["Only my changes"]" Color="Color.Primary" Class="mb-2" data-testid="audit-mine" />
        <MudDateRangePicker DateRange="_range" DateRangeChanged="RangeAsync" Label="@L["Period"]" Clearable="true" Variant="Variant.Outlined" Margin="Density.Margin"
                            Class="mb-2 mr-2" Style="max-width:260px" data-testid="audit-period" />
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="e => e.OccurredAt" Title="@L["When"]">
            <CellTemplate>
                <MudTooltip Text="@Utc(context.Item.OccurredAt)">
                    <MudText Typo="Typo.body2" Style="white-space:nowrap">@context.Item.OccurredAt.ToLocalTime().ToString("g")</MudText>
                </MudTooltip>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="e => e.Action" Title="@L["Action"]">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="ActionColor(context.Item.Action)" Icon="@ActionIcon(context.Item.Action)">@L[context.Item.Action]</MudChip>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="e => e.EntityType" Title="@L["Entity"]">
            <CellTemplate>@context.Item.EntityType <MudText Typo="Typo.caption" Inline="true" Class="mud-text-secondary">@context.Item.EntityId</MudText></CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="e => e.ActorId" Title="@L["Who"]">
            <CellTemplate>
                @if (context.Item.ActorId is { } actor)
                {
                    <UserCard UserId="actor" />
                }
                else
                {
                    @L["system"]
                }
            </CellTemplate>
        </PropertyColumn>
        <TemplateColumn T="AuditEntryDto" Title="@L["Changes"]" Sortable="false">
            <CellTemplate>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@Summary(context.Item)</MudText>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <ChildRowContent>
        @if (Record(context.Item) is { } record)
        {
            <div class="d-flex flex-wrap px-4 pb-2" style="gap:8px" data-testid="audit-history-actions">
                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.History"
                           OnClick="() => OpenHistoryAsync(context.Item, record.Id)" data-testid="audit-open-history">@L["Open record history"]</MudButton>
                @if (record.Set.CanRestore && context.Item.Action == "Deleted")
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.RestoreFromTrash"
                               OnClick="() => RestoreAsync(context.Item, record, EntityHistoryRestoreMode.Before)" data-testid="audit-restore-record">@L["Restore record"]</MudButton>
                }
                else if (record.Set.CanRestore && context.Item.Action != "Created")
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Undo"
                               OnClick="() => RestoreAsync(context.Item, record, EntityHistoryRestoreMode.Undo)" data-testid="audit-undo">@L["Undo this change"]</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.SettingsBackupRestore"
                               OnClick="() => RestoreAsync(context.Item, record, EntityHistoryRestoreMode.Before)" data-testid="audit-restore-before">@L["Restore the state before this change"]</MudButton>
                }
            </div>
        }
        @if (context.Item.Changes.Count > 0)
        {
            <div class="px-4"><AuditChanges Changes="context.Item.Changes" /></div>
        }
        else
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary px-4">@L["No field changes recorded."]</MudText>
        }
    </ChildRowContent>
</CoworkeeDataTable>
