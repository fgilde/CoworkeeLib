@page "/admin/audit"
@attribute [Authorize(Policy = PermissionPolicy.Prefix + AuditPermissions.View)]

<PageHeader Title="Audit log" Description="Every change, field by field, with who made it." />
<CoworkeeDataTable T="AuditEntryDto" EntitySet="AuditEntries" SearchFields="SearchFields" ExportFileName="audit">
    <Columns>
        <PropertyColumn Property="e => e.OccurredAt" Title="@L["When"]" Format="g" />
        <PropertyColumn Property="e => e.Action" Title="@L["Action"]">
            <CellTemplate>@L[context.Item.Action]</CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="e => e.EntityType" Title="@L["Entity"]">
            <CellTemplate>@context.Item.EntityType <MudText Typo="Typo.caption" Inline="true">@context.Item.EntityId</MudText></CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="e => e.ActorId" Title="@L["Who"]">
            <CellTemplate>
                @if (context.Item.ActorId is { } actor)
                {
                    <UserCard UserId="actor" />
                }
                else
                {
                    @L["system"]
                }
            </CellTemplate>
        </PropertyColumn>
        <TemplateColumn T="AuditEntryDto" Title="@L["Changes"]" Sortable="false">
            <CellTemplate>
                <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="context.Item.Changes.Count == 0" OnClick="() => ShowChangesAsync(context.Item)">
                    @context.Item.Changes.Count
                </MudButton>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</CoworkeeDataTable>
