@page "/admin/groups"
@attribute [Authorize(Policy = PermissionPolicy.Prefix + IdentityPermissions.Groups.View)]

<PageHeader Title="Groups" Description="Groups give their members roles together." />
<RealtimeSubscription Topic="type:UserGroup" OnEvent="_ => _table.ReloadAsync()" />
<CoworkeeDataTable @ref="_table" T="GroupRow" EntitySet="Groups" SearchFields="SearchFields" Exportable="false" DescribeItem="g => g.Name"
                   CreateText="New group" CreatePermission="@IdentityPermissions.Groups.Manage" DeletePermission="@IdentityPermissions.Groups.Manage"
                   OnCreate="CreateAsync" OnDelete="DeleteAsync">
    <Columns>
        <PropertyColumn Property="g => g.Name" Title="@L["Name"]" />
        <TemplateColumn T="GroupRow" Title="@L["Members"]" Sortable="false">
            <CellTemplate>
                <MudSelect Margin="Density.Margin" T="Guid" MultiSelection="true" Dense="Density.Dense" SelectedValues="context.Item.Members.Select(m => m.UserId).ToArray()" ToStringFunc="UserName"
                           Disabled="!_canManage" SelectedValuesChanged="ids => SetMembersAsync(context.Item, ids)">
                    @foreach (var user in _users)
                    {
                        <MudSelectItem T="Guid" Value="@user.Id">@user.Email</MudSelectItem>
                    }
                </MudSelect>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="GroupRow" Title="@L["Roles"]" Sortable="false">
            <CellTemplate>
                <MudSelect Margin="Density.Margin" T="Guid" MultiSelection="true" Dense="Density.Dense" SelectedValues="context.Item.Roles.Select(r => r.RoleId).ToArray()" ToStringFunc="RoleName"
                           Disabled="!_canManage" SelectedValuesChanged="ids => SetRolesAsync(context.Item, ids)">
                    @foreach (var role in _roles.Where(r => !r.IsSystem))
                    {
                        <MudSelectItem T="Guid" Value="@role.Id">@role.Name</MudSelectItem>
                    }
                </MudSelect>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</CoworkeeDataTable>
