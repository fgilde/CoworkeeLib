@attribute [Authorize(Policy = PermissionPolicy.Prefix + IdentityPermissions.Groups.View)]
@using Coworkee.Client.Blazor.Components.Groups

<PageHeader Title="Groups" Description="Groups give their members roles together." />
<RealtimeSubscription Topic="@Coworkee.Contracts.Realtime.RealtimeTopics.Type("UserGroup")" OnEvent="_ => RefreshAsync()" />
<MudGrid Spacing="3">
    <MudItem xs="12" md="4">
        <MudPaper Outlined="true" Class="pa-3">
            <div class="d-flex flex-wrap align-center gap-1 mb-2">
                @if (_canManage)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Add" OnClick="CreateRootAsync" data-testid="new-root-group">@L["New root group"]</MudButton>
                    <MudTooltip Text="@L["Import"]">
                        <MudIconButton Icon="@Icons.Material.Outlined.FileUpload" Size="Size.Small" aria-label="@L["Import"]" OnClick="ImportAsync" data-testid="groups-import" />
                    </MudTooltip>
                }
                <MudTooltip Text="@L["Export"]">
                    <MudIconButton Icon="@Icons.Material.Outlined.FileDownload" Size="Size.Small" aria-label="@L["Export"]" OnClick="ExportAsync" data-testid="groups-export" />
                </MudTooltip>
            </div>
            @if (_ready)
            {
                <GroupTree @ref="_tree" SelectedId="_group?.Id" SelectedChanged="SelectAsync" RevealCode="@_group?.Code">
                    <NodeActions Context="node">
                        @if (_canManage)
                        {
                            <GroupNodeMenu Node="node" Changed="NodeChangedAsync" Deleted="DeletedAsync" />
                        }
                    </NodeActions>
                </GroupTree>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="8">
        @if (_group is { } group)
        {
            <MudPaper Outlined="true" Class="pa-4">
                <MudText Typo="Typo.h6" data-testid="group-title">@group.Name</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@GroupPaths.Path(group.Code, group.Name, _ancestors)</MudText>
                <MudTabs @key="group.Id" Elevation="0" TabPanelsClass="pt-2" data-testid="group-tabs">
                    <MudTabPanel Text="@L["General"]">
                        <GroupGeneralTab Group="group" Parent="ParentPath" CanManage="_canManage" Changed="ChangedAsync" />
                    </MudTabPanel>
                    <MudTabPanel Text="@L["Members"]">
                        <GroupMembersTab Group="group" CanManage="_canManageMembers" Changed="ChangedAsync" />
                    </MudTabPanel>
                    <MudTabPanel Text="@L["Roles"]">
                        <GroupRolesTab Group="group" CanManage="_canManage" Changed="ChangedAsync" />
                    </MudTabPanel>
                    @foreach (var tab in _appTabs)
                    {
                        <MudTabPanel Text="@L[tab.Title]">
                            <DynamicComponent Type="tab.Component" Parameters="@(new Dictionary<string, object> { ["GroupId"] = group.Id })" />
                        </MudTabPanel>
                    }
                </MudTabs>
            </MudPaper>
        }
        else
        {
            <MudText Class="mud-text-secondary pa-4" data-testid="group-empty">@L[_notFound ? "Group not found." : "Choose a group in the tree."]</MudText>
        }
    </MudItem>
</MudGrid>
