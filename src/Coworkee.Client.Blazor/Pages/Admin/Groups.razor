@attribute [Authorize(Policy = PermissionPolicy.Prefix + IdentityPermissions.Groups.View)]
@using Coworkee.Client.Blazor.Components.Groups

<PageHeader Title="Groups" Description="Groups give their members roles together." />
<RealtimeSubscription Topic="@Coworkee.Contracts.Realtime.RealtimeTopics.Type("UserGroup")" OnEvent="_ => RefreshAsync()" />
@if (_canManageDataFilters)
{
    <RealtimeSubscription Topic="@DataFilterTopics.TenantChanged" OnEvent="_ => FiltersChangedAsync()" />
}
<MudGrid Spacing="3">
    <MudItem xs="12" md="4">
        <MudPaper Outlined="true" Class="pa-3">
            <div class="d-flex flex-wrap align-center gap-1 mb-2">
                @if (_canManage)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Add" OnClick="CreateRootAsync" data-testid="new-root-group">@L["New root group"]</MudButton>
                    <MudTooltip Text="@L["Import"]">
                        <MudIconButton Icon="@Icons.Material.Outlined.FileUpload" Size="Size.Small" aria-label="@L["Import"]" OnClick="ImportAsync" data-testid="groups-import" />
                    </MudTooltip>
                }
                <MudTooltip Text="@L["Export"]">
                    <MudIconButton Icon="@Icons.Material.Outlined.FileDownload" Size="Size.Small" aria-label="@L["Export"]" OnClick="ExportAsync" data-testid="groups-export" />
                </MudTooltip>
            </div>
            @if (_canManageDataFilters)
            {
                <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Outlined.FilterAlt" Variant="@(_onlyFiltered ? Variant.Filled : Variant.Outlined)" Color="@(_onlyFiltered ? Color.Primary : Color.Default)"
                         OnClick="ToggleOnlyFilteredAsync" Class="mb-2" data-testid="chip-filtered">@L["With data filters only"]</MudChip>
            }
            @if (_ready)
            {
                @* a flat list (names are the paths) while the chip is on, the tree otherwise: another tree instance each *@
                <GroupTree @key="_onlyFiltered" @ref="_tree" Nodes="_filtered" SelectedId="_group?.Id" SelectedChanged="SelectAsync" RevealCode="@_group?.Code" ListStyle="max-height:calc(100vh - 300px);overflow:auto">
                    <NodeActions Context="node">
                        @if (_canManageDataFilters && _counts.GetValueOrDefault(node.Id) is > 0 and var count)
                        {
                            <MudTooltip Text="@L["Data filters"]">
                                <MudBadge Content="count" Color="Color.Primary" Overlap="true" Origin="Origin.TopRight">
                                    <MudIconButton Icon="@Icons.Material.Outlined.FilterAlt" Size="Size.Small" Color="Color.Primary" aria-label="@L["Data filters"]"
                                                   OnClick="() => ShowAsync(node.Id, DataFiltersTab)" data-testid="@($"group-filters-{node.Id}")" />
                                </MudBadge>
                            </MudTooltip>
                        }
                        @if (_canManage)
                        {
                            <GroupNodeMenu Node="node" Changed="NodeChangedAsync" Deleted="DeletedAsync" />
                        }
                    </NodeActions>
                </GroupTree>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="8">
        <MudProgressLinear Indeterminate="true" Size="Size.Small" Color="Color.Primary" Class="@(_loadingGroup ? "mb-1" : "mb-1 invisible")" data-testid="group-loading" />
        @if (_group is { } group)
        {
            <MudPaper Outlined="true" Class="pa-4">
                <div class="d-flex align-center gap-2">
                    <MudText Typo="Typo.h6" data-testid="group-title">@group.Name</MudText>
                    @if (group.IsDefault)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" data-testid="group-default">@L["Default group"]</MudChip>
                    }
                </div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@GroupPaths.Path(group.Code, group.Name, _ancestors)</MudText>
                <MudTabs @key="group.Id" @bind-ActivePanelIndex="_tabIndex" Elevation="0" TabPanelsClass="pt-2" data-testid="group-tabs">
                    <MudTabPanel Text="@L["General"]">
                        <GroupGeneralTab Group="group" Parent="ParentPath" CanManage="_canManage" Changed="ChangedAsync" />
                    </MudTabPanel>
                    <MudTabPanel Text="@L["Members"]">
                        <GroupMembersTab Group="group" CanManage="_canManageMembers" Changed="ChangedAsync" />
                    </MudTabPanel>
                    <MudTabPanel Text="@L["Roles"]">
                        <GroupRolesTab Group="group" CanManage="_canManage" Changed="ChangedAsync" />
                    </MudTabPanel>
                    @if (_canManageDataFilters)
                    {
                        <MudTabPanel Text="@L["Data filters"]">
                            <DataFilterList Layer="DataFilterLayer.Group" LayerKey="group.Id" />
                        </MudTabPanel>
                    }
                    @foreach (var tab in _appTabs)
                    {
                        <MudTabPanel Text="@L[tab.Title]">
                            <DynamicComponent Type="tab.Component" Parameters="@(new Dictionary<string, object> { ["GroupId"] = group.Id })" />
                        </MudTabPanel>
                    }
                </MudTabs>
            </MudPaper>
        }
        else
        {
            <MudText Class="mud-text-secondary pa-4" data-testid="group-empty">@L[_notFound ? "Group not found." : "Choose a group in the tree."]</MudText>
        }
    </MudItem>
</MudGrid>
