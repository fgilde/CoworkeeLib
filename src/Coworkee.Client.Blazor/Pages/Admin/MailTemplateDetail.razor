@page "/admin/mail/templates/{Name}/{Culture}"
@attribute [Authorize(Policy = "perm:" + MailPermissions.Templates.Manage)]

<PageTitle>@Name</PageTitle>
<MudBreadcrumbs Items="_breadcrumbs" />
<MudText Typo="Typo.h4" Class="mb-4">@Name <MudText Typo="Typo.body1" Inline="true">(@Culture)</MudText></MudText>
<MailTemplateEditor Name="@Name" Culture="@Culture" />

@code {
    private List<BreadcrumbItem> _breadcrumbs = [];

    [Parameter] public string Name { get; set; } = string.Empty;

    [Parameter] public string Culture { get; set; } = string.Empty;

    protected override void OnParametersSet() =>
        _breadcrumbs = [new BreadcrumbItem("Mail templates", "/admin/mail/templates"), new BreadcrumbItem(Name, null, disabled: true)];
}
