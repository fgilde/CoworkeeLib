@page "/admin/mail/log"
@attribute [Authorize(Policy = PermissionPolicy.Prefix + MailPermissions.Log.View)]

<PageHeader Title="Mail log" Description="Mails the application queued and whether they went out." />
<CoworkeeDataTable T="OutgoingMailDto" EntitySet="Mails" SearchFields="SearchFields" ExportFileName="mails">
    <Columns>
        <PropertyColumn Property="m => m.QueuedAt" Title="@L["Queued"]" Format="g" />
        <PropertyColumn Property="m => m.To" Title="@L["To"]" />
        <PropertyColumn Property="m => m.Subject" Title="@L["Subject"]" />
        <PropertyColumn Property="m => m.TemplateName" Title="@L["Template"]" />
        <PropertyColumn Property="m => m.Status" Title="@L["Status"]">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@ColorFor(context.Item.Status)">@L[context.Item.Status.ToString()]</MudChip>
                @if (context.Item.LastError is { } error)
                {
                    <MudTooltip Text="@error"><MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" /></MudTooltip>
                }
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="m => m.Attempts" Title="@L["Attempts"]" />
    </Columns>
</CoworkeeDataTable>
