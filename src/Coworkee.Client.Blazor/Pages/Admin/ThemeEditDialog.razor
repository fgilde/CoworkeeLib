@using MudBlazor.Extensions.Components
@typeparam TTheme where TTheme : CoworkeeTheme

<MudDialog Class="@MudBlazor.Extensions.Helper.MudExCss.Classes.Dialog.Initial" data-testid="theme-dialog">
    <DialogContent>
        <MudTextField T="string" @bind-Value="Name" Label="@L["Name"]" Required="true" MaxLength="100" Margin="Density.Margin" Variant="Variant.Outlined"
                      Class="mb-3" data-testid="theme-name" />
        <div data-testid="theme-editor">
            <MudExThemeEdit TTheme="TTheme" Theme="(TTheme)Theme" Presets="_presets" PropertiesForSimpleMode="SimpleMode" AllowPresetsEdit="false" AllowModeToggle="true"
                            ShowSaveButton="true" ShowCancelButton="true" AutoSaveRestoreState="false" ThemeChanged="ThemeService.Preview" ThemeSaved="SaveAsync"
                            EditCanceled="Cancel" />
        </div>
    </DialogContent>
</MudDialog>
