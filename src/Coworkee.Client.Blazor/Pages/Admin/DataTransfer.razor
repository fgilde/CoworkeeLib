@attribute [Authorize(Policy = PermissionPolicy.Prefix + DataTransferPermissions.Use)]

<PageHeader Title="Import and export" Description="Bring rows in from CSV, Excel or JSON files and take them out again. Every row runs through the same checks as a form." />
<MudGrid Spacing="2" Class="mb-4">
    @foreach (var target in _targets)
    {
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Outlined="true" Class="pa-3 d-flex align-center gap-2" data-testid="@($"transfer-set-{target.EntitySet}")">
                <MudIcon Icon="@Icons.Material.Outlined.TableChart" Color="Color.Primary" />
                <MudText Class="flex-grow-1">@L[target.EntitySet]</MudText>
                <MudIconButton Icon="@Icons.Material.Outlined.FileUpload" Size="Size.Small" aria-label="@L["Import"]" OnClick="() => ImportAsync(target)" />
                <MudMenu Icon="@Icons.Material.Outlined.FileDownload" Size="Size.Small" Dense="Density.Dense" aria-label="@L["Export"]">
                    @foreach (var format in Enum.GetValues<ExportFileFormat>())
                    {
                        <MudMenuItem OnClick="() => ExportAsync(target, format)">@format.ToString().ToUpperInvariant()</MudMenuItem>
                    }
                </MudMenu>
            </MudPaper>
        </MudItem>
    }
</MudGrid>
@if (_targets.Count == 0 && !_busy)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">@L["There is no data you may import here."]</MudAlert>
}
<MudText Typo="Typo.h6" Class="mb-2">@L["Your imports and exports"]</MudText>
<MudDataGrid T="DataTransferJobDto" Items="_jobs" Loading="_busy" Dense="Density.Dense" Hover="true" Elevation="0" Outlined="true" data-testid="transfer-jobs">
    <Columns>
        <PropertyColumn Property="j => j.CreatedAt" Title="@L["Started"]" Format="g" />
        <TemplateColumn Title="@L["What"]" Sortable="false">
            <CellTemplate>@L[context.Item.Kind.ToString()] @L[context.Item.EntitySet]@(context.Item.DryRun ? $" ({L["Dry run"]})" : null)</CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="j => j.FileName" Title="@L["File"]" />
        <TemplateColumn Title="@L["Status"]" Sortable="false">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Item.Status)">@L[context.Item.Status.ToString()]</MudChip>
                @if (!context.Item.IsFinished && context.Item.Total > 0)
                {
                    <MudProgressLinear Value="@(100d * context.Item.Processed / context.Item.Total)" Size="Size.Small" />
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Rows"]" Sortable="false">
            <CellTemplate>
                @if (context.Item.Kind == DataTransferKind.Import)
                {
                    @L["{0} new, {1} updated, {2} failed", context.Item.Created, context.Item.Updated, context.Item.Failed]
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="DataTransferJobDto" Sortable="false" CellStyle="text-align:right;white-space:nowrap">
            <CellTemplate>
                @if (context.Item.ResultFileName is not null)
                {
                    <MudIconButton Icon="@Icons.Material.Outlined.FileDownload" Size="Size.Small" aria-label="@L["Download"]" OnClick="() => Watcher.DownloadAsync(context.Item)" />
                }
                @if (context.Item.CanUndo)
                {
                    <MudIconButton Icon="@Icons.Material.Outlined.Undo" Size="Size.Small" Color="Color.Warning" aria-label="@L["Undo import"]" OnClick="() => UndoAsync(context.Item)" />
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText Class="mud-text-secondary pa-4">@L["Nothing imported or exported yet."]</MudText>
    </NoRecordsContent>
</MudDataGrid>
