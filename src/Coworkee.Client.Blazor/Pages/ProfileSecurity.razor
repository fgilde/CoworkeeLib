<MudPaper Outlined="true" Class="pa-4 mb-4" data-testid="profile-email">
    <MudText Typo="Typo.h6" Class="mb-2">@L["Email address"]</MudText>
    <MudText Class="mud-text-secondary mb-4">@L["You sign in with {0}. A new address takes effect once you open the link we send to it.", _profile?.Email ?? string.Empty]</MudText>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.AlternateEmail" OnClick="ChangeEmailAsync" Disabled="_profile is null" data-testid="change-email">@L["Change email"]</MudButton>
</MudPaper>
<MudPaper Outlined="true" Class="pa-4" data-testid="profile-security">
    <MudText Typo="Typo.h6" Class="mb-2">@L["Sign-in"]</MudText>
    <MudText Class="mud-text-secondary mb-4">@L["Your address signs you in. Password and two-step verification are managed on the sign-in pages."]</MudText>
    @if (_manage is not null)
    {
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Password" Href="@($"{_manage}/ChangePassword")" Target="_blank" Class="mr-2 mb-2">@L["Change password"]</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Security" Href="@($"{_manage}/TwoFactor")" Target="_blank" Class="mb-2">@L["Two-step verification"]</MudButton>
    }
</MudPaper>
