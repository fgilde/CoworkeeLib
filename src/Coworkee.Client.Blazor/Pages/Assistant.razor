@page "/assistant"
@attribute [Authorize(Policy = PermissionPolicy.Prefix + AiPermissions.Chat)]

<PageHeader Title="Assistant">
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Add" OnClick="Clear" Disabled="_busy" data-testid="new-chat">@L["New conversation"]</MudButton>
</PageHeader>
<MudStack Spacing="2" Class="mb-4" data-testid="conversation">
    @if (_turns.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L[Options.AssistantHint]</MudText>
    }
    @foreach (var turn in _turns)
    {
        <MudPaper Class="pa-3" Elevation="0" Outlined="true" Style="@(turn.Message.Role == "user" ? "margin-left:15%" : "margin-right:15%")" data-role="@turn.Message.Role">
            <MudText Typo="Typo.caption" Color="Color.Secondary">@L[turn.Message.Role == "user" ? "You" : "Assistant"]</MudText>
            @* plain text only: the answer may echo content and must never render as markup *@
            <MudText Typo="Typo.body1" Style="white-space:pre-wrap">@turn.Message.Text</MudText>
            @if (turn.ToolCalls.Count > 0)
            {
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-2">
                    @foreach (var call in turn.ToolCalls)
                    {
                        <MudTooltip Text="@(call.Error ?? call.Input)">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(call.Succeeded ? Color.Success : Color.Error)"
                                     Icon="@(call.Succeeded ? Icons.Material.Outlined.Check : Icons.Material.Outlined.ErrorOutline)" data-tool="@call.Tool">@call.Tool</MudChip>
                        </MudTooltip>
                    }
                </MudStack>
            }
        </MudPaper>
    }
    @if (_busy)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
</MudStack>
<MudStack Row="true" AlignItems="AlignItems.End">
    <MudTextField Margin="Density.Margin" T="string" @bind-Value="_input" Label="@L["Message"]" Lines="3" Variant="Variant.Outlined" MaxLength="20000" Disabled="_busy" Class="flex-grow-1" data-testid="message" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Outlined.Send" OnClick="SendAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_input))" data-testid="send">@L["Send"]</MudButton>
</MudStack>
