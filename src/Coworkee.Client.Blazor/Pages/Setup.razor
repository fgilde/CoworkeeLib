@page "/setup"
@layout SetupLayout
@attribute [AllowAnonymous]

<PageTitle>Set up @Options.AppTitle</PageTitle>

<style>
    .cw-wizard { width: 100%; max-width: 820px; }
    .cw-steps { display: flex; gap: 6px; margin-bottom: 18px; flex-wrap: wrap; }
    .cw-step { display: flex; align-items: center; gap: 8px; padding: 6px 12px 6px 6px; border-radius: 999px; font-size: .85rem;
        color: var(--mud-palette-text-secondary); background: color-mix(in srgb, var(--mud-palette-surface) 70%, transparent); }
    .cw-step b { width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; font-size: .75rem;
        background: var(--mud-palette-lines-default); color: var(--mud-palette-text-primary); }
    .cw-step.done b { background: color-mix(in srgb, var(--mud-palette-primary) 30%, transparent); }
    .cw-step.active { color: var(--mud-palette-text-primary); font-weight: 600; background: var(--mud-palette-surface);
        box-shadow: 0 4px 14px color-mix(in srgb, var(--mud-palette-primary) 22%, transparent); }
    .cw-step.active b { background: var(--mud-palette-primary); color: var(--mud-palette-primary-text); }
    .cw-card { padding: 36px 40px; border-radius: 18px !important; backdrop-filter: blur(6px);
        background: color-mix(in srgb, var(--mud-palette-surface) 92%, transparent) !important; }
    .cw-done { text-align: center; padding: 24px 0 8px; }
</style>

<div class="cw-wizard">
    @if (!_done)
    {
        <div class="cw-steps" aria-label="Setup steps">
            @for (var i = 0; i <= LastStep; i++)
            {
                <div class="@($"cw-step {(i == _step ? "active" : i < _step ? "done" : string.Empty)}")">
                    <b>@(i < _step ? "✓" : (i + 1).ToString())</b>@StepTitles[i]
                </div>
            }
        </div>
    }

    <MudPaper Elevation="8" Class="cw-card">
        @if (_done)
        {
            <div class="cw-done">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Style="font-size:64px" />
                <MudText Typo="Typo.h4" Class="mt-2">@Options.AppTitle is ready</MudText>
                <MudText Class="mt-2 mb-6 mud-text-secondary">Sign in as <b>@_request.AdminEmail</b> with the password you just chose.</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" data-testid="sign-in"
                           Href="@($"{Options.LoginPath}?returnUrl={Uri.EscapeDataString("/")}&loginHint={Uri.EscapeDataString(_request.AdminEmail)}")">Sign in</MudButton>
            </div>
        }
        else
        {
            <MudText Typo="Typo.overline">Step @(_step + 1) of @(LastStep + 1)</MudText>
            <MudText Typo="Typo.h4" Class="mb-1">@StepTitles[_step]</MudText>
            <MudText Class="mb-6 mud-text-secondary">@StepHints[_step]</MudText>

            @switch (_step)
            {
                case 0:
                    <MudTextField Margin="Density.Margin" @bind-Value="_request.SetupToken" Label="Setup token" Variant="Variant.Outlined" data-testid="setup-token" Required="true" Immediate="true"
                                  HelperText="Printed in the API log on first start, or configured as Coworkee:SetupToken." />
                    break;
                case 1:
                    @if (_checks is null)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    }
                    else
                    {
                        @foreach (var check in _checks)
                        {
                            <MudAlert Severity="@SeverityOf(check.Status)" Variant="Variant.Outlined" Dense="Density.Dense" Class="mb-2" data-check="@check.Name">
                                <b>@check.Name</b> @(check.Message ?? "OK")
                            </MudAlert>
                        }
                    }
                    break;
                case 2:
                    <MudTextField Margin="Density.Margin" @bind-Value="_request.TenantName" Label="Organisation name" Variant="Variant.Outlined" data-testid="tenant-name" Required="true" Immediate="true" />
                    break;
                case 3:
                    <ThemePicker Themes="_themes" SelectedId="SelectedThemeId" SelectedIdChanged="Choose" Mode="@ThemeService.Mode" ModeChanged="ThemeService.SetMode" />
                    @if (_themes is not null)
                    {
                        <MudText Typo="Typo.caption" Class="mt-3 d-block mud-text-secondary">Admins can create their own themes later under Themes; everyone can pick one under My settings.</MudText>
                    }
                    break;
                case 4:
                    <MudStack Spacing="3">
                        <MudTextField Margin="Density.Margin" @bind-Value="_request.AdminEmail" Label="Administrator email" Variant="Variant.Outlined" InputType="InputType.Email" data-testid="admin-email" Required="true" Immediate="true"
                                      Error="@HasError("AdminEmail")" ErrorText="@ErrorFor("AdminEmail")" />
                        <MudStack Row="true" Spacing="3">
                            <MudTextField Margin="Density.Margin" @bind-Value="_request.AdminFirstName" Label="First name" Variant="Variant.Outlined" data-testid="admin-first" Immediate="true" />
                            <MudTextField Margin="Density.Margin" @bind-Value="_request.AdminLastName" Label="Last name" Variant="Variant.Outlined" data-testid="admin-last" Immediate="true" />
                        </MudStack>
                        <MudTextField Margin="Density.Margin" @bind-Value="_request.AdminPassword" Label="Password" Variant="Variant.Outlined" InputType="@PasswordInput" data-testid="admin-password" Required="true" Immediate="true"
                                      Adornment="Adornment.End" AdornmentIcon="@(_showPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                                      OnAdornmentClick="() => _showPassword = !_showPassword" AdornmentAriaLabel="Show password"
                                      Error="@HasError("Password")" ErrorText="@ErrorFor("Password")" />
                        <MudTextField Margin="Density.Margin" @bind-Value="_confirmPassword" Label="Repeat password" Variant="Variant.Outlined" InputType="@PasswordInput" data-testid="admin-password-confirm" Required="true" Immediate="true" />
                    </MudStack>
                    break;
                default:
                    <MudStack Spacing="3">
                        <MudStack Row="true" Spacing="3">
                            <MudTextField Margin="Density.Margin" @bind-Value="_mail.Host" Label="SMTP host" Variant="Variant.Outlined" data-testid="mail-host" Immediate="true" />
                            <MudTextField Margin="Density.Margin" @bind-Value="_mail.Port" Label="SMTP port" Variant="Variant.Outlined" InputType="InputType.Number" Placeholder="25" data-testid="mail-port" Immediate="true" Style="max-width:140px" />
                        </MudStack>
                        <MudTextField Margin="Density.Margin" @bind-Value="_mail.From" Label="Sender address" Variant="Variant.Outlined" InputType="InputType.Email" data-testid="mail-from" Immediate="true" />
                        <MudStack Row="true" Spacing="3">
                            <MudTextField Margin="Density.Margin" @bind-Value="_mail.UserName" Label="User name" Variant="Variant.Outlined" data-testid="mail-user" Immediate="true" />
                            <MudTextField Margin="Density.Margin" @bind-Value="_mail.Password" Label="Password" Variant="Variant.Outlined" InputType="InputType.Password" data-testid="mail-password" Immediate="true" />
                        </MudStack>
                        <MudCheckBox Dense="Density.Dense" @bind-Value="_mail.UseSsl" Label="Use SSL" Color="Color.Primary" />
                    </MudStack>
                    break;
            }

            @if (_error is not null)
            {
                <MudAlert Dense="Density.Dense" Severity="Severity.Error" Variant="Variant.Filled" Class="mt-6" data-testid="setup-error">@_error</MudAlert>
            }

            <MudStack Row="true" Class="mt-8" AlignItems="AlignItems.Center">
                @if (_step > 0)
                {
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="Back">Back</MudButton>
                }
                <MudSpacer />
                @if (_step < LastStep)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" EndIcon="@Icons.Material.Filled.ArrowForward" OnClick="NextAsync" Disabled="@BlockedByChecks" data-testid="next">Next</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" EndIcon="@Icons.Material.Filled.Check" OnClick="FinishAsync" Disabled="_busy" data-testid="finish">Finish setup</MudButton>
                }
            </MudStack>
        }
    </MudPaper>
</div>
