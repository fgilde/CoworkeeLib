@using MudBlazor.Extensions.Components
<MudDialog Class="@MudBlazor.Extensions.Helper.MudExCss.Classes.Dialog.Initial" data-testid="chat-attach-dialog">
    <DialogContent>
        @* MudEx localizes the button text itself: a translated text would be looked up as key again and machine translated *@
        <MudExUploadEdit @ref="_edit" T="UploadableFile" AllowMultiple="true" AllowFolderUpload="false" AllowExternalUrl="false" AllowAudioRecording="true" AllowVideoCapture="true"
                         MaxFileSize="@MaxBytes" TextUploadFiles="Choose files" TextDropZone="Drop files here" MinHeight="160"
                         ButtonVariant="Variant.Outlined" ButtonColor="Color.Default" ExternalProviderRendering="ExternalProviderRendering.Images" ExternalPickerImageSize="@("30px")" />
        @if (_canPickFiles)
        {
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.FolderOpen" OnClick="FromFilesAsync" Class="mt-2" data-testid="chat-attach-from-files">@L["Choose from files"]</MudButton>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.AttachFile" OnClick="DoneAsync" Disabled="_busy"
                   data-testid="chat-attach-done">@L["Attach files"]</MudButton>
    </DialogActions>
</MudDialog>
