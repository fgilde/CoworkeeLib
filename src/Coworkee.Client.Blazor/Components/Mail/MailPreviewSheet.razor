<MudDialog Class="@MudBlazor.Extensions.Helper.MudExCss.Classes.Dialog.Initial">
    <DialogContent>
        <div class="d-flex flex-column" style="height:calc(100vh - 110px)">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
            <MudToggleGroup T="bool" @bind-Value="_phone" Size="Size.Small" Color="Color.Primary" Outlined="true" Delimiters="false">
                <MudToggleItem Value="false" data-testid="preview-desktop"><MudIcon Icon="@Icons.Material.Outlined.DesktopWindows" Size="Size.Small" Class="mr-1" />@L["Desktop"]</MudToggleItem>
                <MudToggleItem Value="true" data-testid="preview-phone"><MudIcon Icon="@Icons.Material.Outlined.PhoneIphone" Size="Size.Small" Class="mr-1" />@L["Phone"]</MudToggleItem>
            </MudToggleGroup>
            <MudToggleGroup T="bool" @bind-Value="_dark" Size="Size.Small" Color="Color.Primary" Outlined="true" Delimiters="false">
                <MudToggleItem Value="false" data-testid="preview-light"><MudIcon Icon="@Icons.Material.Outlined.LightMode" Size="Size.Small" Class="mr-1" />@L["Light"]</MudToggleItem>
                <MudToggleItem Value="true" data-testid="preview-dark"><MudIcon Icon="@Icons.Material.Outlined.DarkMode" Size="Size.Small" Class="mr-1" />@L["Dark"]</MudToggleItem>
            </MudToggleGroup>
        </MudStack>
        @if (Preview.Errors.Count > 0)
        {
            <MudAlert Dense="true" Severity="Severity.Warning" Class="mb-2" data-testid="preview-errors">@string.Join(" ", Preview.Errors)</MudAlert>
        }
        @if (Preview.Rendered is { } mail)
        {
            <MudPaper Outlined="true" Class="pa-2 mb-2 d-flex align-center gap-2" data-testid="preview-inbox">
                <MudAvatar Size="Size.Small" Color="Color.Primary">@Initial</MudAvatar>
                <div style="min-width:0">
                    <MudText Typo="Typo.body2" Style="font-weight:600" Class="text-truncate" data-testid="preview-subject">@mail.Subject</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block text-truncate">@Preheader(mail.HtmlBody)</MudText>
                </div>
            </MudPaper>
            <div class="flex-grow-1 d-flex justify-center" style="min-height:0;overflow:auto">
                <iframe data-testid="preview-frame" sandbox="" srcdoc="@Document(mail.HtmlBody)" title="@L["Preview"]"
                        style="@($"width:{(_phone ? "390px" : "100%")};height:100%;border:1px solid var(--mud-palette-lines-default);border-radius:{(_phone ? "24px" : "4px")};background:{(_dark ? "#121212" : "#fff")}")"></iframe>
            </div>
        }
        else
        {
            <MudProgressLinear Indeterminate="true" />
        }
        </div>
    </DialogContent>
</MudDialog>
