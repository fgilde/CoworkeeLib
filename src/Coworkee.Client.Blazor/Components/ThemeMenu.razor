<AuthorizeView>
    <Authorized>
        @if (_themes.Count > 1)
        {
            <MudMenu Icon="@(Nested ? null : Icons.Material.Outlined.Palette)" StartIcon="@(Nested ? Icons.Material.Outlined.Palette : null)" Label="@(Nested ? L["Theme"] : null)" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="Density.Dense"
                     aria-label="@L["Theme"]" data-testid="theme-menu">
                @foreach (var theme in _themes)
                {
                    <MudMenuItem OnClick="() => ChooseAsync(theme)" Icon="@(theme.Id == ThemeService.Current?.Id ? Icons.Material.Filled.Check : Icons.Material.Outlined.Circle)"
                                 data-theme="@theme.Name">@theme.Name</MudMenuItem>
                }
            </MudMenu>
        }
    </Authorized>
</AuthorizeView>
