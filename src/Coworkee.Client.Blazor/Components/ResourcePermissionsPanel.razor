
<MudPaper Outlined="true" Class="pa-4">
    <MudText Typo="Typo.h6">@L["Permissions"]</MudText>
    @if (_entries is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <MudSimpleTable Dense="Density.Dense">
            <thead><tr><th>@L["Who"]</th><th>@L["Role"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var entry in _entries)
                {
                    <tr>
                        <td>@PrincipalName(entry)</td>
                        <td>@(_roles.GetValueOrDefault(entry.RoleId) ?? "?")</td>
                        <td style="text-align:right">
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" aria-label="@L["Revoke"]"
                                           OnClick="() => RevokeAsync(entry)" data-testid="@($"revoke-{entry.Id}")" />
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>

        <MudStack Row="true" AlignItems="AlignItems.End" Class="mt-4">
            <MudSelect Margin="Density.Margin" T="string" Label="@L["User or group"]" @bind-Value="_principal" Dense="Density.Dense">
                @foreach (var user in _users)
                {
                    <MudSelectItem Value="@($"User:{user.Key}")">@user.Value</MudSelectItem>
                }
                @foreach (var group in _groups)
                {
                    <MudSelectItem Value="@($"Group:{group.Key}")">@L["{0} (group)", group.Value]</MudSelectItem>
                }
            </MudSelect>
            <MudSelect Margin="Density.Margin" T="Guid" Label="@L["Role"]" @bind-Value="_role" Dense="Density.Dense">
                @foreach (var role in _roles)
                {
                    <MudSelectItem Value="@role.Key">@role.Value</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GrantAsync" Disabled="@(_principal is null || _role == Guid.Empty)">@L["Grant"]</MudButton>
        </MudStack>
    }
</MudPaper>
