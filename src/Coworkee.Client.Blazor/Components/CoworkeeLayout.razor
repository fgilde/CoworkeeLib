@inherits LayoutComponentBase
@inject CoworkeeClientOptions Options
@inject IEnumerable<INavigationContributor> Navigation
@inject ICoworkeeApi Api
@inject NavigationManager Nav
@inject ThemeService ThemeService
@implements IDisposable

<MudThemeProvider @ref="_provider" Theme="ThemeService.Theme" IsDarkMode="_dark" />
@if (ThemeService.CustomCss is { Length: > 0 } css)
{
    <style>@css</style>
}
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="() => _drawer = !_drawer" aria-label="Toggle navigation" />
        @if (ThemeService.LogoSvg is { Length: > 0 } logo)
        {
            <img class="ml-2" data-testid="logo" alt="" style="height:28px" src="@($"data:image/svg+xml;base64,{Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(logo))}")" />
        }
        <MudText Typo="Typo.h6" Class="ml-2">@Options.AppTitle</MudText>
        <MudSpacer />
        <MudIconButton Icon="@(_dark ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)" Color="Color.Inherit" OnClick="ToggleDarkAsync" aria-label="Toggle dark mode" />
        <AuthorizeView>
            <Authorized>
                <NotificationBell />
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" data-testid="user-menu">
                    <ActivatorContent Context="menu">
                        <MudButton Variant="Variant.Text" Color="Color.Inherit" Class="ml-2" Style="text-transform:none" StartIcon="@Icons.Material.Outlined.AccountCircle" EndIcon="@Icons.Material.Filled.ArrowDropDown" aria-label="Account" OnClick="@(() => menu.ToggleAsync())">
                            @context.User.Identity?.Name
                        </MudButton>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Href="/profile" Icon="@Icons.Material.Outlined.Badge">My profile</MudMenuItem>
                        <MudMenuItem Href="/settings" Icon="@Icons.Material.Outlined.ManageAccounts">My settings</MudMenuItem>
                        @if (context.User.FindFirst("manage_url")?.Value is { } manage)
                        {
                            <MudMenuItem Href="@manage" Target="_blank" Icon="@Icons.Material.Outlined.Security">Password and security</MudMenuItem>
                        }
                        <MudDivider />
                        <MudMenuItem OnClick="LogoutAsync" Icon="@Icons.Material.Outlined.Logout">Sign out</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Small" Href="@($"{Options.LoginPath}?returnUrl={Uri.EscapeDataString(Nav.ToBaseRelativePath(Nav.Uri) is { Length: > 0 } p ? "/" + p : "/")}")">Sign in</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawer" Elevation="0" Variant="DrawerVariant.Responsive">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Home">Home</MudNavLink>
            @foreach (var item in Navigation.SelectMany(n => n.Items))
            {
                if (item.Permission is null)
                {
                    <MudNavLink Href="@item.Href" Icon="@item.Icon" ForceLoad="@item.ForceLoad">@item.Title</MudNavLink>
                }
                else
                {
                    <PermissionView Permission="@item.Permission">
                        <MudNavLink Href="@item.Href" Icon="@item.Icon" ForceLoad="@item.ForceLoad">@item.Title</MudNavLink>
                    </PermissionView>
                }
            }
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">@Body</MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawer = true;
    private bool _dark;
    private bool _systemDark;

    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = null!;
    private MudThemeProvider? _provider;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ThemeService.LoadAsync();
            _systemDark = _provider is not null && await _provider.GetSystemDarkModeAsync();
            Refresh();
        }
    }

    protected override void OnInitialized() => ThemeService.Changed += Refresh;

    public void Dispose() => ThemeService.Changed -= Refresh;

    private void Refresh() => InvokeAsync(() =>
    {
        _dark = ThemeService.Mode switch
        {
            "dark" => true,
            "light" => false,
            _ => _systemDark,
        };
        StateHasChanged();
    });

    /// <summary>Switches light and dark; signed-in users keep the choice.</summary>
    private async Task ToggleDarkAsync()
    {
        var mode = _dark ? "light" : "dark";
        ThemeService.SetMode(mode);
        if ((await AuthenticationState).User.Identity?.IsAuthenticated == true)
        {
            try
            {
                await Api.SetSettingsAsync(SettingScope.User, new Dictionary<string, string?> { [ThemeSettings.Mode] = mode });
            }
            catch (ApiException)
            {
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Nav.Uri.Contains("/setup", StringComparison.Ordinal))
        {
            try
            {
                if (!(await Api.GetSetupStatusAsync()).IsInitialized)
                {
                    Nav.NavigateTo("/setup");
                }
            }
            catch (ApiException)
            {
            }
        }
    }

    private async Task LogoutAsync()
    {
        var logout = await Api.LogoutAsync();
        Nav.NavigateTo(logout.Redirect, forceLoad: true);
    }
}
