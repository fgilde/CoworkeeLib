@inherits LayoutComponentBase

<MudThemeProvider @ref="_provider" Theme="ThemeService.Theme" IsDarkMode="_dark" />
@if (ThemeService.CustomCss is { Length: > 0 } css)
{
    <style>@css</style>
}
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <CoworkeeAppBar Dark="_dark" ToggleDrawer="() => _drawer = !_drawer" ToggleDark="ToggleDarkAsync" />
    <MudDrawer @bind-Open="_drawer" Elevation="0" Variant="DrawerVariant.Responsive">
        <CoworkeeNavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">@Body</MudContainer>
    </MudMainContent>
</MudLayout>
