@inherits LayoutComponentBase

@* the loading screen waits for this layout to hide it once the theme is applied *@
<span data-coworkee-loading-claim hidden></span>
@if (!_visible)
{
    return;
}
<MudThemeProvider @ref="_provider" Theme="ThemeService.Theme" IsDarkMode="_dark" />
@if (ThemeService.CustomCss is { Length: > 0 } css)
{
    <style>@css</style>
}
<style>@Layout.MobileStyles.Css</style>
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<SessionGuard />
<PwaPrompts />

<MudRTLProvider RightToLeft="Preferences.RightToLeft">
    <MudLayout @key="L.Culture">
        <CoworkeeAppBar Dark="_dark" Compact="_phone" ToggleDrawer="() => _drawer = !_drawer" ToggleDark="ToggleDarkAsync" />
        @* pinned: a mini icon strip under the app bar that the toggle widens; unpinned and on phones: an overlay that hides when closed *@
        <MudDrawer @bind-Open="_drawer" Elevation="1" Variant="@(Pinned ? DrawerVariant.Mini : DrawerVariant.Temporary)"
                   ClipMode="@(Pinned ? DrawerClipMode.Always : DrawerClipMode.Never)" data-testid="nav-drawer">
            <CoworkeeNavMenu Mini="@(Pinned && !_drawer)" />
        </MudDrawer>
        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.False" Class="pt-4 pb-6">@Body</MudContainer>
        </MudMainContent>
        <AuthorizeView>
            <Authorized><ChatDockHost /><AssistantLauncher /></Authorized>
        </AuthorizeView>
    </MudLayout>
</MudRTLProvider>
