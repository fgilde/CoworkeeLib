@inherits LayoutComponentBase

<MudThemeProvider @ref="_provider" Theme="ThemeService.Theme" IsDarkMode="_dark" />
@if (ThemeService.CustomCss is { Length: > 0 } css)
{
    <style>@css</style>
}
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudRTLProvider RightToLeft="Preferences.RightToLeft">
    <MudLayout @key="L.Culture">
        <CoworkeeAppBar Dark="_dark" ToggleDrawer="() => _drawer = !_drawer" ToggleDark="ToggleDarkAsync" />
        @* pinned: a mini icon strip under the app bar that the toggle widens; unpinned: an overlay that hides when closed *@
        <MudDrawer @bind-Open="_drawer" Elevation="1" Variant="@(Preferences.Pinned ? DrawerVariant.Mini : DrawerVariant.Temporary)"
                   ClipMode="@(Preferences.Pinned ? DrawerClipMode.Always : DrawerClipMode.Never)" data-testid="nav-drawer">
            <CoworkeeNavMenu Mini="@(Preferences.Pinned && !_drawer)" />
        </MudDrawer>
        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.False" Class="pt-4 pb-6">@Body</MudContainer>
        </MudMainContent>
    </MudLayout>
</MudRTLProvider>
