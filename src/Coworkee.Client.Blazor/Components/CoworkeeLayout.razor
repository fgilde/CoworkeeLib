@inherits LayoutComponentBase

<MudThemeProvider @ref="_provider" Theme="ThemeService.Theme" IsDarkMode="_dark" />
@if (ThemeService.CustomCss is { Length: > 0 } css)
{
    <style>@css</style>
}
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudRTLProvider RightToLeft="Preferences.RightToLeft">
    <MudLayout>
        <CoworkeeAppBar Dark="_dark" ToggleDrawer="() => _drawer = !_drawer" ToggleDark="ToggleDarkAsync" />
        <MudDrawer @bind-Open="_drawer" Elevation="0" Variant="@(Preferences.Pinned ? DrawerVariant.Responsive : DrawerVariant.Mini)" OpenMiniOnHover="true" data-testid="nav-drawer">
            <CoworkeeNavMenu Mini="@(!Preferences.Pinned && !_drawer)" />
        </MudDrawer>
        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">@Body</MudContainer>
        </MudMainContent>
    </MudLayout>
</MudRTLProvider>
