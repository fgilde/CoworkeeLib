<style>
    .cw-about { display: flex; flex-direction: column; gap: 28px; padding-top: 8px; padding-bottom: 16px; }
</style>

<MudDialog Class="@MudBlazor.Extensions.Helper.MudExCss.Classes.Dialog.Initial" ContentClass="cw-about" data-testid="about">
    <TitleContent>
        <MudText Typo="Typo.h6">@L["About {0}", Options.AppTitle]</MudText>
    </TitleContent>
    <DialogContent>
        @foreach (var section in Options.About.Sections)
        {
            <DynamicComponent Type="section" />
        }
    </DialogContent>
</MudDialog>
