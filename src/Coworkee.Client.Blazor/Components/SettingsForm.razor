@using MudBlazor.Extensions.Components.ObjectEdit
@using MudBlazor.Extensions.Components.ObjectEdit.Options

@if (_model is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudExObjectEditForm @key="_revision" Value="_model.Value" MetaInformation="_meta" IsLoading="_saving"
                         StickyActionBar="true" ActionBarColor="Color.Surface" ActionBarClass="border-t border-solid mud-border-lines-default"
                         GroupingStyle="GroupingStyle.Flat" GroupLineColor="@("--mud-palette-lines-default")" PathDisplayMode="PathDisplayMode.None"
                         GlobalResetSettings="NoReset" DefaultPropertyResetSettings="NoPropertyReset" DefaultGroupName="@L["General"]"
                         OnValidSubmit="SaveAsync" />
}
