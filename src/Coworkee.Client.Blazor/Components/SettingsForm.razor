@using MudBlazor.Extensions.Components.ObjectEdit

@if (_model is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudExObjectEditForm T="object" @key="_revision" Value="_model.Value" MetaInformation="_meta" IsLoading="_saving" AfterImport="Imported"
                         @attributes="SettingsFormRules.FormAttributes" DefaultGroupName="@L["General"]"
                         OnValidSubmit="SaveAsync">
        <ToolBarContent><MudSpacer /></ToolBarContent>
    </MudExObjectEditForm>
}
