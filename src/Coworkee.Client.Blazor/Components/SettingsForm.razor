
@if (_groups is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    @foreach (var group in _groups)
    {
        <MudText Typo="Typo.overline" Class="mt-4 d-block">@group.DisplayName</MudText>
        @foreach (var setting in group.Settings)
        {
            <div data-setting="@setting.Name" class="mb-3">
                @switch (setting.Type)
                {
                    case SettingType.Bool:
                        <MudCheckBox Dense="Density.Dense" T="bool" Value="@(bool.TryParse(Current(setting), out var on) && on)" ValueChanged="@((bool v) => Set(setting, v ? "true" : "false"))" Label="@setting.DisplayName" />
                        break;
                    case SettingType.Int:
                        <MudTextField Margin="Density.Margin" T="string" Value="@Current(setting)" ValueChanged="@((string v) => Set(setting, v))" Label="@setting.DisplayName"
                                      InputType="InputType.Number" Placeholder="@setting.DefaultValue" />
                        break;
                    case SettingType.Secret:
                        <MudTextField Margin="Density.Margin" T="string" Value="@_edited.GetValueOrDefault(setting.Name)" ValueChanged="@((string v) => Set(setting, v))" Label="@setting.DisplayName"
                                      InputType="InputType.Password" HelperText="@(IsStored(setting) ? "A value is stored. Type to replace it." : "No value stored.")" />
                        break;
                    case SettingType.Text:
                        <MudTextField Margin="Density.Margin" T="string" Value="@Current(setting)" ValueChanged="@((string v) => Set(setting, v))" Label="@setting.DisplayName" Lines="4" />
                        break;
                    case SettingType.Choice:
                        <MudSelect Margin="Density.Margin" Dense="Density.Dense" T="string" Value="@Current(setting)" ValueChanged="@((string v) => Set(setting, v))" Label="@setting.DisplayName">
                            @foreach (var choice in setting.Choices ?? [])
                            {
                                <MudSelectItem Value="@choice">@choice</MudSelectItem>
                            }
                        </MudSelect>
                        break;
                    default:
                        <MudTextField Margin="Density.Margin" T="string" Value="@Current(setting)" ValueChanged="@((string v) => Set(setting, v))" Label="@setting.DisplayName" Placeholder="@setting.DefaultValue" />
                        break;
                }
                @if (setting.Description is not null)
                {
                    <MudText Typo="Typo.caption">@setting.Description</MudText>
                }
            </div>
        }
    }

    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@(_saving || _edited.Count == 0)" data-testid="save-settings">Save</MudButton>
}
