@typeparam T where T : class, new()
@using System.Text.Json
@using MudBlazor.Extensions.Components.ObjectEdit
@using MudBlazor.Extensions.Components.ObjectEdit.Options

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" data-testid="configuration-error">@_error</MudAlert>
}

@if (_value is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudExObjectEditForm @key="_revision" Value="_value" IsLoading="_busy"
                         StickyToolbar="true" StickyActionBar="false" AllowExport="true" AllowImport="true" ImportNeedsConfirmation="true"
                         GroupingStyle="GroupingStyle.Flat" DefaultGroupName="General"
                         MetaConfiguration="@(Registration.Meta as Action<ObjectEditMeta<T>>)"
                         OnValidSubmit="SaveAsync">
        <ToolBarContent>
            <MudSpacer />
            @if (_changed.Count > 0)
            {
                <MudTooltip Text="@string.Join(", ", _changed)">
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" data-testid="changed-count">@_changed.Count changed in the app</MudChip>
                </MudTooltip>
            }
            <MudTooltip Text="Restore the configured values (appsettings and environment)">
                <MudIconButton Icon="@Icons.Material.Outlined.SettingsBackupRestore" OnClick="ResetAsync" Disabled="@(_changed.Count == 0 || _busy)" data-testid="reset" aria-label="Restore defaults" />
            </MudTooltip>
        </ToolBarContent>
    </MudExObjectEditForm>
}
