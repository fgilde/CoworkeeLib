<style>
    .cw-tabs-stick-merge > .mud-tabs > .mud-tabs-tabbar { border-radius: var(--mud-default-borderradius) var(--mud-default-borderradius) 0 0; }
    .cw-tabs-stick-merge > .mud-tabs > .mud-tabs-panels { border: 1px solid var(--mud-palette-lines-default); border-top: 0; border-radius: 0 0 var(--mud-default-borderradius) var(--mud-default-borderradius); }
    @@media (min-width: 600px) {
        .cw-tabs-stick-merge > .mud-tabs > .mud-tabs-tabbar { position: sticky; top: var(--mud-appbar-height); z-index: 10; }
        .cw-tabs-stick-merge[stuck] > .mud-tabs > .mud-tabs-tabbar { display: flex; align-items: center; min-height: var(--cw-stuck-height, 0px); width: fit-content; box-sizing: border-box; padding-inline: 16px; background: var(--mud-palette-surface); border-radius: 0 0 var(--mud-default-borderradius) 0; }
    }
    .cw-tabs-sentinel { height: 1px; margin-bottom: -1px; pointer-events: none; }
</style>

<div @ref="_root" class="cw-tabs-stick-merge">
    <div @ref="_sentinel" class="cw-tabs-sentinel"></div>
    @ChildContent
</div>
