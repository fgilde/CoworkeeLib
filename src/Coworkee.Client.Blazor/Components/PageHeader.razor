<PageTitle>@L[Title]</PageTitle>
<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" data-testid="page-header">
    <div>
        <MudText Typo="Typo.h5" Color="Color.Primary">@L[Title]</MudText>
        @if (!string.IsNullOrEmpty(Description))
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@L[Description]</MudText>
        }
    </div>
    <MudSpacer />
    @ChildContent
</MudStack>
