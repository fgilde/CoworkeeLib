@* themes as cards with a small preview of the app in their colors, and the color mode; the parent applies and stores the choice *@

<style>
    .cw-themes { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 16px; }
    .cw-theme { cursor: pointer; border-radius: 14px; padding: 10px; border: 2px solid var(--mud-palette-lines-default); background: var(--mud-palette-surface);
        transition: transform 120ms ease, border-color 120ms ease, box-shadow 120ms ease; display: block; position: relative; }
    .cw-theme:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(0,0,0,.08); }
    .cw-theme:focus-visible { outline: 2px solid var(--mud-palette-primary); outline-offset: 2px; }
    .cw-theme.selected { border-color: var(--mud-palette-primary); box-shadow: 0 6px 20px color-mix(in srgb, var(--mud-palette-primary) 30%, transparent); }
    .cw-theme-preview { height: 96px; border-radius: 9px; overflow: hidden; margin-bottom: 10px; display: flex; flex-direction: column;
        box-shadow: inset 0 0 0 1px var(--mud-palette-lines-default); }
    .cw-theme-preview-bar { height: 20px; display: flex; align-items: center; gap: 4px; padding: 0 8px; flex: none; }
    .cw-theme-preview-bar i { width: 6px; height: 6px; border-radius: 50%; opacity: .8; display: block; }
    .cw-theme-preview-body { flex: 1; display: flex; gap: 6px; padding: 8px; }
    .cw-theme-preview-nav { width: 18%; border-radius: 4px; opacity: .9; }
    .cw-theme-preview-surface { flex: 1; border-radius: 6px; padding: 7px; display: flex; flex-direction: column; gap: 5px; box-shadow: 0 1px 3px rgba(0,0,0,.15); }
    .cw-theme-preview-text { height: 5px; border-radius: 3px; width: 80%; display: block; }
    .cw-theme-preview-text.short { width: 50%; opacity: .7; }
    .cw-theme-preview-actions { display: flex; gap: 4px; margin-top: auto; }
    .cw-theme-preview-actions i { height: 9px; width: 26px; border-radius: 5px; display: block; }
    .cw-theme-name { display: flex; align-items: center; gap: 6px; }
    .cw-theme-check { position: absolute; top: 4px; right: 4px; border-radius: 50%; background: var(--mud-palette-primary); color: var(--mud-palette-primary-text);
        display: flex; padding: 2px; }
</style>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.subtitle2">@L["Color mode"]</MudText>
    <MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">
        @foreach (var (mode, label, icon) in Modes)
        {
            <MudButton data-mode="@mode" StartIcon="@icon" Variant="@(Mode == mode ? Variant.Filled : Variant.Outlined)" OnClick="() => ModeChanged.InvokeAsync(mode)">@L[label]</MudButton>
        }
    </MudButtonGroup>
    @ChildContent
</MudStack>

@if (Themes is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <div class="cw-themes">
        @foreach (var theme in Themes)
        {
            var colors = Preview(theme);
            <div role="button" tabindex="0" aria-pressed="@(theme.Id == SelectedId)" class="@($"cw-theme {(theme.Id == SelectedId ? "selected" : string.Empty)}")" data-theme="@theme.Name"
                 @onclick="() => SelectedIdChanged.InvokeAsync(theme.Id)" @onkeydown="e => KeyAsync(e, theme)">
                @if (theme.Id == SelectedId)
                {
                    <span class="cw-theme-check"><MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" /></span>
                }
                <div class="cw-theme-preview" style="background:@colors.Background" aria-hidden="true">
                    <div class="cw-theme-preview-bar" style="background:@colors.AppBar">
                        <i style="background:@colors.AppBarText"></i><i style="background:@colors.AppBarText"></i>
                    </div>
                    <div class="cw-theme-preview-body">
                        <span class="cw-theme-preview-nav" style="background:@colors.Drawer"></span>
                        <div class="cw-theme-preview-surface" style="background:@colors.Surface">
                            <span class="cw-theme-preview-text" style="background:@colors.Text"></span>
                            <span class="cw-theme-preview-text short" style="background:@colors.TextSecondary"></span>
                            <span class="cw-theme-preview-actions"><i style="background:@colors.Primary"></i><i style="background:@colors.Secondary"></i></span>
                        </div>
                    </div>
                </div>
                <div class="cw-theme-name">
                    <MudText Typo="Typo.subtitle2">@theme.Name</MudText>
                </div>
            </div>
        }
    </div>
}
