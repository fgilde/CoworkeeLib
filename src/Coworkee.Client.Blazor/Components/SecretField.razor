@if (Stored && !_replacing)
{
    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2" data-testid="@($"{TestId}-stored")">
        <MudTextField T="string" Value="@Mask" ReadOnly="true" Label="@Label" Variant="Variant.Outlined" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Outlined.Lock" HelperText="@Help" Class="flex-grow-1" />
        <MudButton Variant="Variant.Outlined" OnClick="() => _replacing = true" Class="mt-2" data-testid="@($"{TestId}-replace")">@L["Replace"]</MudButton>
        <MudTooltip Text="@L["Remove key"]">
            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" OnClick="RemoveAsync" Class="mt-1" aria-label="@L["Remove key"]" data-testid="@($"{TestId}-remove")" />
        </MudTooltip>
    </MudStack>
}
else
{
    <MudTextField T="string" Value="Value" ValueChanged="ValueChanged" Label="@Label" Variant="Variant.Outlined" InputType="@(_visible ? InputType.Text : InputType.Password)"
                  Required="Required" Adornment="Adornment.End"
                  AdornmentIcon="@(_visible ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)" OnAdornmentClick="() => _visible = !_visible"
                  AdornmentAriaLabel="@L["Show key"]" UserAttributes="@_attributes" HelperText="@Help" />
}
