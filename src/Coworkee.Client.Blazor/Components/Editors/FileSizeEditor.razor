<MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2" data-testid="file-size">
    <MudNumericField T="decimal?" Value="_amount" ValueChanged="SetAmountAsync" Label="@Label" HelperText="@HelperText" Placeholder="@L["No limit"]"
                     Min="0" Immediate="false" Clearable="true" ReadOnly="ReadOnly" Variant="Variant" Margin="Density.Margin" Class="flex-grow-1" data-testid="file-size-amount" />
    <MudSelect T="long" Value="_unit" ValueChanged="SetUnitAsync" Label="@L["Unit"]" ReadOnly="ReadOnly" Variant="Variant" Margin="Density.Margin" Dense="Density.Dense"
               Style="max-width:110px" data-testid="file-size-unit">
        @foreach (var (name, factor) in Units)
        {
            <MudSelectItem Value="factor">@name</MudSelectItem>
        }
    </MudSelect>
</MudStack>
