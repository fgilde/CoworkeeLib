@using MudBlazor.Extensions.Components
<MudStack Spacing="1" Class="my-2" data-testid="content-types">
    @if (Label is not null)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@Label</MudText>
    }
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="1">
        @foreach (var type in Selected.Select(ContentTypeCatalog.Describe))
        {
            <MudTooltip Text="@type.Value">
                @if (ReadOnly)
                {
                    <MudChip T="string" Icon="@type.Icon" Size="Density.Size" data-type="@type.Value">@L[type.Name]</MudChip>
                }
                else
                {
                    <MudChip T="string" Icon="@type.Icon" Size="Density.Size" OnClose="_ => RemoveAsync(type.Value)" data-type="@type.Value">@L[type.Name]</MudChip>
                }
            </MudTooltip>
        }
        @if (Selected.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary" data-testid="content-types-any">@L["Every file type"]</MudText>
        }
    </MudStack>
    @if (!ReadOnly)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudExSelect T="string" MultiSelection="true" SelectedValues="Selected" SelectedValuesChanged="SelectAsync" ItemCollection="Values"
                         GroupingEnabled="true" GroupBy="@(v => L[ContentTypeCatalog.Describe(v).Group])" SearchBox="true" SearchFunc="Matches"
                         SearchBoxPlaceholder="@L["Search by name, extension or MIME type"]" Placeholder="@L["Choose file types"]" ToStringFunc="Name"
                         Margin="Density.Margin" Dense="Density.Dense" Variant="Variant.Outlined" Style="max-width:420px" data-testid="content-type-select">
                <ItemTemplate>
                    @{ var type = ContentTypeCatalog.Describe(context); }
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" data-option="@context">
                        <MudIcon Icon="@type.Icon" Size="Size.Small" />
                        <MudText Typo="Typo.body2">@L[type.Name]</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@Detail(type)</MudText>
                    </MudStack>
                </ItemTemplate>
            </MudExSelect>
            <MudMenu Icon="@Icons.Material.Outlined.PlaylistAdd" Dense="Density.Dense" aria-label="@L["Add a group"]" data-testid="content-type-groups">
                @foreach (var group in ContentTypeCatalog.Groups)
                {
                    <MudMenuItem Icon="@group.Icon" OnClick="() => AddAsync(group.Values)" data-group="@group.Name">@L[group.Name]</MudMenuItem>
                }
            </MudMenu>
        </MudStack>
    }
    @if (HelperText is not null)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@HelperText</MudText>
    }
</MudStack>
