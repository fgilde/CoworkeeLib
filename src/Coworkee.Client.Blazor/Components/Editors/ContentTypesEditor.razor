@* one field like its neighbours (label, variant, helper text): the chips inside are the list, the search below adds to it *@
<MudField Label="@Label" Variant="Variant" HelperText="@HelperText" Margin="Density.Margin" Class="cw-content-types" data-testid="content-types">
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="1" Class="pt-1">
        @foreach (var type in Selected.Select(ContentTypeCatalog.Describe))
        {
            <MudTooltip Text="@type.Value">
                @if (ReadOnly)
                {
                    <MudChip T="string" Icon="@type.Icon" Size="Density.Size" data-type="@type.Value">@L[type.Name]</MudChip>
                }
                else
                {
                    <MudChip T="string" Icon="@type.Icon" Size="Density.Size" OnClose="_ => RemoveAsync(type.Value)" data-type="@type.Value">@L[type.Name]</MudChip>
                }
            </MudTooltip>
        }
        @if (Selected.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary" data-testid="content-types-any">@L["Every file type"]</MudText>
        }
    </MudStack>
    @if (!ReadOnly)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudAutocomplete T="string" Value="@null" ValueChanged="PickAsync" SearchFunc="SearchAsync" MaxItems="MaxResults" ToStringFunc="Name"
                             ResetValueOnEmptyText="true" CoerceText="false" Clearable="true" Placeholder="@L["Add a file type: name, extension or MIME type"]"
                             AdornmentIcon="@Icons.Material.Outlined.Add" Adornment="Adornment.Start" Margin="Density.Margin" Dense="Density.Dense" Underline="false"
                             Style="max-width:420px" data-testid="content-type-search">
                <ItemTemplate>
                    @{ var type = ContentTypeCatalog.Describe(context); }
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" data-option="@context">
                        <MudIcon Icon="@type.Icon" Size="Size.Small" />
                        <MudText Typo="Typo.body2">@L[type.Name]</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@L[type.Group] · @Detail(type)</MudText>
                    </MudStack>
                </ItemTemplate>
            </MudAutocomplete>
            <MudMenu Icon="@Icons.Material.Outlined.PlaylistAdd" Dense="Density.Dense" aria-label="@L["Add a group"]" data-testid="content-type-groups">
                @foreach (var group in ContentTypeCatalog.Groups)
                {
                    <MudMenuItem Icon="@group.Icon" OnClick="() => AddAsync(group.Values)" data-group="@group.Name">@L[group.Name]</MudMenuItem>
                }
            </MudMenu>
        </MudStack>
    }
</MudField>
