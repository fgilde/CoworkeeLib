@if (HeaderLayout.IsVertical(Position))
{
    @* a narrow column of icons at the left or right edge; its overflow menu at the bottom *@
    <nav class="cw-side-bar cw-side-bar-@Position.ToString().ToLowerInvariant()" data-testid="@TestId" data-position="@Position" aria-label="@L["App bar"]">
        @* without a horizontal bar and with the navigation as an overlay, this is the only way to open it *@
        @if (ShowMenuButton)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="ToggleDrawer" aria-label="@L["Navigation"]" data-testid="app-bar-menu" />
        }
        @Content(vertical: true)
    </nav>
}
else
{
    <MudAppBar Elevation="0" Bottom="@(Position == HeaderPosition.Bottom)" data-testid="@TestId" data-position="@Position">
        @if (ShowBrand)
        {
            @if (ShowMenuButton)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" aria-label="@L["Navigation"]" data-testid="app-bar-menu" />
            }
            <CoworkeeBrand />
        }
        @Content(vertical: false)
    </MudAppBar>
}

@code {
    private RenderFragment Content(bool vertical) => @<text>
        @if (HasHiddenPalette)
        {
            @* in the overflow menu or hidden: Ctrl+K still opens the palette *@
            <CoworkeeCommandPalette @ref="_palette" ShowButton="false" />
        }
        @if (!vertical && !HasSpacer)
        {
            @* without a spacer the items sit at the end of a bar across the window *@
            <div class="cw-bar-spacer"></div>
        }
        @foreach (var (item, end) in Laid(vertical))
        {
            @if (HeaderItems.IsSpacer(item.Id))
            {
                <div class="cw-bar-spacer" data-testid="app-bar-spacer"></div>
            }
            else
            {
                @* the item's menus open away from the edge and towards the middle of the bar *@
                <CascadingValue Value="HeaderMenuOrigins.For(Position, end)">@InBar(item)</CascadingValue>
            }
        }
        @if (Overflow.Count > 0)
        {
            @if (vertical && !HasSpacer)
            {
                <div class="cw-bar-spacer"></div>
            }
            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Dense="Density.Dense"
                     AnchorOrigin="@HeaderMenuOrigins.For(Position, true).Anchor" TransformOrigin="@HeaderMenuOrigins.For(Position, true).Transform"
                     aria-label="@L["More"]" data-testid="@(Second ? "app-bar-more-2" : "app-bar-more")">
                @foreach (var item in Overflow)
                {
                    @InMenu(item)
                }
            </MudMenu>
        }
    </text>;

    private RenderFragment InBar(HeaderItem item) => @<text>
        @switch (item.Id)
        {
            case HeaderItems.Search:
                <CoworkeeCommandPalette @ref="_palette" />
                break;
            case HeaderItems.Language:
                <LanguageMenu />
                break;
            case HeaderItems.Theme:
                <ThemeMenu />
                break;
            case HeaderItems.RightToLeft:
                <MudTooltip Text="@L["Right to left"]">
                    <MudIconButton Icon="@Icons.Material.Outlined.FormatTextdirectionRToL" Color="@(Preferences.RightToLeft ? Color.Warning : Color.Inherit)"
                                   OnClick="ToggleRightToLeftAsync" aria-label="@L["Right to left"]" data-testid="rtl-toggle" />
                </MudTooltip>
                break;
            case HeaderItems.DarkMode:
                <MudIconButton Icon="@(Dark ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)" Color="Color.Inherit" OnClick="ToggleDark" aria-label="@L["Dark mode"]" />
                break;
            case HeaderItems.Notifications:
                <AuthorizeView><Authorized><NotificationBell /></Authorized></AuthorizeView>
                break;
            case HeaderItems.Role:
                <AuthorizeView><Authorized><ActiveRoleMenu /></Authorized></AuthorizeView>
                break;
            case HeaderItems.User:
                <CoworkeeUserMenu />
                break;
            case HeaderItems.Assistant:
                <AuthorizeView><Authorized><AssistantLauncher InAppBar="true" /></Authorized></AuthorizeView>
                break;
            case HeaderItems.About:
                <MudIconButton Icon="@Icons.Material.Outlined.Info" Color="Color.Inherit" Size="Size.Small" OnClick="ShowAboutAsync" aria-label="@L["About"]" data-testid="about-button" />
                break;
            default:
                <DynamicComponent Type="item.App!.Component" Parameters="item.App.Parameters" />
                break;
        }
    </text>;

    private RenderFragment InMenu(HeaderItem item) => @<text>
        @switch (item.Id)
        {
            case HeaderItems.Search:
                <MudMenuItem Icon="@Icons.Material.Outlined.Search" OnClick="OpenSearchAsync" data-testid="header-search">@L["Search"]</MudMenuItem>
                break;
            case HeaderItems.Language:
                <LanguageMenu Nested="true" />
                break;
            case HeaderItems.Theme:
                <ThemeMenu Nested="true" />
                break;
            case HeaderItems.RightToLeft:
                <MudMenuItem Icon="@Icons.Material.Outlined.FormatTextdirectionRToL" OnClick="ToggleRightToLeftAsync" data-testid="rtl-toggle">@L["Right to left"]</MudMenuItem>
                break;
            case HeaderItems.DarkMode:
                <MudMenuItem Icon="@(Dark ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)" OnClick="ToggleDark">@L["Dark mode"]</MudMenuItem>
                break;
            case HeaderItems.Notifications:
                <AuthorizeView><Authorized>
                    <MudMenuItem Icon="@Icons.Material.Outlined.Notifications" Href="@Links.Href("/notifications")">@L["Notifications"]</MudMenuItem>
                </Authorized></AuthorizeView>
                break;
            case HeaderItems.Role:
                <AuthorizeView><Authorized><ActiveRoleMenu Nested="true" /></Authorized></AuthorizeView>
                break;
            case HeaderItems.Assistant:
                <AuthorizeView><Authorized><AssistantLauncher InAppBar="true" Nested="true" /></Authorized></AuthorizeView>
                break;
            case HeaderItems.About:
                <MudMenuItem Icon="@Icons.Material.Outlined.Info" OnClick="ShowAboutAsync" data-testid="about-button">@L["About"]</MudMenuItem>
                break;
            case var id when HeaderItems.IsSpacer(id):
                <MudDivider Class="my-1" />
                break;
            default:
                <DynamicComponent Type="item.App!.Component" Parameters="item.App.Parameters" />
                break;
        }
    </text>;
}
