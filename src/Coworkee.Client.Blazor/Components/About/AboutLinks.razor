@if (Options.AboutLinks.Count > 0)
{
    <MudStack Row="true" Wrap="Wrap.Wrap" Justify="Justify.Center" Spacing="2" data-testid="about-links">
        @foreach (var link in Options.AboutLinks)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Outlined.OpenInNew" Href="@link.Url" Target="_blank"
                       Style="border-radius: 999px">@L[link.Title]</MudButton>
        }
    </MudStack>
}
