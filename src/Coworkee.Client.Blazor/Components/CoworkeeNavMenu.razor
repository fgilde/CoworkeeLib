@using MudBlazor.Extensions.Components
@using MudBlazor.Extensions.Components.ObjectEdit
@using MudBlazor.Extensions.Core
@using MudBlazor.Extensions.Core.Enums
@using Nextended.Core.Types
@using Coworkee.Client.Blazor.Navigation

@if (!Mini && (Theme.CanPinNav || Theme.CanChangeNavExpandMode))
{
    <div class="d-flex justify-end align-center px-2 pt-1" style="position:relative;z-index:5" data-testid="nav-tools">
        @if (Theme.CanPinNav)
        {
            <MudTooltip Text="@L[Preferences.Pinned ? "Unpin" : "Pin"]">
                <MudToggleIconButton Toggled="Preferences.Pinned" ToggledChanged="Preferences.SetPinnedAsync" Size="Size.Small" ToggledSize="Size.Small"
                                     Icon="@Icons.Material.Outlined.PushPin" ToggledIcon="@Icons.Material.Filled.PushPin" ToggledColor="Color.Warning" aria-label="@L["Pin navigation"]" data-testid="nav-pin" />
            </MudTooltip>
        }
        @if (Theme.CanChangeNavExpandMode)
        {
            <MudTooltip Text="@L[SingleExpand ? "Expand many groups" : "Expand one group at a time"]">
                <MudToggleIconButton Toggled="SingleExpand" ToggledChanged="Preferences.SetSingleExpandAsync" Size="Size.Small" ToggledSize="Size.Small"
                                     Icon="@Icons.Material.Outlined.Expand" ToggledIcon="@Icons.Material.Outlined.UnfoldLess" ToggledColor="Color.Warning" aria-label="@L["Expand one group at a time"]" data-testid="nav-single-expand" />
            </MudTooltip>
        }
    </div>
}
@if (!Mini && ShowLogo && Theme.ShowLogoInNav)
{
    <div data-testid="nav-logo">
        <div class="d-flex justify-center mt-2 mb-3"><CoworkeeLogo Height="88" /></div>
        <MudDivider Class="mb-2" />
    </div>
}
@if (_entries is not null && Mini && Theme.NavMiniMode != Theming.NavMiniMode.Links)
{
    @* the first level only; a group opens its links in a menu next to it *@
    <div class="d-flex flex-column align-center gap-1 pt-1" data-testid="nav-mini-groups">
        @foreach (var entry in _entries)
        {
            if (entry.HasChildren)
            {
                <div data-nav-group-button="@entry.Text" data-activation="@(Theme.NavMiniMode == Theming.NavMiniMode.GroupsOnHover ? "hover" : "click")">
                    <MudMenu ActivationEvent="@(Theme.NavMiniMode == Theming.NavMiniMode.GroupsOnHover ? MouseEvent.MouseOver : MouseEvent.LeftClick)"
                             AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.TopLeft" Dense="true">
                        <ActivatorContent Context="menu">
                            <MudBadge Dot="true" Visible="@(GroupBadge(entry) > 0)" Color="Color.Secondary" Overlap="true">
                                <MudIconButton Icon="@(entry.Icon ?? Icons.Material.Outlined.Folder)" Size="Size.Small" Class="ml-1 mt-1" aria-label="@L[entry.Text]"
                                               OnClick="@(() => menu.ToggleAsync())"
                                               Color="@(Contains(entry, _selected) ? Color.Primary : Color.Default)" />
                            </MudBadge>
                        </ActivatorContent>
                        <ChildContent>
                            <MudText Typo="Typo.subtitle2" Class="px-4 pt-2 pb-1 mud-text-secondary">@L[entry.Text]</MudText>
                            @GroupItems(entry.Children!)
                        </ChildContent>
                    </MudMenu>
                </div>
            }
            else if (HasLink(entry))
            {
                @MiniLink(entry)
            }
        }
    </div>
}
else if (_entries is not null)
{
    <MudExTreeView T="NavigationEntry" Items="_entries"
                   SelectedNode="_selected" SelectedNodeChanged="SelectAsync"
                   SelectedItemBackgroundColor="@(_selected?.HasChildren == true || ViewMode != TreeViewMode.Default ? MudExColor.Default : MudExColor.HoverBackground)"
                   AllowedToSelectFunc="HasLink"
                   ItemContentStyle="font-size:14px;"
                   FilterChipsPlacedRight="true"
                   ExpandOnFilter="true"
                   FilterPlaceholder="@L["Filter"]"
                   FilterMode="@(Mini || !Theme.ShowNavFilter || ViewMode == TreeViewMode.Breadcrumb ? PropertyFilterMode.Disabled : PropertyFilterMode.AlwaysVisible)"
                   FilterBoxStyle="margin:10px;"
                   FilterBoxClass="cw-nav-filter"
                   Style="margin: 0 10px;"
                   TextFunc="@(entry => L[entry.Text])"
                   ExpandButtonDirection="LeftOrRight.Right"
                   ViewMode="ViewMode" ViewModeChanged="SetViewMode"
                   Parameters="TreeParameters"
                   ItemTemplate="@(Mini ? MiniItem : null)"
                   TreeViewModeToggleComponent="@(Mini ? TreeViewModeToggleComponent.None : TreeViewModeToggleComponent.ToggleButton)"
                   ToggleableViewModes="@(Mini ? [] : ToggleableViewModes)"
                   data-testid="nav-tree">
        <ItemContentTemplate>
            <div class="d-flex align-center" style="width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" data-nav="@context.Value?.Href" data-nav-group="@(context.Value?.HasChildren == true ? context.Value.Text : null)">
                @if (!string.IsNullOrWhiteSpace(context.Value?.Icon))
                {
                    <MudIcon Icon="@context.Value!.Icon" Class="ml-0 mr-2" Size="Size.Small" />
                }
                @context.TreeView.RenderItemContent(context)
                @if (Badges[context.Value?.Href] is > 0 and var count)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="ml-auto" data-nav-badge="@context.Value!.Href">@count</MudChip>
                }
            </div>
        </ItemContentTemplate>
    </MudExTreeView>
}

@code {
    private RenderFragment MiniItem(TreeViewItemContext<NavigationEntry> context) => @<text>
        @if (HasLink(context.Value))
        {
            @MiniLink(context.Value!)
        }
        else if (context.Value is { HasChildren: true, Parent: null } group && Theme.NavMiniDividers)
        {
            <MudDivider Class="my-1" data-nav-divider="@group.Text" />
        }
    </text>;

    private RenderFragment MiniLink(NavigationEntry entry) => @<MudTooltip Text="@L[entry.Text]" Placement="Placement.End">
        <MudBadge Content="@Badges[entry.Href]" Visible="@(Badges[entry.Href] > 0)" Color="Color.Secondary" Overlap="true" Max="99">
            <MudIconButton Icon="@entry.Icon" Size="Size.Small" Class="ml-1 mt-1" OnClick="() => SelectAsync(entry)" aria-label="@L[entry.Text]"
                           Color="@(entry == _selected ? Color.Primary : Color.Default)" data-nav="@entry.Href" />
        </MudBadge>
    </MudTooltip>;

    private RenderFragment GroupItems(IEnumerable<NavigationEntry> entries) => @<text>
        @foreach (var entry in entries)
        {
            if (entry.HasChildren)
            {
                <div data-nav-group="@entry.Text">
                    <MudMenu Label="@L[entry.Text]" StartIcon="@entry.Icon" Dense="true" AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.TopLeft">
                        @GroupItems(entry.Children!)
                    </MudMenu>
                </div>
            }
            else if (HasLink(entry))
            {
                <MudMenuItem Icon="@entry.Icon" OnClick="() => SelectAsync(entry)" data-nav="@entry.Href" Class="@(entry == _selected ? "mud-primary-text" : null)">
                    @L[entry.Text]
                    @if (Badges[entry.Href] is > 0 and var count)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="ml-2">@count</MudChip>
                    }
                </MudMenuItem>
            }
        }
    </text>;
}
