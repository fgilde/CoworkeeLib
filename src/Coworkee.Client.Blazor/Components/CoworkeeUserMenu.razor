<AuthorizeView>
    <Authorized>
        <ActiveRoleMenu />
        <ChatNotifier />
        <NotificationBell />
        @if (context.User.FindFirst(ImpersonationClaims.ImpersonatorName)?.Value is { } impersonator)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Outlined.SupervisorAccount" OnClick="StopImpersonation"
                     data-testid="impersonation">@L["Impersonated by {0}", impersonator]</MudChip>
        }
        <MudMenu Dense="Density.Dense" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" data-testid="user-menu">
            <ActivatorContent Context="menu">
                <MudButton Variant="Variant.Text" Color="Color.Inherit" Class="ml-2" Style="text-transform:none"
                           EndIcon="@Icons.Material.Filled.ArrowDropDown" aria-label="@L["Account"]" OnClick="@(() => menu.ToggleAsync())">
                    @if (ClientUser.From(context.User).UserId is { } me)
                    {
                        <UserAvatar UserId="me" Size="Size.Small" />
                    }
                    <span class="ml-2 cw-user-name">@context.User.Identity?.Name</span>
                </MudButton>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Href="@Links.Href("/profile")" Icon="@Icons.Material.Outlined.Badge">@L["My profile"]</MudMenuItem>
                <MudMenuItem Href="@Links.Href("/profile/settings")" Icon="@Icons.Material.Outlined.ManageAccounts">@L["My settings"]</MudMenuItem>
                @if (context.User.FindFirst("manage_url")?.Value is { } manage)
                {
                    <MudMenuItem Href="@manage" Target="_blank" Icon="@Icons.Material.Outlined.Security">@L["Password and security"]</MudMenuItem>
                }
                @if (Pwa.CanInstall)
                {
                    <MudMenuItem OnClick="() => Pwa.InstallAsync()" Icon="@Icons.Material.Outlined.InstallMobile" data-testid="install-app">@L["Install app"]</MudMenuItem>
                }
                <MudDivider />
                @if (context.User.HasClaim(c => c.Type == ImpersonationClaims.Impersonator))
                {
                    <MudMenuItem OnClick="StopImpersonation" Icon="@Icons.Material.Outlined.SupervisorAccount" data-testid="stop-impersonation">@L["Back to my account"]</MudMenuItem>
                }
                <MudMenuItem OnClick="LogoutAsync" Icon="@Icons.Material.Outlined.Logout">@L["Sign out"]</MudMenuItem>
            </ChildContent>
        </MudMenu>
    </Authorized>
    <NotAuthorized>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Small" Href="@SignInHref">@L["Sign in"]</MudButton>
    </NotAuthorized>
</AuthorizeView>
