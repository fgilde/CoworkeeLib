@inherits UserTabBase

<RealtimeSubscription Topic="@Coworkee.Contracts.Realtime.RealtimeTopics.TenantPermissions" OnEvent="_ => ReloadAsync()" />
<div data-testid="user-roles-tab">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
        <MudTextField T="string" Value="_filter" ValueChanged="Filter" Immediate="true" Placeholder="@L["Filter"]" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.FilterList"
                      Clearable="true" Margin="Density.Margin" Style="max-width:320px" data-testid="user-roles-filter" />
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="mud-text-secondary" data-testid="user-roles-count">@L["{0} of {1} assigned", _roles.Count(r => Has(r.Id)), _roles.Count]</MudText>
    </MudStack>
    <MudText Typo="Typo.caption" Class="d-block mb-2 mud-text-secondary" data-testid="user-roles-hint">
        @(_canManage ? L["Tick a role to give it to this user, untick it to take it away. Each click is saved at once."] : L["Read only: you may not change this."])
    </MudText>
    @if (!Loaded)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    <div style="max-height:60vh;overflow:auto" data-testid="user-roles-list">
        @{ var (assigned, others) = Parts(); }
        @if (assigned.Count > 0)
        {
            <MudText Typo="Typo.overline" Class="d-block mud-text-secondary">@L["Assigned"]</MudText>
            @foreach (var role in assigned)
            {
                @Item(role)
            }
        }
        @if (others.Count > 0)
        {
            <MudText Typo="Typo.overline" Class="@($"d-block mud-text-secondary{(assigned.Count > 0 ? " mt-2" : null)}")">@L["Other roles"]</MudText>
            @foreach (var role in others)
            {
                @Item(role)
            }
        }
        @if (Loaded && assigned.Count == 0 && others.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary pa-2">@L[string.IsNullOrWhiteSpace(_filter) ? "No roles." : "No role matches."]</MudText>
        }
    </div>
</div>

@code {
    private RenderFragment Item(RoleRefDto role) =>
        @<div class="d-flex align-center gap-1" data-role="@role.Id">
            <MudCheckBox T="bool" Value="Has(role.Id)" ValueChanged="on => Toggle(role, on)" Disabled="!_canManage" Label="@role.Name" Dense="true" Size="Size.Small" />
            @if (_toggles.IsSaving(role.Id))
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Style="width:14px;height:14px" />
            }
            <MudSpacer />
            @if (_canViewRoles)
            {
                <MudIconButton Href="@Links.Href($"/admin/roles/{role.Id}")" Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small" aria-label="@L["Open"]" />
            }
        </div>;
}
