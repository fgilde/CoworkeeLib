@inherits UserTabBase

<RealtimeSubscription Topic="@Coworkee.Contracts.Realtime.RealtimeTopics.TenantPermissions" OnEvent="_ => ReloadAsync()" />
<div data-testid="user-roles-tab">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
        <MudTextField @bind-Value="_filter" Immediate="true" Placeholder="@L["Filter"]" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.FilterList"
                      Clearable="true" Margin="Density.Margin" Style="max-width:320px" data-testid="user-roles-filter" />
        <MudSpacer />
        @if (_canManage)
        {
            <MudButton Variant="@(_picking ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="() => _picking = !_picking"
                       data-testid="user-roles-add">@L["Add role"]</MudButton>
        }
    </MudStack>
    @if (_picking)
    {
        <MudPaper Outlined="true" Class="pa-2 mb-2" data-testid="user-roles-picker">
            <MudTextField @bind-Value="_pickFilter" Immediate="true" Placeholder="@L["Search roles"]" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                          Clearable="true" Margin="Density.Margin" Class="mb-1" data-testid="user-roles-search" />
            <div style="max-height:280px;overflow:auto">
                @foreach (var role in _all.Where(r => Matches(r.Name, _pickFilter)))
                {
                    <MudCheckBox T="bool" Value="Has(role.Id)" ValueChanged="on => Toggle(role.Id, role.Name, on)" Label="@role.Name" Dense="true" Size="Size.Small"
                                 data-role-pick="@role.Id" />
                }
            </div>
        </MudPaper>
    }
    <MudTable T="RoleRefDto" Items="Rows()" Virtualize="true" FixedHeader="true" Height="360px" Dense="true" Hover="true" Loading="!Loaded" data-testid="user-roles-table">
        <HeaderContent>
            <MudTh>@L["Role"]</MudTh>
            <MudTh Style="width:56px" />
        </HeaderContent>
        <RowTemplate>
            <MudTd data-role="@context.Id">
                <MudLink Href="@Links.Href($"/admin/roles/{context.Id}")">@context.Name</MudLink>
                @if (_toggles.IsSaving(context.Id))
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ml-2" Style="width:14px;height:14px" />
                }
            </MudTd>
            <MudTd Style="text-align:right">
                @if (_canManage)
                {
                    <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" aria-label="@L["Remove"]" OnClick="() => Toggle(context.Id, context.Name, false)"
                                   data-remove-role="@context.Id" />
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>@L["No roles."]</NoRecordsContent>
    </MudTable>
</div>
