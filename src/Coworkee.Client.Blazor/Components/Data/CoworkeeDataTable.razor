@typeparam T
@attribute [CascadingTypeParameter(nameof(T))]

<style>
    .cw-table-panel { min-width: 300px; max-width: 360px; }
    .cw-table-panel-head { display: flex; align-items: center; gap: 4px; padding: 8px 12px 4px; }
    .cw-table-panel-hint { display: block; padding: 0 12px 6px; color: var(--mud-palette-text-secondary); }
    .cw-table-panel-foot { display: block; padding: 6px 12px 8px; text-align: center; color: var(--mud-palette-text-secondary); border-top: 1px solid var(--mud-palette-lines-default); }
    .cw-table-panel-list { max-height: 340px; overflow-y: auto; padding: 0 4px; }
    .cw-table-panel-item { display: flex; align-items: center; gap: 6px; padding: 2px 8px; border-radius: 8px; min-height: 34px; transition: background-color 120ms ease; }
    .cw-table-panel-item:hover { background: var(--mud-palette-action-default-hover); }
    .cw-table-panel-item.active { background: color-mix(in srgb, var(--mud-palette-primary) 12%, transparent); }
    .cw-table-panel-item .cw-drag { cursor: grab; opacity: .4; }
    .cw-table-panel-item:hover .cw-drag { opacity: 1; }
    .cw-table-panel-item .cw-view-actions { display: flex; opacity: .55; }
    .cw-table-panel-item:hover .cw-view-actions { opacity: 1; }
    .cw-clickable { cursor: pointer; }
    .cw-column-filter { min-width: 280px; max-width: 380px; }
    .cw-group-target { min-height: 34px; border: 1px dashed var(--mud-palette-lines-default); border-radius: 8px; margin: 0 8px 4px; }
    .cw-group-order { display: inline-grid; place-items: center; min-width: 20px; height: 20px; border-radius: 999px; font-size: .72rem; font-weight: 600;
        color: var(--mud-palette-primary-text); background: var(--mud-palette-primary); }
    .cw-group-row th { padding: 6px 8px !important; border-bottom: none !important; }
    .cw-group-zone { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; min-height: 38px; padding: 2px 10px; border-radius: 10px;
        border: 1.5px dashed var(--mud-palette-lines-default); transition: border-color 120ms ease, background-color 120ms ease;
        box-sizing: border-box; position: sticky; left: 8px; width: calc(100cqw - 16px); }
    .mud-table-container:has(.cw-group-zone) { container-type: inline-size; }
    .cw-group-zone.grouped { border-color: color-mix(in srgb, var(--mud-palette-primary) 35%, transparent); background: color-mix(in srgb, var(--mud-palette-primary) 5%, transparent); }
    .cw-group-zone.drop-allowed { border-color: var(--mud-palette-primary); background: color-mix(in srgb, var(--mud-palette-primary) 10%, transparent); }
    .cw-group-hint { font-weight: 400; font-size: .85rem; color: var(--mud-palette-text-secondary); }
    .cw-group-title { color: var(--mud-palette-text-secondary); }
    .cw-table-paneled { display: grid; grid-template-columns: minmax(240px, 300px) minmax(0, 1fr); gap: 16px; align-items: start; }
    .cw-table-facets { position: sticky; top: 72px; max-height: calc(100vh - 96px); overflow-y: auto; padding-right: 2px; }
    @@media (max-width: 960px) { .cw-table-paneled { grid-template-columns: 1fr; } .cw-table-facets { position: static; max-height: none; } }
    .cw-table-main { min-width: 0; }
    .cw-advanced { margin-bottom: 12px; padding: 12px; border-radius: 14px; border: 1px solid color-mix(in srgb, var(--mud-palette-primary) 30%, var(--mud-palette-lines-default));
        background: color-mix(in srgb, var(--mud-palette-primary) 2%, var(--mud-palette-surface)); }
    .cw-table-total { padding: 10px 16px; text-align: right; color: var(--mud-palette-text-secondary); font-size: .875rem; }
    .cw-table-hint { display: block; padding: 8px 16px 0; color: var(--mud-palette-text-secondary); }
    .cw-advanced-head { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
</style>
<FacetStyles />

<MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-1">
    @if (SearchFields.Count > 0)
    {
        <MudTextField T="string" Value="_search" ValueChanged="SearchAsync" Immediate="true" DebounceInterval="300" Placeholder="@L[SearchPlaceholder]"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Clearable="true" Variant="Variant.Outlined" Margin="Density.Margin"
                      Class="mr-2 mb-2" Style="max-width:320px" data-testid="table-search" />
    }
    @if (Facets && !PanelLayout)
    {
        <FacetBar Groups="_facets" Selection="_selection" Views="_facetViews" ViewsChanged="FacetViewsChanged" />
    }
    @if (ShowAdvanced)
    {
        <button type="button" class="@($"cw-facet-pill cw-advanced-pill mb-2 {(HasAdvanced ? "active" : string.Empty)}")" aria-expanded="@_advancedOpen"
                @onclick="() => _advancedOpen = !_advancedOpen" data-testid="advanced-filter">
            <MudIcon Icon="@Icons.Material.Outlined.AccountTree" Size="Size.Small" Class="cw-facet-pill-icon" />
            <span>@L["Advanced filter"]</span>
            @if (HasAdvanced)
            {
                <span class="cw-facet-badge">@_advanced.Rules().Count(QueryOperators.IsComplete)</span>
            }
            <MudIcon Icon="@(_advancedOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
        </button>
    }
    <MudSpacer />
    @ToolBarContent
    @foreach (var item in ToolbarItems)
    {
        <DynamicComponent Type="item.Component" Parameters="ToolbarParameters" />
    }
    @if (_grid is not null)
    {
        @if (Groupable)
        {
            <MudTooltip Text="@L["Group by"]">
                <DataTableGroupMenu T="T" Grid="_grid" GroupingChanged="GroupingChangedAsync" />
            </MudTooltip>
        }
        @if (ColumnChooser)
        {
            <MudTooltip Text="@L["Columns"]">
                <DataTableColumnChooser T="T" Grid="_grid" Changed="StateHasChanged" />
            </MudTooltip>
        }
    }
    @if (DensityToggle)
    {
        <MudTooltip Text="@(Dense ? L["Comfortable rows"] : L["Compact rows"])">
            <MudIconButton Icon="@(Dense ? Icons.Material.Outlined.DensityMedium : Icons.Material.Outlined.DensitySmall)" Size="Size.Small" Class="mb-2"
                           aria-label="@(Dense ? L["Comfortable rows"] : L["Compact rows"])" OnClick="() => _dense = !Dense" data-testid="density" />
        </MudTooltip>
    }
    @if (SavedViews)
    {
        <DataTableViewMenu Table="@EntitySet" Current="() => CurrentState" Link="ShareLink" OnApply="ApplyStateAsync" OnReset="() => ApplyStateAsync(DataTableState.Empty)"
                           @bind-Active="_activeView" />
    }
    @if (Importable && DataSource is null)
    {
        <PermissionGate Permission="@ImportPermission">
            <MudFileUpload @ref="_upload" T="IBrowserFile" Accept=".xlsx" FilesChanged="ImportAsync" Class="mb-2" data-testid="import">
                <CustomContent Context="upload">
                    <MudIconButton Icon="@Icons.Material.Outlined.FileUpload" Size="Size.Small" aria-label="@L["Import"]" Disabled="_importing" OnClick="upload.OpenFilePickerAsync" />
                </CustomContent>
                <SelectedTemplate />
            </MudFileUpload>
        </PermissionGate>
    }
    @if (Exportable)
    {
        <MudMenu Dense="Density.Dense" Icon="@Icons.Material.Outlined.FileDownload" Size="Size.Small" Class="mb-2" aria-label="@L["Export"]" data-testid="export">
            @if (DataSource is null)
            {
                <MudMenuItem OnClick="() => ExportAsync(ExportFormat.Excel)">Excel</MudMenuItem>
            }
            <MudMenuItem OnClick="() => ExportAsync(ExportFormat.Csv)">CSV</MudMenuItem>
            <MudMenuItem OnClick="() => ExportAsync(ExportFormat.Json)">JSON</MudMenuItem>
        </MudMenu>
    }
    @if (OnDelete is not null && MultiSelection && _selected.Count > 0)
    {
        <PermissionGate Permission="@DeletePermission">
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Delete" Size="Size.Small" Class="ml-2 mb-2"
                       OnClick="() => DeleteAsync(_selected.ToList())" data-testid="delete-selected">@L["Delete {0}", _selected.Count]</MudButton>
        </PermissionGate>
    }
    @if (OnCreate.HasDelegate)
    {
        <PermissionGate Permission="@CreatePermission">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" Class="ml-2 mb-2"
                       OnClick="CreateAsync" data-testid="create">@L[CreateText]</MudButton>
        </PermissionGate>
    }
</MudStack>
@if (ShowAdvanced && _advancedOpen)
{
    <div class="cw-advanced" data-testid="advanced-panel">
        <div class="cw-advanced-head">
            <MudIcon Icon="@Icons.Material.Outlined.AccountTree" Size="Size.Small" Color="Color.Primary" />
            <span class="cw-facet-title">@L["Advanced filter"]</span>
            @if (!_advanced.IsEmpty)
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" Class="cw-facet-clear" OnClick="() => AdvancedChangedAsync(new())" data-testid="advanced-clear">@L["Clear"]</MudButton>
            }
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-label="@L["Close"]" OnClick="() => _advancedOpen = false" />
        </div>
        <QueryBuilder Fields="Fields" Value="_advanced" ValueChanged="AdvancedChangedAsync" Localize="L10n" Dense="Dense" />
    </div>
}
<RealtimeSubscription Topic="@LiveTopic" OnEvent="_ => LiveChangedAsync()" />
<div class="@(PanelLayout ? "cw-table-layout cw-table-paneled" : "cw-table-layout")">
@if (PanelLayout)
{
    <aside class="cw-table-facets">
        <FacetPanel Groups="_facets" Selection="_selection" Views="_facetViews" ViewsChanged="FacetViewsChanged" />
    </aside>
}
<div class="cw-table-main">
<FacetChips Selection="_selection" Filters="FilterChips" OnRemove="RemoveFilterAsync" OnClear="ClearFilters" />
<MudDataGrid @ref="_grid" T="T" ServerData="PagedLoader" VirtualizeServerData="EndlessLoader" Virtualize="Endless" Height="@(Endless ? EndlessHeight : null)"
             FixedHeader="Endless" ItemSize="RowHeight" OverscanCount="10" MultiSelection="MultiSelection" SelectedItemsChanged="SelectionChangedAsync" RowsPerPage="PageSize"
             SortMode="SortMode.Multiple" Dense="Dense" Hover="true" Striped="@Theme.StripedTables" Elevation="0" Outlined="true" ChildRowContent="ChildRowContent"
             Groupable="Groupable" GroupExpanded="true" Hideable="ColumnChooser" DragDropColumnReordering="ReorderableColumns" ColumnReorderMode="DataGridDragAndDropColumnReorderMode.Insert"
             ColumnResizeMode="@(ResizableColumns ? ResizeMode.Column : ResizeMode.None)" Filterable="Filterable" FilterMode="DataGridFilterMode.ColumnFilterMenu"
             FilterChanged="ColumnFiltersChanged" data-testid="data-table">
    <Header>
        @if (Groupable && _grid is not null)
        {
            <DataTableGroupZone T="T" Grid="_grid" Droppable="ReorderableColumns" GroupingChanged="GroupingChangedAsync" />
        }
    </Header>
    <Columns>
        @if (ChildRowContent is not null)
        {
            <HierarchyColumn T="T" />
        }
        @if (MultiSelection)
        {
            <SelectColumn T="T" />
        }
        @Columns
        @if (OnEdit.HasDelegate || OnDelete is not null)
        {
            <TemplateColumn T="T" Sortable="false" Groupable="false" Filterable="false" Hideable="false" Resizable="false" DragAndDropEnabled="false" ShowColumnOptions="false"
                            CellStyle="text-align:right;white-space:nowrap">
                <CellTemplate Context="cell">
                    @if (OnEdit.HasDelegate)
                    {
                        <PermissionGate Permission="@EditPermission">
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" aria-label="@L["Edit"]" OnClick="() => EditAsync(cell.Item)" data-testid="edit-row" />
                        </PermissionGate>
                    }
                    @if (OnDelete is not null)
                    {
                        <PermissionGate Permission="@DeletePermission">
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" aria-label="@L["Delete"]" OnClick="() => DeleteAsync([cell.Item])" data-testid="delete-row" />
                        </PermissionGate>
                    }
                </CellTemplate>
            </TemplateColumn>
        }
    </Columns>
    <GroupTemplate Context="group">
        <span class="cw-group-title">@group.Title:</span>
        <strong class="mx-1" data-group-key="@group.Grouping.Key">@(group.Grouping.Key?.ToString() ?? L["(empty)"])</strong>
        <MudChip T="int" Size="Size.Small" Variant="Variant.Text">@group.Grouping.Count()</MudChip>
    </GroupTemplate>
    <NoRecordsContent>
        <MudText Class="mud-text-secondary pa-4">@L[NoRecordsText]</MudText>
    </NoRecordsContent>
    <PagerContent>
        @if (Endless)
        {
            <div class="cw-table-total" data-testid="table-total">@L["{0} rows", Pages.Total.ToString("N0", System.Globalization.CultureInfo.CurrentCulture)]</div>
        }
        else
        {
            @if (GroupedInPages)
            {
                <MudText Typo="Typo.caption" Class="cw-table-hint" data-testid="grouped-pages">@L["Grouped rows are shown in pages."]</MudText>
            }
            <MudDataGridPager T="T" />
        }
    </PagerContent>
</MudDataGrid>
</div>
</div>
