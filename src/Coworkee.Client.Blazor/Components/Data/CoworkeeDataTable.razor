@typeparam T
@attribute [CascadingTypeParameter(nameof(T))]

<MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-1">
    @if (SearchFields.Count > 0)
    {
        <MudTextField T="string" Value="_search" ValueChanged="SearchAsync" Immediate="true" DebounceInterval="300" Placeholder="@L[SearchPlaceholder]"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Class="mr-2 mb-2" Style="max-width:320px" data-testid="table-search" />
    }
    @if (Facets)
    {
        <FacetBar Groups="_facets" Selection="_selection" />
    }
    <MudSpacer />
    @ToolBarContent
    @if (SavedViews)
    {
        <MudMenu Icon="@Icons.Material.Outlined.BookmarkBorder" Size="Size.Small" Class="mb-2" aria-label="@L["Views"]" data-testid="views">
            @foreach (var view in _views)
            {
                <MudMenuItem OnClick="() => ApplyViewAsync(view)">
                    <div class="d-flex align-center" data-view="@view.Name">
                        <span style="flex:1">@view.Name</span>
                        <span @onclick:stopPropagation="true">
                            <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" aria-label="@L["Delete"]" OnClick="() => DeleteViewAsync(view)" />
                        </span>
                    </div>
                </MudMenuItem>
            }
            @if (_views.Count > 0)
            {
                <MudDivider />
            }
            <div class="d-flex align-center pa-2" @onclick:stopPropagation="true">
                <MudTextField T="string" @bind-Value="_viewName" Placeholder="@L["Save current view as"]" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                              data-testid="view-name" />
                <MudIconButton Icon="@Icons.Material.Outlined.Save" Size="Size.Small" Disabled="string.IsNullOrWhiteSpace(_viewName)" OnClick="SaveViewAsync"
                               aria-label="@L["Save"]" data-testid="save-view" />
            </div>
        </MudMenu>
    }
    @if (ColumnChooser && _grid is not null)
    {
        <MudMenu Icon="@Icons.Material.Outlined.ViewColumn" Size="Size.Small" Class="mb-2" aria-label="@L["Columns"]" data-testid="columns">
            @foreach (var column in _grid.RenderedColumns.Where(c => !string.IsNullOrEmpty(ColumnName(c))))
            {
                <MudMenuItem AutoClose="false" OnClick="() => ToggleColumnAsync(column)"
                             Icon="@(_hidden.Contains(ColumnName(column)!) ? Icons.Material.Outlined.CheckBoxOutlineBlank : Icons.Material.Outlined.CheckBox)">
                    <span data-column="@ColumnName(column)">@ColumnName(column)</span>
                </MudMenuItem>
            }
        </MudMenu>
    }
    @if (Importable)
    {
        <PermissionGate Permission="@ImportPermission">
            <MudFileUpload @ref="_upload" T="IBrowserFile" Accept=".xlsx" FilesChanged="ImportAsync" Class="mb-2" data-testid="import">
                <CustomContent Context="upload">
                    <MudIconButton Icon="@Icons.Material.Outlined.FileUpload" Size="Size.Small" aria-label="@L["Import"]" Disabled="_importing" OnClick="upload.OpenFilePickerAsync" />
                </CustomContent>
                <SelectedTemplate />
            </MudFileUpload>
        </PermissionGate>
    }
    @if (Exportable)
    {
        <MudMenu Icon="@Icons.Material.Outlined.FileDownload" Size="Size.Small" Class="mb-2" aria-label="@L["Export"]" data-testid="export">
            <MudMenuItem OnClick="() => ExportAsync(ExportFormat.Excel)">Excel</MudMenuItem>
            <MudMenuItem OnClick="() => ExportAsync(ExportFormat.Csv)">CSV</MudMenuItem>
            <MudMenuItem OnClick="() => ExportAsync(ExportFormat.Json)">JSON</MudMenuItem>
        </MudMenu>
    }
    @if (OnDelete is not null && MultiSelection && _selected.Count > 0)
    {
        <PermissionGate Permission="@DeletePermission">
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Delete" Size="Size.Small" Class="ml-2 mb-2"
                       OnClick="() => DeleteAsync(_selected.ToList())" data-testid="delete-selected">@L["Delete {0}", _selected.Count]</MudButton>
        </PermissionGate>
    }
    @if (OnCreate.HasDelegate)
    {
        <PermissionGate Permission="@CreatePermission">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" Class="ml-2 mb-2"
                       OnClick="CreateAsync" data-testid="create">@L[CreateText]</MudButton>
        </PermissionGate>
    }
</MudStack>
<FacetChips Selection="_selection" />
<MudDataGrid @ref="_grid" T="T" ServerData="LoadAsync" MultiSelection="MultiSelection" SelectedItemsChanged="SelectionChangedAsync" RowsPerPage="PageSize"
             SortMode="SortMode.Multiple" Dense="true" Hover="true" Striped="true" Elevation="0" Outlined="true" ChildRowContent="ChildRowContent" data-testid="data-table">
    <Columns>
        @if (ChildRowContent is not null)
        {
            <HierarchyColumn T="T" />
        }
        @if (MultiSelection)
        {
            <SelectColumn T="T" />
        }
        @Columns
        @if (OnEdit.HasDelegate || OnDelete is not null)
        {
            <TemplateColumn T="T" Sortable="false" CellStyle="text-align:right;white-space:nowrap">
                <CellTemplate Context="cell">
                    @if (OnEdit.HasDelegate)
                    {
                        <PermissionGate Permission="@EditPermission">
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" aria-label="@L["Edit"]" OnClick="() => EditAsync(cell.Item)" data-testid="edit-row" />
                        </PermissionGate>
                    }
                    @if (OnDelete is not null)
                    {
                        <PermissionGate Permission="@DeletePermission">
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" aria-label="@L["Delete"]" OnClick="() => DeleteAsync([cell.Item])" data-testid="delete-row" />
                        </PermissionGate>
                    }
                </CellTemplate>
            </TemplateColumn>
        }
    </Columns>
    <NoRecordsContent>
        <MudText Class="mud-text-secondary pa-4">@L[NoRecordsText]</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudDataGridPager T="T" />
    </PagerContent>
</MudDataGrid>
