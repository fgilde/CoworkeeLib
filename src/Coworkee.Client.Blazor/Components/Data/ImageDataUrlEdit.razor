@using MudBlazor.Extensions.Components
<MudStack Row="true" AlignItems="AlignItems.Center" Class="my-2" data-testid="image-edit">
    @if (!string.IsNullOrEmpty(Value))
    {
        <MudAvatar Size="Size.Large" Rounded="true"><MudImage Src="@Value" Alt="@Label" ObjectFit="ObjectFit.Cover" /></MudAvatar>
        @if (!ReadOnly)
        {
            <MudIconButton Icon="@Icons.Material.Outlined.Clear" Size="Size.Small" aria-label="@L["Remove image"]" OnClick="() => SetAsync(null)" />
        }
    }
    @if (!ReadOnly)
    {
        @* MudEx localizes the button text itself: a translated text would be looked up as key again and machine translated *@
        <MudExUploadEdit T="UploadableFile" UploadRequestDataLoaded="LoadAsync" ItemIsVisibleFunc="@(_ => false)" AllowMultiple="false" AllowFolderUpload="false" AllowExternalUrl="false"
                         MimeTypes="@MimeTypes" MaxFileSize="@MaxBytes" TextUploadFile="Choose image"
                         ButtonVariant="Variant.Outlined" ButtonColor="Color.Default" ExternalProviderRendering="ExternalProviderRendering.Images" ExternalPickerImageSize="@("30px")" />
    }
</MudStack>