@using MudBlazor.Extensions.Components
@inherits FacetViewBase

@if (_bounds is { } bounds)
{
    <FacetHistogram Buckets="Group.Options" IsActive="InRange" Title="BucketTitle" OnPick="Pick" Label="@L[Group.Label]" />
    <div class="cw-facet-slider" data-testid="facet-range-slider">
        <span id="@_labelId" hidden>@L[Group.Label]</span>
        <MudExRangeSlider T="decimal" SizeRange="Whole" Value="Chosen" StepLength="StepLength"
                          TrackColor="@("var(--mud-palette-lines-default)")" AriaLabelledBy="@_labelId"
                          ToStartStringFunc="r => Show(r.Start)" ToEndStringFunc="r => Show(r.End)" OnInput="Slide" OnChange="Slid" />
    </div>
    <div class="cw-facet-axis"><span>@Show(bounds.Min)</span><span>@Show(bounds.Max)</span></div>
    <div class="cw-facet-range-inputs">
        <MudNumericField T="decimal" Value="_from" ValueChanged="v => Typed(v, lower: true)" Min="bounds.Min" Max="_to" Label="@L["From"]" Format="0.##" Variant="Variant.Outlined"
                         Margin="Margin.Dense" HideSpinButtons="true" data-testid="facet-range-min" />
        <span class="cw-facet-range-dash">–</span>
        <MudNumericField T="decimal" Value="_to" ValueChanged="v => Typed(v, lower: false)" Min="_from" Max="bounds.Max" Label="@L["Up to"]" Format="0.##" Variant="Variant.Outlined"
                         Margin="Margin.Dense" HideSpinButtons="true" data-testid="facet-range-max" />
    </div>
}
else
{
    <MudText Typo="Typo.caption" Class="cw-facet-empty">@L["Nothing found."]</MudText>
}
