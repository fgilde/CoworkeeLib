@inherits FacetViewBase

<MudSelect T="string" @attributes="Binding" Placeholder="@L["Choose"]" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true"
           data-testid="facet-select">
    @foreach (var option in Group.Options)
    {
        <MudSelectItem T="string" Value="option.OData" Disabled="IsDisabled(option)">
            <span class="d-flex align-center gap-2 w-100" data-option="@option.OData">
                <span class="flex-grow-1">@Label(option)</span>
                <span class="cw-facet-count">@Count(option.Count)</span>
            </span>
        </MudSelectItem>
    }
</MudSelect>
