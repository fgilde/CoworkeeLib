<FacetStyles />
<div class="cw-facets" data-testid="facet-bar">
    @foreach (var group in Groups.OrderBy(g => g.Order))
    {
        var chosen = Selection.Of(group.Key).ToList();
        <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" PopoverClass="cw-facet-popover" data-facet="@group.Key">
            <ActivatorContent Context="menu">
                <button type="button" class="@($"cw-facet-pill {(chosen.Count > 0 ? "active" : string.Empty)}")" aria-haspopup="true" data-testid="facet-button"
                        @onclick="menu.ToggleAsync">
                    <MudIcon Icon="@Icon(group)" Size="Size.Small" Class="cw-facet-pill-icon" />
                    <span>@L[group.Label]</span>
                    @if (chosen.Count > 0)
                    {
                        <span class="cw-facet-value">@Summary(chosen)</span>
                        @if (chosen.Count > 1)
                        {
                            <span class="cw-facet-badge">@chosen.Count</span>
                        }
                    }
                    <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" />
                </button>
            </ActivatorContent>
            <ChildContent>
                <div class="cw-facet-card" @onclick:stopPropagation="true">
                    <FacetGroupView Group="group" Selection="Selection" View="ViewOf(group)" ViewChanged="v => SetViewAsync(group, v)" />
                </div>
            </ChildContent>
        </MudMenu>
    }
</div>
