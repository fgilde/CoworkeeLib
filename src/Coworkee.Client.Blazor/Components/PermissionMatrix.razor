
@if (_groups is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
        <MudTextField @bind-Value="_search" Immediate="true" Placeholder="Search permissions" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                      Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="permission-search" Style="max-width:360px" />
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="mud-text-secondary" data-testid="total-count">@_selected.Count(Known) of @_groups.Sum(g => g.Permissions.Count) granted</MudText>
    </MudStack>

    @foreach (var group in Visible())
    {
        var all = group.Permissions.All(p => _selected.Contains(p.Name));
        <div data-group="@group.Name" class="mt-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                @if (!ReadOnly)
                {
                    <input type="checkbox" checked="@all" aria-label="@($"All of {group.DisplayName}")" data-testid="group-all" @onchange="e => ToggleGroup(group, e.Value is true)" />
                }
                <MudText Typo="Typo.subtitle2">@group.DisplayName</MudText>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(all ? Color.Primary : Color.Default)" data-testid="group-count">@group.Permissions.Count(p => _selected.Contains(p.Name)) / @group.Permissions.Count</MudChip>
            </MudStack>
            <MudSimpleTable Dense="true" Hover="true" Bordered="false" Class="mb-2">
                <tbody>
                    @foreach (var permission in group.Permissions.Where(Matches))
                    {
                        <tr data-permission="@permission.Name">
                            <td style="width:48px">
                                <input type="checkbox" checked="@_selected.Contains(permission.Name)" disabled="@ReadOnly" aria-label="@permission.DisplayName"
                                       @onchange="e => Toggle(permission.Name, e.Value is true)" />
                            </td>
                            <td>@permission.DisplayName</td>
                            <td><MudText Typo="Typo.caption">@permission.Name</MudText></td>
                            <td>
                                @if (permission.Implies.Count > 0)
                                {
                                    <MudText Typo="Typo.caption">includes @string.Join(", ", permission.Implies)</MudText>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </div>
    }

    @if (!ReadOnly)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving" data-testid="save-permissions">Save</MudButton>
    }
}
