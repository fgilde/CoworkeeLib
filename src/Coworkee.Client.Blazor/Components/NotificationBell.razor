@using System.Security.Claims
@using Coworkee.Client.Blazor.Realtime
@using Coworkee.Contracts.Notifications
@using Coworkee.Contracts.Realtime

<MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" OpenChanged="OpenChangedAsync">
    <ActivatorContent Context="menu">
        <MudBadge Content="@_count" Visible="@(_count > 0)" Color="Color.Secondary" Overlap="true">
            <MudIconButton Icon="@Icons.Material.Outlined.Notifications" Color="Color.Inherit" aria-label="Notifications" OnClick="@(() => menu.ToggleAsync())" />
        </MudBadge>
        <span data-testid="unread" style="display:none">@_count</span>
    </ActivatorContent>
    <ChildContent>
        @if (_items.Count == 0)
        {
            <MudMenuItem Disabled="true">No notifications</MudMenuItem>
        }
        @foreach (var item in _items)
        {
            <MudMenuItem OnClick="() => OpenAsync(item)">
                <MudText Typo="Typo.body2" Style="@(item.ReadAt is null ? "font-weight:600" : null)">@L.Server(item.Title, item.Arguments)</MudText>
                @if (item.Body is not null)
                {
                    <MudText Typo="Typo.caption">@L.Server(item.Body, item.Arguments)</MudText>
                }
            </MudMenuItem>
        }
        <MudDivider />
        @if (_count > 0)
        {
            <MudMenuItem OnClick="MarkAllAsync">Mark all as read</MudMenuItem>
        }
        <MudMenuItem Href="/notifications" Icon="@Icons.Material.Outlined.List">All notifications</MudMenuItem>
    </ChildContent>
</MudMenu>
