@using Coworkee.Client.Blazor.Components.Mail

@if (_template is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudChip T="string" Size="Size.Small" Color="@(_template.IsOverridden ? Color.Secondary : Color.Default)" data-testid="template-state">@(_template.IsCustom ? L["custom"] : _template.IsOverridden ? L["customized"] : L["default"])</MudChip>
        <MudSpacer />
        <MudButton OnClick="PreviewAsync" data-testid="preview">@L["Preview"]</MudButton>
        <MudButton OnClick="SendTestAsync" data-testid="send-test">@L["Send test to me"]</MudButton>
        @if (!_template.IsCustom)
        {
            <MudButton OnClick="ResetAsync" Disabled="@(!_template.IsOverridden)" data-testid="reset-template">@L["Reset to default"]</MudButton>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" data-testid="save-template">@L["Save"]</MudButton>
    </MudStack>

    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudTextField Margin="Density.Margin" @bind-Value="_subject" Label="@L["Subject"]" Immediate="true" />
        <MudMenu Icon="@Icons.Material.Outlined.DataObject" Size="Size.Small" AriaLabel="@L["Insert placeholder"]" data-testid="subject-placeholders">
            @foreach (var variable in _template.Variables.Where(v => !v.IsList && !v.IsItem()))
            {
                <MudMenuItem OnClick="() => AddToSubject(variable)" data-testid="@($"subject-variable-{variable.Name}")">@variable.Name</MudMenuItem>
            }
        </MudMenu>
    </MudStack>
    <MailBodyEditor @bind-Value="_body" Variables="_template.Variables" />
    <MudText Typo="Typo.caption">@L["Placeholders look like {{ user.first_name }} and are HTML escaped. The body is placed inside the Layout template."]</MudText>

    @if (_errors.Count > 0)
    {
        <MudAlert Dense="Density.Dense" Severity="Severity.Error" Class="mt-3" data-testid="template-errors">
            @foreach (var error in _errors)
            {
                <div>@error</div>
            }
        </MudAlert>
    }

    @if (_preview is not null)
    {
        <MudText Typo="Typo.overline" Class="mt-4 d-block">@L["Preview: {0}", _preview.Subject]</MudText>
        <iframe data-testid="preview-frame" sandbox="" srcdoc="@_preview.HtmlBody" title="@L["Preview"]" style="width:100%;height:480px;border:1px solid var(--mud-palette-lines-default);background:#fff"></iframe>
    }
}
