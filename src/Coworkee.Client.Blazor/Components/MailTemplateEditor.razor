
@if (_template is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudChip T="string" Size="Size.Small" Color="@(_template.IsOverridden ? Color.Secondary : Color.Default)">@(_template.IsOverridden ? "customized" : "default")</MudChip>
        <MudSpacer />
        <MudButton OnClick="PreviewAsync" data-testid="preview">Preview</MudButton>
        <MudButton OnClick="SendTestAsync" data-testid="send-test">Send test to me</MudButton>
        <MudButton OnClick="ResetAsync" Disabled="@(!_template.IsOverridden)" data-testid="reset-template">Reset to default</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" data-testid="save-template">Save</MudButton>
    </MudStack>

    <MudTextField Margin="Density.Margin" @bind-Value="_subject" Label="Subject" />
    <MudTextField Margin="Density.Margin" @bind-Value="_body" Label="Body (Scriban, HTML)" Lines="16" Class="mt-2" Style="font-family:monospace" />
    <MudText Typo="Typo.caption">Model values are available as {{ user.first_name }} and are HTML escaped. The body is placed inside the Layout template.</MudText>

    @if (_errors.Count > 0)
    {
        <MudAlert Dense="Density.Dense" Severity="Severity.Error" Class="mt-3" data-testid="template-errors">
            @foreach (var error in _errors)
            {
                <div>@error</div>
            }
        </MudAlert>
    }

    @if (_preview is not null)
    {
        <MudText Typo="Typo.overline" Class="mt-4 d-block">Preview: @_preview.Subject</MudText>
        <iframe data-testid="preview-frame" sandbox="" srcdoc="@_preview.HtmlBody" title="Mail preview" style="width:100%;height:480px;border:1px solid var(--mud-palette-lines-default);background:#fff"></iframe>
    }
}
