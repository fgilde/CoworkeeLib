@* the loading screen waits for this shell to hide it once the theme is applied *@
<span data-coworkee-loading-claim hidden></span>
@if (!_visible)
{
    return;
}
<MudThemeProvider @ref="_provider" Theme="CurrentTheme" IsDarkMode="Dark" />
@if (Theme is null && ThemeService.CustomCss is { Length: > 0 } css)
{
    <style>@css</style>
}
<style>@Layout.ShellStyles.Css</style>
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<SessionGuard />
@ChildContent?.Invoke(this)
<AuthorizeView>
    <Authorized><SettingsLiveUpdates /></Authorized>
</AuthorizeView>
