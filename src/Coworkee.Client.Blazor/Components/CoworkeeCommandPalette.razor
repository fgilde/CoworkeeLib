@using Coworkee.Client.Blazor.CommandPalette

<style>
    .cw-palette-trigger { display: inline-flex; align-items: center; gap: 6px; height: 34px; padding: 0 10px; margin: 0 6px; border-radius: 8px; cursor: pointer; font: inherit; font-size: .875rem;
        color: inherit; background: color-mix(in srgb, currentColor 10%, transparent); border: 1px solid color-mix(in srgb, currentColor 22%, transparent); }
    .cw-palette-trigger:hover { background: color-mix(in srgb, currentColor 16%, transparent); }
    .cw-palette-kbd { font-family: inherit; font-size: .72rem; padding: 1px 5px; border-radius: 4px; border: 1px solid color-mix(in srgb, currentColor 30%, transparent); opacity: .8; }
    @@media (max-width: 600px) { .cw-palette-trigger { padding: 0 8px; } .cw-palette-trigger-text, .cw-palette-trigger .cw-palette-kbd { display: none; } }
    .cw-palette-backdrop { position: fixed; inset: 0; z-index: 1450; background: rgba(0, 0, 0, .35); }
    .cw-palette { position: fixed; top: 12vh; left: 50%; transform: translateX(-50%); width: min(640px, calc(100vw - 24px)); max-height: 70vh; display: flex; flex-direction: column;
        border-radius: 14px; overflow: hidden; background: var(--mud-palette-surface); color: var(--mud-palette-text-primary); box-shadow: var(--mud-elevation-24); }
    @@media (max-width: 600px) { .cw-palette { top: 8px; max-height: calc(100dvh - 16px); } }
    .cw-palette-head { display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-bottom: 1px solid var(--mud-palette-lines-default); }
    .cw-palette-input { flex: 1; border: none; outline: none; background: transparent; color: inherit; font: inherit; font-size: 1.05rem; min-width: 0; padding: 6px 0; }
    .cw-palette-list { overflow-y: auto; padding: 6px; }
    .cw-palette-group { padding: 8px 10px 4px; font-size: .72rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--mud-palette-text-secondary); }
    .cw-palette-item { display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 6px 10px; border-radius: 8px; cursor: pointer; }
    .cw-palette-item.active { background: color-mix(in srgb, var(--mud-palette-primary) 14%, transparent); }
    .cw-palette-item mark { background: none; color: var(--mud-palette-primary); font-weight: 600; }
    .cw-palette-sub { font-size: .78rem; color: var(--mud-palette-text-secondary); }
    .cw-palette-empty { padding: 18px; text-align: center; color: var(--mud-palette-text-secondary); }
    .cw-palette-foot { display: flex; gap: 14px; padding: 8px 14px; font-size: .75rem; color: var(--mud-palette-text-secondary); border-top: 1px solid var(--mud-palette-lines-default); }
    @@media (max-width: 600px) { .cw-palette-foot { display: none; } }
</style>

<MudTooltip Text="@L["Search (Ctrl+K)"]">
    <button type="button" class="cw-palette-trigger" @onclick="OpenAsync" aria-label="@L["Search"]" aria-haspopup="dialog" data-testid="palette-button">
        <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" />
        <span class="cw-palette-trigger-text">@L["Search"]</span>
        <kbd class="cw-palette-kbd">Ctrl K</kbd>
    </button>
</MudTooltip>

@if (_open)
{
    <div class="cw-palette-backdrop" @onclick="Close" data-testid="palette-backdrop"></div>
    <div class="cw-palette" role="dialog" aria-modal="true" aria-label="@L["Command palette"]" data-testid="palette">
        <div class="cw-palette-head">
            <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" Class="mud-text-secondary" />
            <input @ref="_input" class="cw-palette-input" value="@_query" @oninput="QueryChangedAsync" @onkeydown="KeyAsync" placeholder="@L["Search pages, records and actions"]"
                   role="combobox" aria-expanded="true" aria-controls="cw-palette-list" aria-activedescendant="@($"cw-palette-item-{_active}")" autocomplete="off" spellcheck="false"
                   data-testid="palette-input" />
            <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" aria-label="@L["Close"]" OnClick="Close" />
        </div>
        @if (_streaming)
        {
            <MudProgressLinear Indeterminate="true" Size="Size.Small" Color="Color.Primary" data-testid="palette-streaming" />
        }
        <div id="cw-palette-list" class="cw-palette-list" role="listbox" aria-busy="@(_streaming ? "true" : "false")">
            @if (_hits.Count == 0)
            {
                <div class="cw-palette-empty" data-testid="palette-empty">@(_searching || _streaming ? L["Searching…"] : L["Nothing found."])</div>
            }
            @foreach (var group in _hits.GroupBy(h => h.Item.Group))
            {
                <div class="cw-palette-group" role="presentation">@L[group.Key]</div>
                @foreach (var hit in group)
                {
                    var index = _hits.IndexOf(hit);
                    <div id="@($"cw-palette-item-{index}")" class="@(index == _active ? "cw-palette-item active" : "cw-palette-item")" role="option" aria-selected="@(index == _active ? "true" : "false")"
                         @onclick="() => RunAsync(hit.Item)" @onmousemove="() => Hover(index)" data-testid="palette-item" data-group="@group.Key">
                        @if (hit.Item.Icon is { } icon)
                        {
                            <MudIcon Icon="@icon" Size="Size.Small" Class="mud-text-secondary" />
                        }
                        <div style="min-width:0">
                            <div class="cw-palette-title">@Highlight(hit)</div>
                            @if (hit.Item.Subtitle is { Length: > 0 } subtitle)
                            {
                                <div class="cw-palette-sub">@subtitle</div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
        <div class="cw-palette-foot">
            <span><kbd class="cw-palette-kbd">↑</kbd> <kbd class="cw-palette-kbd">↓</kbd> @L["to move"]</span>
            <span><kbd class="cw-palette-kbd">Enter</kbd> @L["to open"]</span>
            <span><kbd class="cw-palette-kbd">Esc</kbd> @L["to close"]</span>
        </div>
    </div>
}

@code {
    internal static RenderFragment Highlight(PaletteHit hit) => builder =>
    {
        var title = hit.Item.Title;
        var marked = hit.Positions.ToHashSet();
        var start = 0;
        for (var i = 0; i <= title.Length; i++)
        {
            if (i < title.Length && marked.Contains(i) == marked.Contains(start))
            {
                continue;
            }

            if (marked.Contains(start))
            {
                builder.OpenElement(0, "mark");
                builder.AddContent(1, title[start..i]);
                builder.CloseElement();
            }
            else
            {
                builder.AddContent(2, title[start..i]);
            }

            start = i;
        }
    };
}
