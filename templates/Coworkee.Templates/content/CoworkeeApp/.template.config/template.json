        "pattern": "(^|,)\\s*zh(-(Hans(-CN|-SG)?|CN|SG))?\\s*(,|$)"
      }
    },
    "customLanguages": {
      "type": "computed",
      "value": "(languages != \"\" || defaultLanguage != \"en\")"
    },
    "translationProvider": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "libreTranslate",
      "description": "Translation service for the texts a language lacks; changeable later in the settings (Translation).",
      "choices": [
        {
          "choice": "libreTranslate",
          "description": "LibreTranslate container in the app host, free and without an account."
        },
        {
          "choice": "myMemory",
          "description": "MyMemory public service, free without an account, small daily quota."
        },
        {
          "choice": "deepL",
          "description": "DeepL API (key in the user secrets: Parameters:translation-key)."
        },
        {
          "choice": "azure",
          "description": "Azure AI Translator (Parameters:translation-key and translation-region)."
        },
        {
          "choice": "google",
          "description": "Google Cloud Translation (Parameters:translation-key)."
        },
        {
          "choice": "ai",
          "description": "The model of the AI assistant."
        },
        {
          "choice": "none",
          "description": "No machine translation."
        }
      ],
      "replaces": "COWORKEE_TRANSLATION_PROVIDER"
    },
    "translationSource": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "en",
      "description": "Language machine translations start from.",
      "choices": [
        {
          "choice": "en",
          "description": "English."
        },
        {
          "choice": "de",
          "description": "Deutsch."
        }
      ],
      "replaces": "COWORKEE_TRANSLATION_SOURCE"
    },
    "colorMode": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "system",
      "description": "Default color mode, seeded as system wide setting.",
      "choices": [
        {
          "choice": "system",
          "description": "Follow the operating system."
        },
        {
          "choice": "light",
          "description": "Always light."
        },
        {
          "choice": "dark",
          "description": "Always dark."
        }
      ],
      "replaces": "COWORKEE_COLOR_MODE"
    },
    "registration": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Allow self registration on the sign-in page (seeded setting Account.AllowRegistration)."
    },
    "githubActions": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "GitHub Actions workflow that builds and tests the solution."
    },
    "devcontainer": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Dev container with the .NET SDK and Docker in Docker."
    },
    "repository": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "description": "GitHub repository of the app as owner/repo; the README gets a QuickRun badge.",
      "replaces": "COWORKEE_REPOSITORY"
    },
    "appTitle": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "title",
        "fallbackVariableName": "name"
      },
      "replaces": "COWORKEE_APP_TITLE"
    },
    "seedPassword": {
      "type": "generated",
      "generator": "guid",
      "parameters": {
        "defaultFormat": "N"
      },
      "replaces": "SEED_PASSWORD"
    },
    "themeName": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "theme",
        "steps": [
          {
            "regex": "HighContrast",
            "replacement": "High Contrast"
          }
        ]
      },
      "replaces": "COWORKEE_THEME"
    },
    "hasRepository": {
      "type": "computed",
      "value": "(repository != \"\")"
    },
    "hasPrimary": {
      "type": "computed",
      "value": "(primaryColor != \"\")"
    },
    "hasSecondary": {
      "type": "computed",
      "value": "(secondaryColor != \"\")"
    },
    "brandColors": {
      "type": "computed",
      "value": "(primaryColor != \"\" || secondaryColor != \"\")"
    },
    "customTheme": {
      "type": "computed",
      "value": "(theme != \"Ocean\" || primaryColor != \"\" || secondaryColor != \"\")"
    },
    "customLogo": {
      "type": "computed",
      "value": "(logo != \"coworkee-icon.svg\")"
    },
    "customSignIn": {
      "type": "computed",
      "value": "(signInLayout != \"Slide\" || signInMedia != \"\" || signInMediaSide != \"Left\")"
    },
    "defaultModel": {
      "type": "computed",
      "value": "(database == \"postgres\" && ai && chat && reports && backup && notifications && !files && !features && !social && eventBus == \"none\" && (samples || !extendedAttributes))"
    }
  },
