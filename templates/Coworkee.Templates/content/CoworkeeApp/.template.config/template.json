{
  "$schema": "http://json.schemastore.org/template",
  "author": "fgilde",
  "classifications": [
    "Web",
    "Blazor",
    "Aspire",
    "Coworkee"
  ],
  "identity": "Coworkee.Templates.App",
  "groupIdentity": "Coworkee.App",
  "name": "Coworkee application",
  "description": "Aspire app host, API, auth server, Blazor WebAssembly with BFF and Postgres, SQL Server or SQLite, built on the Coworkee packages.",
  "shortName": [
    "coworkee",
    "coworkee-app"
  ],
  "sourceName": "MyApp",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "samples": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include the Catalog and Documents sample modules."
    },
    "keycloak": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Add a Keycloak container as external sign-in."
    },
    "tests": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include the test projects."
    },
    "title": {
      "type": "parameter",
      "datatype": "string",
      "description": "Display title of the app (default: the name)."
    },
    "auditing": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Audit log pages (Coworkee.Auditing)."
    },
    "notifications": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "In-app notifications with mail digests (Coworkee.Notifications)."
    },
    "chat": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Direct and group chat (Coworkee.Chat)."
    },
    "reports": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Reports and dashboards over the OData entity sets (Coworkee.Reporting)."
    },
    "ai": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "AI assistant, MCP endpoint and tool call audit (Coworkee.Ai)."
    },
    "backup": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Database backups from the admin pages (Coworkee.Backup)."
    },
    "files": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Folders and files of the organisation with preview (Coworkee.Files)."
    },
    "features": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Features, editions and tenant administration (Coworkee.Features)."
    },
    "social": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Comments, tags and ratings for entities (Coworkee.Social)."
    },
    "extendedAttributes": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Free key/value attributes for entities (Coworkee.ExtendedAttributes); the Documents sample brings it anyway."
    },
    "elasticsearch": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Elasticsearch index with a container in the app host (Coworkee.Search.Elasticsearch)."
    },
    "eventBus": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "none",
      "description": "Integration events between services (Coworkee.EventBus).",
      "choices": [
        {
          "choice": "none",
          "description": "No event bus."
        },
        {
          "choice": "inProcess",
          "description": "Outbox and inbox, handlers in this app."
        },
        {
          "choice": "rabbitMq",
          "description": "RabbitMQ transport with a container in the app host."
        }
      ]
    },
    "clientEntities": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Client entities: the browser keeps copies of OData sets (Coworkee.Client.Blazor.ClientEntities)."
    },
    "storage": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "fileSystem",
      "description": "Blob storage provider.",
      "choices": [
        {
          "choice": "fileSystem",
          "description": "Folder .data/blobs next to src."
        },
        {
          "choice": "azureBlob",
          "description": "Azure Blob Storage, Azurite emulator in the app host."
        }
      ]
    },
    "aiProvider": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "anthropic",
      "description": "Model provider of the AI assistant.",
      "choices": [
        {
          "choice": "anthropic",
          "description": "Claude through the Anthropic API."
        },
        {
          "choice": "openAI",
          "description": "GPT models through the OpenAI API."
        },
        {
          "choice": "azureOpenAI",
          "description": "A deployment of Azure OpenAI."
        },
        {
          "choice": "gemini",
          "description": "Google Gemini through its OpenAI compatible API."
        },
        {
          "choice": "openRouter",
          "description": "Many models behind one OpenRouter key."
        },
        {
          "choice": "mistral",
          "description": "Mistral models, hosted in the EU."
        },
        {
          "choice": "groq",
          "description": "Open models on Groq."
        },
        {
          "choice": "deepSeek",
          "description": "DeepSeek models."
        },
        {
          "choice": "xai",
          "description": "Grok models of xAI."
        },
        {
          "choice": "together",
          "description": "Open models on Together AI."
        },
        {
          "choice": "fireworks",
          "description": "Open models on Fireworks AI."
        },
        {
          "choice": "ollama",
          "description": "Local models, Ollama container in the app host."
        },
        {
          "choice": "lmStudio",
          "description": "Local models of the LM Studio app on this machine."
        },
        {
          "choice": "openAICompatible",
          "description": "Any endpoint that speaks the OpenAI chat API."
        }
      ],
      "replaces": "COWORKEE_AI_PROVIDER"
    },
    "aiModel": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "description": "Model of the AI provider (Azure OpenAI: the deployment name); empty takes the provider's default.",
      "replaces": "COWORKEE_AI_MODEL"
    },
    "aiEndpoint": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "description": "Base address of the AI provider; empty takes the provider's address.",
      "replaces": "COWORKEE_AI_ENDPOINT"
    },
    "redis": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Redis container: SignalR backplane, shared presence, cache invalidation and sign-in sessions across instances."
    },
    "grafana": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Grafana with Prometheus, Loki, Tempo and an OpenTelemetry collector: metrics, logs, traces and dashboards (development)."
    },
    "webDataStudio": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "WebDataStudio, a database studio in the browser connected to the app database (development)."
    },
    "aspireUI": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "AspireUI, a web UI to host and try more apps and stacks next to the app; with Keycloak it signs in through the app's realm (development)."
    },
    "airworks": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "AirWorks web desktop as a second client next to the Blazor app: same sign-in, same api, apps for settings, files, data and notifications (needs Node.js)."
    },
    "npmPackages": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "registry",
      "description": "Where the AirWorks client takes @coworkee/client and @coworkee/airworks from: npm in the version of this template, or the tarballs inside the template (local template builds; coworkee new --template-source picks it).",
      "choices": [
        { "choice": "registry", "description": "npm, the version of this template." },
        { "choice": "vendor", "description": "The tarballs inside the template." }
      ]
    },
    "database": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "postgres",
      "description": "Database engine; the shipped migration is made for Postgres, coworkee new adds the one for the others.",
      "choices": [
        {
          "choice": "postgres",
          "description": "PostgreSQL container in the app host."
        },
        {
          "choice": "sqlServer",
          "description": "SQL Server container in the app host."
        },
        {
          "choice": "sqlite",
          "description": "SQLite file .data/<name>.db, no container."
        }
      ]
    },
    "withBackup": {
      "type": "computed",
      "value": "(backup && database == \"postgres\")"
    },
    "theme": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "Ocean",
      "description": "Default theme.",
      "choices": [
        {
          "choice": "Ocean",
          "description": "Blue, humanist font, rounded."
        },
        {
          "choice": "Coworkee",
          "description": "Warm orange on paper."
        },
        {
          "choice": "Classic",
          "description": "MudBlazor purple."
        },
        {
          "choice": "Forest",
          "description": "Green with serif headings."
        },
        {
          "choice": "Midnight",
          "description": "Indigo, monospace headings."
        },
        {
          "choice": "Sunset",
          "description": "Pink, rounded, roomy."
        },
        {
          "choice": "HighContrast",
          "description": "Black and white, no shadows."
        }
      ]
    },
    "primaryColor": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "description": "Primary brand color (#rrggbb); with a brand color the app gets its own theme, based on the chosen one, as default.",
      "replaces": "COWORKEE_PRIMARY"
    },
    "secondaryColor": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "description": "Secondary brand color (#rrggbb).",
      "replaces": "COWORKEE_SECONDARY"
    },
    "logo": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "coworkee-icon.svg",
      "description": "Logo file name in the wwwroot of the web client (copy the file there; coworkee new --logo does).",
      "replaces": "coworkee-icon.svg"
    },
    "signInLayout": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "Slide",
      "description": "Layout of the sign-in pages.",
      "choices": [
        {
          "choice": "Card",
          "description": "A centered card."
        },
        {
          "choice": "Split",
          "description": "Image or video on one side, the form on the other."
        },
        {
          "choice": "Slide",
          "description": "A colored panel next to the form."
        }
      ],
      "replaces": "COWORKEE_SIGNIN_LAYOUT"
    },
    "signInMedia": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "description": "Image or video of the sign-in pages: an http(s) address or a path the web app serves (/media/welcome.mp4).",
      "replaces": "COWORKEE_SIGNIN_MEDIA"
    },
    "signInMediaSide": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "Left",
      "description": "Side of the sign-in media.",
      "choices": [
        {
          "choice": "Left",
          "description": "Media left."
        },
        {
          "choice": "Right",
          "description": "Media right."
        }
      ],
      "replaces": "COWORKEE_SIGNIN_SIDE"
    },
    "languages": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "description": "Languages offered from the start, comma separated (en,de,fr); empty offers en and de. The texts of the chosen shipped languages go into the app (Contracts/Localization); languages without shipped texts are machine translated at the first start."
    },
    "defaultLanguage": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "en",
      "description": "Language of users who chose none.",
      "choices": [
        {
          "choice": "en",
          "description": "English."
        },
        {
          "choice": "de",
          "description": "Deutsch."
        },
        {
          "choice": "fr",
          "description": "Français."
        },
        {
          "choice": "es",
          "description": "Español."
        },
        {
          "choice": "it",
          "description": "Italiano."
        },
        {
          "choice": "pt",
          "description": "Português."
        },
        {
          "choice": "pt-BR",
          "description": "Português (Brasil)."
        },
        {
          "choice": "nl",
          "description": "Nederlands."
        },
        {
          "choice": "pl",
          "description": "Polski."
        },
        {
