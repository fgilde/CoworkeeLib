          "description": "ភាសាខ្មែរ."
        }
      ],
      "replaces": "COWORKEE_DEFAULT_LANGUAGE"
    },
    "languageList": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "languages",
        "steps": [
          {
            "regex": ",",
            "replacement": "\", \""
          }
        ]
      },
      "replaces": "COWORKEE_LANGUAGES"
    },
    "langAr": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "languages",
        "pattern": "(^|,)\\s*ar(-[A-Za-z]+)?\\s*(,|$)"
      }
    },
    "langBg": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "languages",
        "pattern": "(^|,)\\s*bg(-[A-Za-z]+)?\\s*(,|$)"
      }
    },
    "langCs": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "languages",
        "pattern": "(^|,)\\s*cs(-[A-Za-z]+)?\\s*(,|$)"
      }
    },
    "langDa": {
      "type": "generated",
      "generator": "regexMatch",
