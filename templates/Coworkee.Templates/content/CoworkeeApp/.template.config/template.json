          "description": "Čeština."
        },
        {
          "choice": "sk",
          "description": "Slovenčina."
        },
        {
          "choice": "sl",
          "description": "Slovenščina."
        },
        {
          "choice": "sv",
          "description": "Svenska."
        },
        {
          "choice": "da",
          "description": "Dansk."
        },
        {
          "choice": "nb",
          "description": "Norsk bokmål."
        },
        {
          "choice": "fi",
          "description": "Suomi."
        },
        {
