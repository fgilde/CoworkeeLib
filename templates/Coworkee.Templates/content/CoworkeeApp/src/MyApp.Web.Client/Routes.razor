@inject CoworkeeLocalizer L
@*#if (reports)
<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="new[] { typeof(Coworkee.Client.Blazor.CoworkeeClientOptions).Assembly, typeof(Coworkee.Client.Blazor.Reporting.ReportingOptions).Assembly }">
#else
<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="new[] { typeof(Coworkee.Client.Blazor.CoworkeeClientOptions).Assembly }">
#endif*@
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(CoworkeeLayout)">
            <NotAuthorized>
                <NotAllowed PageType="routeData.PageType" />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(CoworkeeLayout)"><MudText>@L["Not found."]</MudText></LayoutView>
    </NotFound>
</Router>
