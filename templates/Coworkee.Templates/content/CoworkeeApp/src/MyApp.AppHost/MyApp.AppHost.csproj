<Project Sdk="Aspire.AppHost.Sdk/13.6.1">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>myapp-apphost</UserSecretsId>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <CoworkeePackage Include="Coworkee.Aspire" />
    <!--#if (storage == "azureBlob") -->
    <PackageReference Include="Aspire.Hosting.Azure.Storage" />
    <!--#endif -->
    <!--#if (ai && aiProvider == "ollama") -->
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Ollama" />
    <!--#endif -->
    <!--#if (aspireUI) -->
    <PackageReference Include="Nextended.Aspire.Hosting.AspireUI" />
    <!--#endif -->
    <!--#if (eventBus == "rabbitMq") -->
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <!--#endif -->
    <ProjectReference Include="..\MyApp.Migrations\MyApp.Migrations.csproj" />
    <!-- the development users, so Keycloak and other resources get the same credentials as the seed -->
    <Compile Include="..\MyApp.Migrations\DemoUsers.cs" Link="DemoUsers.cs" />
    <ProjectReference Include="..\MyApp.Api\MyApp.Api.csproj" />
    <ProjectReference Include="..\MyApp.Auth\MyApp.Auth.csproj" />
    <ProjectReference Include="..\MyApp.Web\MyApp.Web.csproj" />
    <!--#if (airworks) -->
    <ProjectReference Include="..\MyApp.AirWorks\MyApp.AirWorks.csproj" />
    <!--#endif -->
  </ItemGroup>
</Project>
