{
  "name": "Crm",
  "options": {
    "samples": false,
    "reports": true,
    "social": true,
    "chat": false
  },
  "branding": {
    "title": "Pipeline",
    "theme": "Ocean",
    "signInLayout": "Split"
  },
  "modules": [
    {
      "name": "Sales",
      "entities": [
        {
          "name": "Company",
          "plural": "Companies",
          "properties": [
            { "name": "Name", "required": true, "maxLength": 200, "display": true, "unique": true },
            { "name": "Website", "type": "url", "maxLength": 300 },
            { "name": "Industry", "maxLength": 100, "facet": true },
            { "name": "Notes", "type": "text" }
          ]
        },
        {
          "name": "Contact",
          "properties": [
            { "name": "FullName", "required": true, "maxLength": 200, "display": true, "label": "Name" },
            { "name": "Email", "type": "email", "maxLength": 250 },
            { "name": "Phone", "maxLength": 50 },
            { "name": "Company", "type": "reference", "reference": "Company", "inverse": "Contacts", "onDelete": "setNull", "facet": true }
          ]
        },
        {
          "name": "Deal",
          "properties": [
            { "name": "Title", "required": true, "maxLength": 200, "display": true },
            { "name": "Company", "type": "reference", "reference": "Company", "required": true, "inverse": "Deals", "facet": true },
            { "name": "Contact", "type": "reference", "reference": "Contact", "onDelete": "setNull" },
            { "name": "Value", "type": "money", "required": true },
            { "name": "Discount", "type": "decimal", "precision": 5, "scale": 2, "label": "Discount %" },
            { "name": "ExpectedClose", "type": "dateOnly", "label": "Expected close" },
            { "name": "ClosedOn", "type": "dateTime", "label": "Closed on" }
          ],
          "workflow": {
            "initial": "Lead",
            "transitions": [
              { "name": "Qualify", "from": ["Lead"], "to": "Qualified" },
              { "name": "Send proposal", "from": ["Qualified"], "to": "Proposal" },
              { "name": "Ask for discount", "from": ["Proposal"], "to": "Discount review", "comment": true },
              { "name": "Win", "from": ["Proposal"], "to": "Won" },
              { "name": "Lose", "from": ["Lead", "Qualified", "Proposal"], "to": "Lost", "comment": true },
              { "name": "Reopen", "from": ["Lost"], "to": "Qualified", "comment": true }
            ],
            "states": [
              { "name": "Qualified", "color": "info" },
              { "name": "Proposal", "color": "primary" },
              {
                "name": "Discount review",
                "color": "warning",
                "approval": { "approved": "Proposal", "rejected": "Proposal", "roles": ["Sales Manager"], "dueInDays": 2, "remindAfterDays": 1 }
              },
              { "name": "Won", "color": "success", "stamp": "ClosedOn", "notify": "Sales Manager" },
              { "name": "Lost", "color": "error", "stamp": "ClosedOn" }
            ]
          }
        }
      ]
    }
  ],
  "roles": [
    {
      "name": "Sales Rep",
      "description": "Works the pipeline",
      "permissions": ["Sales.Companies.View", "Sales.Contacts.View", "Sales.Contacts.Create", "Sales.Contacts.Edit", "Sales.Deals.View", "Sales.Deals.Create", "Sales.Deals.Edit", "Reports.View"]
    },
    {
      "name": "Sales Manager",
      "description": "Approves discounts and hears about every deal won",
      "permissions": ["Sales.Companies.View", "Sales.Companies.Create", "Sales.Companies.Edit", "Sales.Contacts.View", "Sales.Deals.View", "Sales.Deals.Edit", "Reports.View", "Reports.Dashboard", "Workflows.View"]
    }
  ]
}
