{
  "name": "Approvals",
  "options": {
    "samples": false,
    "chat": false,
    "ai": false,
    "keycloak": true
  },
  "branding": {
    "title": "Requests",
    "theme": "Classic",
    "signInLayout": "Card"
  },
  "modules": [
    {
      "name": "Desk",
      "entities": [
        {
          "name": "Category",
          "plural": "Categories",
          "properties": [
            { "name": "Name", "required": true, "maxLength": 100, "display": true, "unique": true },
            { "name": "ApprovalLimit", "type": "money", "label": "Approval needed above" }
          ]
        },
        {
          "name": "Request",
          "properties": [
            { "name": "Title", "required": true, "maxLength": 200, "display": true },
            { "name": "Category", "type": "reference", "reference": "Category", "required": true, "inverse": "Requests", "facet": true },
            { "name": "Reason", "type": "text", "required": true },
            { "name": "Amount", "type": "money" },
            { "name": "NeededBy", "type": "dateOnly", "label": "Needed by" },
            { "name": "SubmittedOn", "type": "dateTime", "label": "Submitted on" },
            { "name": "DecidedOn", "type": "dateTime", "label": "Decided on" }
          ],
          "workflow": {
            "initial": "Draft",
            "transitions": [
              { "name": "Submit", "from": ["Draft"], "to": "In review" },
              { "name": "Withdraw", "from": ["In review"], "to": "Draft" },
              { "name": "Reopen", "from": ["Rejected"], "to": "Draft", "comment": true }
            ],
            "states": [
              {
                "name": "In review",
                "color": "warning",
                "stamp": "SubmittedOn",
                "approval": { "approved": "Approved", "rejected": "Rejected", "roles": ["Approver"], "dueInDays": 3, "remindAfterDays": 1, "notByRequester": true }
              },
              { "name": "Approved", "color": "success", "stamp": "DecidedOn", "notify": "Purchasing" },
              { "name": "Rejected", "color": "error", "stamp": "DecidedOn" }
            ]
          }
        }
      ]
    }
  ],
  "roles": [
    {
      "name": "Requester",
      "description": "Files requests",
      "permissions": ["Desk.Categories.View", "Desk.Requests.View", "Desk.Requests.Create", "Desk.Requests.Edit", "Workflows.View"]
    },
    {
      "name": "Approver",
      "description": "Decides on requests within three days",
      "permissions": ["Desk.Categories.View", "Desk.Categories.Edit", "Desk.Requests.View", "Workflows.View"]
    },
    {
      "name": "Purchasing",
      "description": "Is told about approved requests and orders them",
      "permissions": ["Desk.Categories.View", "Desk.Requests.View", "Workflows.View"]
    }
  ]
}
