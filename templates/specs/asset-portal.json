{
  "name": "AssetPortal",
  "options": {
    "samples": false,
    "files": true,
    "social": true,
    "extendedAttributes": true,
    "elasticsearch": true
  },
  "branding": {
    "title": "Asset Portal",
    "theme": "Midnight",
    "signInLayout": "Slide"
  },
  "modules": [
    {
      "name": "Media",
      "entities": [
        {
          "name": "Collection",
          "properties": [
            { "name": "Name", "required": true, "maxLength": 150, "display": true, "unique": true },
            { "name": "Description", "type": "text" },
            { "name": "IsPublic", "type": "bool", "default": "false", "label": "Public", "facet": true }
          ]
        },
        {
          "name": "Asset",
          "clientEntity": true,
          "properties": [
            { "name": "Title", "required": true, "maxLength": 250, "display": true },
            { "name": "Kind", "type": "enum", "enum": "AssetKind", "required": true, "default": "Image", "facet": true },
            { "name": "Collection", "type": "reference", "reference": "Collection", "inverse": "Assets", "onDelete": "setNull", "facet": true },
            { "name": "SourceUrl", "type": "url", "maxLength": 500, "label": "Source" },
            { "name": "Copyright", "maxLength": 200 },
            { "name": "LicenseEnds", "type": "dateOnly", "label": "License ends" },
            { "name": "Status", "maxLength": 50, "facet": true },
            { "name": "PublishedOn", "type": "dateTime", "label": "Published on" }
          ],
          "workflow": {
            "initial": "Draft",
            "mirrorTo": "Status",
            "transitions": [
              { "name": "Submit", "from": ["Draft"], "to": "Rights check" },
              { "name": "Archive", "from": ["Published"], "to": "Archived", "permission": "Publish" },
              { "name": "Restore", "from": ["Archived"], "to": "Draft" }
            ],
            "states": [
              {
                "name": "Rights check",
                "color": "warning",
                "approval": { "approved": "Published", "rejected": "Draft", "roles": ["Rights Manager"], "dueInDays": 5, "remindAfterDays": 2 }
              },
              { "name": "Published", "color": "success", "stamp": "PublishedOn" },
              { "name": "Archived", "color": "secondary" }
            ]
          }
        },
        {
          "name": "Tag",
          "properties": [
            { "name": "Name", "required": true, "maxLength": 60, "display": true, "unique": true },
            { "name": "Color", "maxLength": 7 }
          ]
        }
      ]
    }
  ],
  "enums": [
    { "name": "AssetKind", "values": ["Image", "Video", "Document", "Audio", "Font"] }
  ],
  "roles": [
    {
      "name": "Editor",
      "description": "Uploads and describes assets",
      "permissions": ["Media.Collections.View", "Media.Assets.View", "Media.Assets.Create", "Media.Assets.Edit", "Media.Tags.View", "Media.Tags.Create", "Files.View", "Files.Upload"]
    },
    {
      "name": "Rights Manager",
      "description": "Checks source and license before an asset is published",
      "permissions": ["Media.Collections.View", "Media.Assets.View", "Media.Assets.Publish", "Media.Tags.View", "Files.View", "Workflows.View"]
    }
  ]
}
