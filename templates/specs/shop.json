{
  "name": "Shop",
  "options": {
    "samples": false,
    "reports": true,
    "files": true,
    "mapping": "mapperly"
  },
  "branding": {
    "title": "Corner Shop",
    "theme": "Forest",
    "primaryColor": "#2e7d32",
    "secondaryColor": "#ff8f00",
    "signInLayout": "Split"
  },
  "modules": [
    {
      "name": "Inventory",
      "entities": [
        {
          "name": "Brand",
          "properties": [
            { "name": "Name", "required": true, "maxLength": 120, "display": true, "unique": true },
            { "name": "Website", "type": "url", "maxLength": 300 }
          ]
        },
        {
          "name": "Product",
          "clientEntity": true,
          "properties": [
            { "name": "Sku", "required": true, "maxLength": 40, "unique": true, "label": "SKU" },
            { "name": "Name", "required": true, "maxLength": 200, "display": true },
            { "name": "Brand", "type": "reference", "reference": "Brand", "inverse": "Products", "onDelete": "setNull", "facet": true },
            { "name": "Price", "type": "money", "required": true },
            { "name": "InStock", "type": "int", "default": "0", "label": "In stock" },
            { "name": "Active", "type": "bool", "default": "true", "facet": true }
          ]
        }
      ]
    },
    {
      "name": "Sales",
      "entities": [
        {
          "name": "Order",
          "properties": [
            { "name": "Number", "required": true, "maxLength": 30, "unique": true, "display": true },
            { "name": "CustomerEmail", "type": "email", "required": true, "maxLength": 250, "label": "Customer" },
            { "name": "OrderedOn", "type": "dateOnly", "required": true, "label": "Order date" },
            { "name": "Total", "type": "money" },
            { "name": "TrackingNumber", "maxLength": 60, "label": "Tracking number" },
            { "name": "PaidOn", "type": "dateTime", "label": "Paid on" },
            { "name": "ShippedOn", "type": "dateTime", "label": "Shipped on" }
          ],
          "workflow": {
            "initial": "Open",
            "transitions": [
              { "name": "Mark paid", "from": ["Open"], "to": "Paid" },
              { "name": "Ship", "from": ["Paid"], "to": "Shipped", "permission": "Ship" },
              { "name": "Mark delivered", "from": ["Shipped"], "to": "Delivered", "permission": "Ship" },
              { "name": "Cancel", "from": ["Open", "Paid"], "to": "Cancelled", "comment": true },
              { "name": "Request refund", "from": ["Delivered"], "to": "Refund requested", "comment": true }
            ],
            "states": [
              { "name": "Paid", "color": "info", "stamp": "PaidOn", "notify": "Shop Staff" },
              { "name": "Shipped", "color": "primary", "stamp": "ShippedOn" },
              { "name": "Delivered", "color": "success" },
              { "name": "Cancelled", "color": "secondary" },
              {
                "name": "Refund requested",
                "color": "warning",
                "approval": { "approved": "Refunded", "rejected": "Delivered", "roles": ["Shop Manager"], "dueInDays": 2 }
              },
              { "name": "Refunded", "color": "error" }
            ]
          }
        },
        {
          "name": "OrderLine",
          "properties": [
            { "name": "Order", "type": "reference", "reference": "Order", "required": true, "inverse": "Lines", "onDelete": "cascade" },
            { "name": "Product", "type": "reference", "reference": "Inventory.Product", "required": true },
            { "name": "Quantity", "type": "int", "required": true, "default": "1" },
            { "name": "UnitPrice", "type": "money", "required": true, "label": "Unit price" }
          ]
        }
      ]
    }
  ],
  "roles": [
    {
      "name": "Shop Staff",
      "description": "Packs and ships paid orders",
      "permissions": ["Inventory.Products.View", "Sales.Orders.View", "Sales.Orders.Ship", "Sales.OrderLines.View"]
    },
    {
      "name": "Shop Manager",
      "description": "Runs the shop and decides on refunds",
      "permissions": ["Inventory.Brands.View", "Inventory.Brands.Create", "Inventory.Brands.Edit", "Inventory.Products.View", "Inventory.Products.Create", "Inventory.Products.Edit",
        "Sales.Orders.View", "Sales.Orders.Create", "Sales.Orders.Edit", "Sales.Orders.Ship", "Sales.OrderLines.View", "Sales.OrderLines.Create", "Sales.OrderLines.Edit", "Reports.View", "Workflows.View"]
    }
  ]
}
